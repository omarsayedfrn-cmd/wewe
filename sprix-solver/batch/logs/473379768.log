nswer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:43:01Z"},{"id":20613043,"test_response_id":1372470,"test_question_id":543,"status":"graded","selected_option_id":3880,"answer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:43:01Z"},{"id":20613044,"test_response_id":1372470,"test_question_id":544,"status":"graded","selected_option_id":3882,"answer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:43:02Z"},{"id":20613045,"test_response_id":1372470,"test_question_id":545,"status":"graded","selected_option_id":3885,"answer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:43:02Z"},{"id":20613046,"test_response_id":1372470,"test_question_id":546,"status":"graded","selected_option_id":3891,"answer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:43:03Z"},{"id":20613047,"test_response_id":1372470,"test_question_id":547,"status":"graded","selected_option_id":3894,"answer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:43:03Z"},{"id":20613048,"test_response_id":1372470,"test_question_id":548,"status":"graded","selected_option_id":3897,"answer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:43:03Z"},{"id":20613049,"test_response_id":1372470,"test_question_id":549,"status":"graded","selected_option_id":3904,"answer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:43:04Z"},{"id":20613050,"test_response_id":1372470,"test_question_id":550,"status":"graded","selected_option_id":3906,"answer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:43:04Z"}],"questions":{"928":{"id":928,"subject_id":7,"type":"mcq","question_text":"عمرك ٢٢ سنة، في سنتك الأولى كبالغ عامل. بدأت العيش بمفردك ووصل راتبك الأول. تشعر بقلق قليل: \u0026#34;هل أستطيع العيش جيدًا لشهر بهذا المال؟\u0026#34; قبل أن تبدأ الإنفاق، ما أكثر خطوة يمكن الاعتماد عليها للبدء بها؟","image":null,"video":null,"explanation":"تقرير \u0026#34;ماذا تنفق كم عليه\u0026#34; مسبقًا ضمن دخل شهر واحد (وضع ميزانية) يساعد على منع الإنفاق الزائد والنقص في نهاية الشهر. الجواب C. تسجيل الإنفاق في A والتحقّق من الرصيد في D هما \u0026#34;إدارة بعدية\u0026#34; بعد أن تبدأ الإنفاق، ليست خطة تخصيص مسبقة. النقل للحساب في B أيضًا، بدون خطة ملموسة لكيفية تخصيص مالك، يصبح سحبًا عشوائيًا ويدعو بسهولة للعجز.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"929":{"id":929,"subject_id":7,"type":"mcq","question_text":"إنها استراحة الغداء في العمل. الليلة عشاء مدفوع كنت قد قررت حضوره، فسيكون الإنفاق أعلى من المعتاد. أنت متردّد بشأن الغداء، الأكل بالخارج أو الوجبة التي جلبتها من البيت. ما الحكم الأحكم لاستخدام المال؟","image":null,"video":null,"explanation":"إذا كان هناك إنفاق مؤكَّد ذلك اليوم (التجمّع الذي قررت حضوره)، تقليل الإنفاق الأكثر قابلية للتعديل، الغداء، أولًا للتحضير هو إنفاق مخطَّط وحكيم. الجواب B. A يدفع العبء لأيام أخرى، مما يُضيّق ميزانية الأسرة لاحقًا. C يقيّد حتى تجمّعًا تتطلّع إليه، وهذا مبالغة. D لا يجب استخدام \u0026#34;صندوق الطوارئ\u0026#34; ذي الغرض المختلف لعجز يومي عادي.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"930":{"id":930,"subject_id":7,"type":"mcq","question_text":"في يوم آخر، في طريقك للبيت من العمل، وأنت تمرّ أمام متجر إلكترونيات قرب المحطة، جذبت انتباهك سماعات أردتها منذ فترة طويلة. السعر ١٬٠٠٠ جنيه. ليست رخيصة بأي حال، وشراؤها يعني أنك لن تستطيع وضع أي شيء في المدخرات هذا الشهر. عندما تقرر شراء هذه السماعات، ما هي \u0026#34;تكلفة الفرصة البديلة\u0026#34;؟","image":null,"video":null,"explanation":"تكلفة الفرصة البديلة هي \u0026#34;قيمة كنت تستطيع كسبها من خيار آخر اضطررت للتنازل عنه بسبب خيار\u0026#34;. شراء السماعات يعني التنازل عن ذلك القدر من المدخرات، فتكلفة الفرصة البديلة هي \u0026#34;مدخرات هذا الشهر التي كنت تستطيع تحقيقها\u0026#34;. الجواب A. B هو المبلغ المدفوع فعليًا، ليس القيمة المتنازَل عنها. C عن الجهد، ليس جوهر تكلفة الفرصة البديلة. D هو الرضا المُكتسَب من الشراء.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"931":{"id":931,"subject_id":7,"type":"mcq","question_text":"تنازلت عن السماعات وتوقّفت في سوبرماركت في طريقك للبيت. بما أن المال المتاح لك هذا الشهر محدود، تقسّم ما تشتريه إلى \u0026#34;احتياجات\u0026#34; و\u0026#34;رغبات\u0026#34;، وتعطي الأولوية للاحتياجات. أي توليفة صحيحة لتقسيم ①-④؟\n① أرز\n② وجبات خفيفة\n③ جوارب للتنقّل\n④ مجلة مفضَّلة","image":null,"video":null,"explanation":"الاحتياجات ضرورية للعيش؛ الرغبات أشياء تريدها لكن تستطيع الاستمرار بدونها. ① الأرز و③ الجوارب للتنقّل احتياجات؛ ② الوجبات الخفيفة و④ المجلة المفضَّلة رغبات. فالاحتياجات = ①③، والرغبات = ②④، والجواب D.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"932":{"id":932,"subject_id":7,"type":"mcq","question_text":"في نهاية الشهر، تبقّى مال أقل مما ظننت في حسابك. تتحقّق من رصيد الشهر. المال الداخل راتبك ٨٬٠٠٠ جنيه، والمال الخارج كما في سجل الدخل والنفقات هذا (الشكل ①). أي وصف صحيح لرصيد هذا الشهر؟","image":"image_3_12_2_ar.png","video":null,"explanation":"إجمالي المال الخارج هو ٤٬٠٠٠ + ٢٬٥٠٠ + ١٬٠٠٠ + ١٬٥٠٠ = ٩٬٠٠٠ جنيه. الرصيد هو المال الداخل مطروحًا منه المال الخارج = ٨٬٠٠٠ − ٩٬٠٠٠ = −١٬٠٠٠ جنيه. بما أن المال الخارج أكبر، فهو عجز. الجواب C.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"933":{"id":933,"subject_id":7,"type":"mcq","question_text":"لمراجعة ميزانية أسرتك للشهر القادم، تنظّم إنفاقك. بتقسيم التالية ①-④ إلى \u0026#34;إنفاق أساسي\u0026#34; و\u0026#34;إنفاق اختياري\u0026#34;، أي توليفة صحيحة؟\n① الإيجار\n② فاتورتا الكهرباء والمياه\n③ رسوم شهرية لخدمة بث فيديو\n④ تكلفة معدات هواية لعطلة نهاية الأسبوع","image":null,"video":null,"explanation":"الإنفاق الأساسي ضروري للعيش؛ الإنفاق الاختياري ما تستطيع الاستمرار بدونه. ① الإيجار و② فاتورتا الكهرباء والمياه أساسيان؛ ③ خدمة البث و④ معدات الهواية اختياريان. فالأساسي = ①②، والاختياري = ③④، والجواب A. عند المراجعة، البدء بالإنفاق الاختياري يحافظ على تأثير أصغر على حياتك.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"934":{"id":934,"subject_id":7,"type":"mcq","question_text":"إدارة مالك الشهرية لا تسير بشكل جيد ولا تشعر بالثقة. في يوم ما، تشجّعت واستشرت زميلًا أقدم في العمل، الذي علّمك \u0026#34;قاعدة ٥٠/٣٠/٢٠\u0026#34;. \u0026#34;عندما تكون غير متأكد، التقسيم بهذه النسب كدليل جيد.\u0026#34; بتخصيص راتب صافٍ ٨٬٠٠٠ جنيه بالقاعدة التي علّموك بها، كم لكل جزء؟ (الشكل ②)","image":"image_3_12_3_ar.png","video":null,"explanation":"قاعدة ٥٠/٣٠/٢٠ دليل يقسّم الدخل إلى احتياجات ٥٠%، ورغبات ٣٠%، ومدخرات مستقبل ٢٠%. بالراتب الصافي ٨٬٠٠٠ جنيه: الاحتياجات = ٨٬٠٠٠ × ٠٫٥ = ٤٬٠٠٠ جنيه، الرغبات = ٨٬٠٠٠ × ٠٫٣ = ٢٬٤٠٠ جنيه، مدخرات المستقبل = ٨٬٠٠٠ × ٠٫٢ = ١٬٦٠٠ جنيه. فالجواب B.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"935":{"id":935,"subject_id":7,"type":"mcq","question_text":"مع أنك تفكّر \u0026#34;سأدّخر\u0026#34;، لا يتبقى شيء تقريبًا في نهاية الشهر. أي توليفة تختار كل الطرق المناسبة للادّخار بشكل موثوق كل شهر؟\n① ضع جانبًا مبلغًا ثابتًا للمدخرات بمجرد استلام راتبك (ادفع لنفسك أولًا)\n② بعد إدارة الشهر، ضع ما تبقى في نهاية الشهر في المدخرات\n③ رتّب نقل مبلغ ثابت تلقائيًا لحساب مدخرات كل شهر\n④ ضع مالًا في المدخرات دفعة واحدة فقط عندما تحصل على دخل إضافي","image":null,"video":null,"explanation":"للادّخار بشكل موثوق كل شهر، آلية تؤمّن المدخرات قبل الإنفاق مهمة. ① الوضع جانبًا أولًا (ادفع لنفسك أولًا) و③ إعداد نقل تلقائي يمكن تأمينهما بمبلغ ثابت كل شهر، فهما موثوقان. ② \u0026#34;إذا تبقّى\u0026#34; و④ \u0026#34;فقط الدخل الإضافي\u0026#34; يعتمدان على الظروف لما إذا كنت تستطيع الادّخار، ولا يصبحان آلية تؤمّنه باستمرار كل شهر. ف①③، والجواب D.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"936":{"id":936,"subject_id":7,"type":"mcq","question_text":"عمرك ٢٤ سنة، في سنتك الثالثة كبالغ عامل. حوالي الوقت الذي اعتدت فيه العمل والحياة، تسمع أن صديقًا شرى حذاء جلديًا جديدًا، وأنت أيضًا تريده بشكل مفاجئ. تشعر برغبة قوية في الشراء فورًا. في هذا الوقت، ما أحكم تصرّف لاستخدام المال؟","image":null,"video":null,"explanation":"الشراء بسرعة على شعور \u0026#34;أريده!\u0026#34; فقط يصبح بسهولة شراءً اندفاعيًا. الأفضل أن تهدأ لحظة وتقرر بعد التحقّق من ميزانية هذا الشهر ومما إذا كنت تحتاجه فعليًا. الجواب B. A قرار سريع يطابق صديقك، شراء اندفاعي. C ينظر فقط إلى \u0026#34;هل أستطيع شراءه\u0026#34; دون التحقّق من الضرورة. D طريقة شراء تتجاوز الميزانية وقد تكسر مالية الأسرة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"937":{"id":937,"subject_id":7,"type":"mcq","question_text":"في يوم ما، وصلت رسالة على هاتفك من جهة مجهولة: \u0026#34;أودِع في هذا التطبيق وسيزداد مالك بالتأكيد. عرض خاص لليوم فقط\u0026#34;. ضد \u0026#34;قصة جيدة جدًا\u0026#34; كهذه، أي تصرّف يجب أن تتخذه؟","image":null,"video":null,"explanation":"لا يوجد \u0026#34;سيزداد بالتأكيد\u0026#34; في الاستثمار، وإرباكك بـ\u0026#34;لليوم فقط\u0026#34; خاصية دعوات مشبوهة شائعة. عدم التورّط هو الأكثر أمانًا، والجواب C. A يقود للضرر أو دعوات أكثر حتى بإيداع صغير. B، عدد أكبر من الناس لا يغيّر شبهة القصة، والضرر ينتشر. D يتيح للقصة التقدّم بوتيرة الجهة الأخرى، مما يصعّب الرفض.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"938":{"id":938,"subject_id":7,"type":"mcq","question_text":"طلبت منتجًا في متجر إلكتروني. في نفس اليوم، قدّمت أيضًا وعدًا شفهيًا عابرًا لصديق، \u0026#34;سأدعوك لوجبة المرة القادمة\u0026#34;. أي منهما محمي أساسًا كـ\u0026#34;عقد\u0026#34; قانوني، وما أنسب سبب لذلك من التالي؟","image":null,"video":null,"explanation":"ما إذا كان شيء محميًا قانونيًا كعقد لا يُحدَّد بكونه على ورق أو منطوقًا، بل يعتمد على وجود التزام متبادل بحقوق وواجبات. طلب إلكتروني وعد بمقابل، \u0026#34;دفع السعر، استلام المنتج\u0026#34;، تنشأ فيه حقوق وواجبات لكلا المشتري والمتجر، فهو عقد. في المقابل، \u0026#34;سأدعوك\u0026#34; نيّة حسنة، وعد اجتماعي بلا مقابل؛ لا ينشأ حق مطالبة بالتنفيذ ولا واجب قانوني للوفاء، فليس عقدًا. هذا \u0026#34;ما إذا كانت حقوق وواجبات بمقابل تنشأ\u0026#34; هو خط التمييز، والجواب A. B خاطئة لأن ليس كل الوعود الشفهية تصبح عقودًا. C، يتكوّن عقد بالاتفاق حتى بدون وثيقة عقد. D خاطئة في التفكير أن أي وعد محمي قانونيًا بالتساوي، بينما ما إذا كان وعد محميًا قانونيًا يتغيّر بالمحتوى (وعد بمقابل وحقوق وواجبات محمي كعقد، لكن وعد اجتماعي بلا مقابل ليس كذلك).","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"939":{"id":939,"subject_id":7,"type":"mcq","question_text":"يسير التسوّق الإلكتروني بالترتيب التالي ①-④. في أي نقطة يتكوّن عقد البيع (يكتمل الوعد المتبادل \u0026#34;بيع/شراء\u0026#34;)؟\n① وضع المنتج في السلة\n② مراجعة التفاصيل والضغط على \u0026#34;تأكيد الطلب\u0026#34;\n③ وصول ردّ \u0026#34;تم استلام الطلب\u0026#34; من المتجر\n④ وصول المنتج لبيتك","image":null,"video":null,"explanation":"يتكوّن عقد بيع عندما، ضد طلب المشتري (الإيجاب = ②)، يستجيب المتجر \u0026#34;تم الاستلام\u0026#34; (القبول = ③). الجواب C (③). ① فقط وضعه في السلة؛ ② مرحلة الطلب، لا يزال بدون قبول المتجر. ④ وصول المنتج مشهد بعد تكوّن العقد.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"940":{"id":940,"subject_id":7,"type":"mcq","question_text":"عندما يتكوّن عقد طلب، ينشأ كلا \u0026#34;حق\u0026#34; و\u0026#34;واجب\u0026#34; للمشتري. أي مما يلي يشرح بشكل صحيح حق المشتري وواجبه؟","image":null,"video":null,"explanation":"يستطيع المشتري استلام المنتج مقابل دفع المال. فالحق هو \u0026#34;استلام المنتج\u0026#34; والواجب هو \u0026#34;دفع السعر\u0026#34;، والجواب B. A وC هما حق وواجب جانب البائع (استلام المال، تسليم المنتج). D لها الحق والواجب مُبدَّلين.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"941":{"id":941,"subject_id":7,"type":"mcq","question_text":"اشتريت دراجة مستعملة من أحد معارفك. لم تتبادلا عقدًا ورقيًا، لكن تتم عملية البيع بالاتفاق \u0026#34;سأبيع/سأشتري\u0026#34;. مع ذلك، ما الغرض الأساسي من ترك وثيقة عقد (كتابيًا) في معاملة كهذه؟ أي مما يلي هو الأنسب؟","image":null,"video":null,"explanation":"يتكوّن عقد بالاتفاق، لكن إعداد وثيقة عقد يوضّح محتويات الوعد ويمنع نزاعات \u0026#34;من قال ماذا\u0026#34; لاحقًا. الجواب D. A خاطئة لأن العقد يتكوّن حتى بدون وثيقة عقد. B، حتى مع وثيقة عقد، لا تستطيع الإلغاء بحرية دون اتفاق. C خاطئة لأن صنع وثيقة عقد أو تقديمها لمكتب حكومي غير مطلوب للمعاملات بين الأفراد.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"942":{"id":942,"subject_id":7,"type":"mcq","question_text":"توقيت الدفع يختلف حسب المعاملة. من بين التالية، أي موقف يُعد \u0026#34;معاملة ائتمانية\u0026#34;؟","image":null,"video":null,"explanation":"المعاملة الائتمانية هي \u0026#34;استلم أولًا، ادفع لاحقًا\u0026#34;، تعتمد على الثقة في أنك ستدفع لاحقًا (الائتمان). A يستلم المجلة أولًا ويدفع لاحقًا في نهاية الشهر، فيُحسَب معاملة ائتمانية. الجواب A. B دفع فوري في الموقع، C دفع مسبق يدفع أولًا، لا واحدة منهما دفع لاحق. D لا يوجد بيع مُكوَّن في المقام الأول.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"943":{"id":943,"subject_id":7,"type":"mcq","question_text":"ببطاقة ائتمان، اشتريت ملابس بـ٥٬٠٠٠ جنيه لارتدائها للعمل. يستلم المتجر السعر في نفس اليوم، لكنك تدفع الشهر القادم. في هذا الوقت، من يدفع للمتجر السعر فورًا، ولمن تدفع لاحقًا؟ أي مما يلي هو التوليفة الصحيحة؟","image":null,"video":null,"explanation":"التسوّق ببطاقة ائتمان يتضمّن ثلاثة أطراف: أنت، والمتجر، وشركة الائتمان. تقدّم شركة الائتمان السعر للمتجر فورًا، فيستلمه المتجر دون انتظار الدفع. وتدفع أنت لشركة الائتمان لاحقًا دفعة واحدة. وفي الحالتين تكون شركة الائتمان هي الطرف المعني، والجواب B. A، من يدفع للمتجر شركة الائتمان، ليس أنت. C، لمن تدفع لاحقًا شركة الائتمان، ليس المتجر. D تخلط علاقة الأطراف الثلاثة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"944":{"id":944,"subject_id":7,"type":"mcq","question_text":"أنت على وشك شراء جهاز طبخ غالٍ قليلًا عبر الإنترنت. الضغط على \u0026#34;تأكيد الطلب\u0026#34; يكوّن عقد بيع. أي مما يلي هو أفضل نهج عند التأكيد؟","image":null,"video":null,"explanation":"بمجرد تكوّن عقد، يصعب إلغاؤه فقط لراحتك، فقبل التأكيد، تحقّق بعناية مما إذا كان الإجمالي، وطريقة الدفع، وشروط المنتج تناسب ميزانيتك ورغباتك. الجواب D. نطاق التحقّق في A ضيق جدًا. فرضية \u0026#34;الإلغاء بحرية لاحقًا\u0026#34; في B خاطئة. C تقرر بالرخص وحده، مع خطر تفويت شروط أخرى.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"945":{"id":945,"subject_id":7,"type":"mcq","question_text":"بعد العمل كمحترف لسنوات عديدة، عمرك ٢٨ سنة. مدركًا للزواج، تناقش مع شريكك المال الذي ستحتاجانه في المستقبل. تقرران تنظيم أهدافكما المالية بحسب الجدول الزمني، قصيرة ومتوسطة وطويلة المدى. أي مما يلي هو أفضل فائدة لتنظيم الأهداف بهذه الطريقة؟","image":null,"video":null,"explanation":"تقسيم الأهداف بحسب الجدول الزمني يوضّح كم تحتاجه وبحلول متى، ويتيح تقدير المقدار الشهري للوضع جانبًا، مما يجعل التخطيط أسهل. الجواب B. A، التقسيم وتضييق عدد الأهداف مسألتان منفصلتان. C، الجدول الزمني وحده لا يجمع المال؛ تحتاج أيضًا خطة للمقدار. D، تقليص الإهدار لا يغيّر الإجمالي المطلوب.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"946":{"id":946,"subject_id":7,"type":"mcq","question_text":"لزواجكما، كتبتما المال الذي تريدان تحضيره. صنّفا العناصر التالية ①-⑤ إلى أهداف قصيرة ومتوسطة وطويلة المدى. أي توليفة صحيحة؟ (الأشياء التي ليست \u0026#34;هدفًا\u0026#34; يُدَّخَر له بموعد نهائي محدَّد هي \u0026#34;غير منطبقة\u0026#34;.)\n① تكلفة سيارة لاستبدالها بعد ٤ سنوات\n② تكلفة حفل زفاف سيُعقَد بعد نصف سنة\n③ دفعة أولى للسكن، نحو ١٢ سنة من الآن\n④ تكلفة انتقال مطلوبة في ٣ أشهر\n⑤ تكاليف معيشة يومية كالطعام والإيجار الشهري","image":null,"video":null,"explanation":"تُقسَّم أهداف المال بدليل قصير المدى = ضمن سنة إلى ثلاث سنوات، متوسط المدى = ٣ إلى ١٠ سنوات، طويل المدى = ١٠ سنوات أو أكثر. بتطبيق ذلك: ② الزفاف بعد نصف سنة و④ تكلفة الانتقال بعد ٣ أشهر مستقبل قريب جدًا، فقصيرا المدى؛ ① السيارة بعد ٤ سنوات بعيدة سنوات قليلة، فمتوسطة المدى؛ ③ دفعة السكن بعد ١٢ سنة بعيدة، فطويلة المدى. ⑤ تكاليف المعيشة اليومية مال يُستخدَم كل شهر، ليس \u0026#34;هدفًا\u0026#34; يُدَّخَر له بموعد نهائي محدَّد، فلا تطابق أيًا من القصير أو المتوسط أو الطويل. لذلك فالإجابة هي D.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"947":{"id":947,"subject_id":7,"type":"mcq","question_text":"بعد الزواج، لديكما أهداف: رصيد الزفاف المتبقي بعد نصف سنة، وسيارة بعد ٤ سنوات، ودفعة سكن بعد ١٢ سنة. هذا الشهر، المبلغ الذي يمكنكما ادخاره محدود. ما أفضل طريقة لتخصيص ما تضعانه جانبًا محدودًا؟","image":null,"video":null,"explanation":"بمقدار محدود للوضع جانبًا، الأفضل تخصيص أكثر للهدف ذي الموعد الأقرب أولًا مع أيضًا حساب المقدار المطلوب للأهداف متوسطة وطويلة المدى بحساب المبلغ المطلوب ادخاره شهريًا وفقًا للأشهر المتبقية ووضع ذلك جانبًا بالتوازي. الجواب C. A يُعطي الأولوية القصوى للطويل المدى بالحجم، مما يجعل زفافك القريب لا يصل في الوقت المناسب. B، التقسيم المتساوي قد يقصّر عن الهدف الأكثر إلحاحًا. D، وضع كل المقدار في هدف واحد يوقف التحضيرات الأخرى.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"948":{"id":948,"subject_id":7,"type":"mcq","question_text":"مع تحضيرات الزفاف والحياة الجديدة، أصبح لديكما عدة أهداف مالية. بدلًا من التفكير بشكل غامض \u0026#34;لندّخر\u0026#34;، من المهم أن تقررا كـ\u0026#34;ادّخر ( ① )( ② )\u0026#34;. أي توليفة تناسب ① و②؟","image":null,"video":null,"explanation":"تحديد كلٍّ من الموعد النهائي (بحلول متى) والمبلغ (كم) بشكل ملموس يتيح لك حتى حساب كم تضع جانبًا كل شهر، مما يسهّل تحقيق الأهداف. الجواب A. B لديها المقدار محدَّدًا لكن الموعد النهائي غامض؛ C لديها الموعد النهائي محدَّدًا لكن المقدار غامض؛ لا واحدة منهما تتيح حساب الوضع جانبًا الشهري. D لا تحدد الموعد النهائي أو المقدار، فتدّخر بشكل عشوائي كـ\u0026#34;أي مقدار ممكن من فائض كل شهر\u0026#34;، فلا تستطيع تخطيط وضع شهري جانبًا ويصعب تحقيقها.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"949":{"id":949,"subject_id":7,"type":"mcq","question_text":"في الحياة الزوجية، تناقشتما، \u0026#34;بما أنك لا تعرف أبدًا متى وماذا سيحدث، مرض، كارثة، لنحضّر مالًا للطوارئ\u0026#34;. يُحضَّر صندوق طوارئ حتى تستطيعا الاستمرار حتى لو توقّف دخلكما. ما القاعدة المناسبة لتحديد المقدار؟","image":null,"video":null,"explanation":"صندوق الطوارئ مال للاستمرار في العيش مؤقتًا عندما يحدث شيء، فالدليل المناسب هو عدة أشهر بناءً على \u0026#34;تكاليف المعيشة\u0026#34; الشهرية. الجواب D. شهر واحد في A يقصّر إذا لم يكن هناك دخل لعدة أشهر. B مبني على الدخل، غير مرتبط بتكاليف المعيشة الفعلية. C عن الرغبات (أموال الأهداف)، منفصلة عن التحضير للطوارئ.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"950":{"id":950,"subject_id":7,"type":"mcq","question_text":"تفكّر في أين تحفظ صندوق الطوارئ الذي قررت تحضيره. أي مما يلي غير مناسب لحفظ صندوق الطوارئ؟","image":null,"video":null,"explanation":"أهم ما يميز صندوق الطوارئ هو إمكانية استخدامه فورًا عند الحاجة. B وC وD أشكال قابلة للاستخدام فورًا، منفصلة عن الأهداف، فهي مناسبة. وضعه كله في استثمار طويل المدى لن تستخدمه الآن، كأ، لا يمكن تحويله لمال في الوقت المناسب لمصروف مفاجئ، فيفشل في دور صندوق الطوارئ. فغير المناسب هو A.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"951":{"id":951,"subject_id":7,"type":"mcq","question_text":"تقرر تنظيم مدخراتك بحسب الغرض. أي مما يلي تطابقه المدخرات ①-③، \u0026#34;أموال أهداف\u0026#34;، أو \u0026#34;صندوق طوارئ\u0026#34;، أو \u0026#34;أموال تقاعد\u0026#34;؟ أي توليفة صحيحة؟\n① مال يُدَّخَر قليلًا قليلًا من عمر مبكر، تحضيرًا للحياة الطويلة بعد التقاعد من العمل\n② مال يُوضَع جانبًا بمقدار ثابت كل شهر لسيارة لاستبدالها بعد ٣ سنوات\n③ مال للتعامل الفوري مع إنفاق غير متوقَّع كإصلاحات منزلية مفاجئة","image":null,"video":null,"explanation":"① التحضير على مدى طويل لحياة ما بعد التقاعد أموال تقاعد؛ ② الادّخار المنهجي لسيارة بعد ٣ سنوات أموال أهداف؛ ③ التعامل الفوري مع إنفاق غير متوقَّع صندوق الطوارئ. ف① تقاعد، ② أهداف، ③ طوارئ، والجواب C. الخيارات الأخرى لها التطابقات مُبدَّلة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"952":{"id":952,"subject_id":7,"type":"mcq","question_text":"لتأثيث بيتكما الجديد (٢٤٬٠٠٠ جنيه)، تبدآن الادّخار. راتباكما الصافيان المُجمَّعان ٢٠٬٠٠٠ جنيه شهريًا. بما أن هناك تكاليف معيشة أيضًا، كيف من المناسب تحديد المبلغ المناسب للادخار دون التسبب في ضغط مالي؟","image":null,"video":null,"explanation":"بما أن هناك تكاليف معيشة أيضًا، تحديد مبلغ الادخار بناءً على صافي الراتب، مع الحفاظ على مستوى مريح من الإنفاق جيد. الدليل حتى ٢٠% من الراتب الصافي (هنا، ٤٬٠٠٠ جنيه). حتى في قاعدة ٥٠/٣٠/٢٠، مال المدخرات يُوجَّه بدليل حتى ٢٠% من الراتب الصافي، فضمن ذلك النطاق تستطيعان تأمين تكاليف المعيشة (٥٠%) والرغبات (٣٠%) والاستمرار دون ضغط. فB، وضع الـ٤٬٠٠٠ جنيه التي هي ٢٠% جانبًا، مناسبة. نصف A (١٠٬٠٠٠) يتجاوز ٢٠% بكثير، مما يضيّق الحياة فلا تستمر. \u0026#34;فقط ما يتبقى في نهاية الشهر\u0026#34; في C يتغيّر شهريًا ولا يتراكم بشكل منهجي. الدفعة الواحدة في D تقلّل المال في اليد بشكل كبير، ضد هدف الاستمرار دون ضغط.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"953":{"id":953,"subject_id":7,"type":"mcq","question_text":"بعد سنوات قليلة من الزواج، عمرك ٣٢ سنة. حصلتما على سكن ولديكما مساحة قليلة في ميزانية الأسرة. الاهتمام بالاستثمار يتصاعد. أي مما يلي يشرح بشكل صحيح الفرق الأساسي بين الادّخار والاستثمار؟","image":null,"video":null,"explanation":"الادّخار هو الاحتفاظ بالمال بأمان في اليد أو حساب دون إنفاقه؛ الاستثمار هو وضع المال في أصول كالأسهم والسندات بأمل ربح (عائد) وإدارته (إدارة الأصول). الادخار لا يؤدي عادةً إلى خسارة أصل المبلغ لكن يصعب زيادته كثيرًا؛ الاستثمار له خطر التقلّص لكن إمكانية النمو. الجواب C. A يتجاهل أن للاستثمار خطر تقلّص أيضًا. B يتجاهل الفرق في الطبيعة بينهما. D يعكس شرحي الادّخار والاستثمار.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"954":{"id":954,"subject_id":7,"type":"mcq","question_text":"لبدء الاستثمار بأموال فائضة، تقرأ أوصاف منتجات متعددة. كل وصف يحتوي كلمة \u0026#34;خطر\u0026#34;. أي مما يلي يصف بأفضل شكل معنى \u0026#34;الخطر\u0026#34; في الاستثمار؟","image":null,"video":null,"explanation":"الخطر في الاستثمار يعني أن النتيجة يمكن أن تكون جيدة أو سيئة، وتستلم أثرًا يطابق النتيجة التي تحدث. لا يعني خسارة مؤكَّدة أو كسبًا مؤكَّدًا. الجواب A. B يفترض تقلّصًا مؤكَّدًا وD يعِد بزيادة مؤكَّدة، كلاهما خاطئ. C هو الفهم المعكوس لمعنى الخطر: مضمون عدم الخسارة، آمن.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"955":{"id":955,"subject_id":7,"type":"mcq","question_text":"هذا الجدول يُظهر كيف ينمو ٣٬٠٠٠ جنيه عند إدارته بـ٤% في السنة، بالفائدة الثابتة. بناءً على كيفية نمو الفائدة الثابتة، أي توليفة صحيحة للمبالغ في فراغات الجدول ① (بعد ١٠ سنوات) و② (بعد ٢٠ سنة)؟","image":"image_3_12_4_ar.png","video":null,"explanation":"تنمو الفائدة الثابتة بمقدار ثابت على أصل المبلغ كل سنة. ٤% في السنة على أصل مبلغ ٣٬٠٠٠ جنيه هي ١٢٠ جنيهًا كل سنة. بعد ١٠ سنوات: ٣٬٠٠٠ + ١٢٠ × ١٠ = ٤٬٢٠٠ (①)؛ بعد ٢٠ سنة: ٣٬٠٠٠ + ١٢٠ × ٢٠ = ٥٬٤٠٠ (②). الجواب D.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"956":{"id":956,"subject_id":7,"type":"mcq","question_text":"هذا الجدول يُظهر كيف ينمو ٣٬٠٠٠ جنيه عند إدارته بـ٤% في السنة، بالفائدة المركبة. بناءً على كيفية نمو الفائدة المركبة، أي توليفة صحيحة للمبالغ في فراغات الجدول ① (بعد سنة واحدة) و② (بعد سنتين)؟","image":"image_3_12_5_ar.png","video":null,"explanation":"الفائدة المركبة هي نمو تُطبَّق فيه نسبة الفائدة على المبلغ المتزايد أيضًا. بعد سنة واحدة، تُطبَّق ٤% على أصل المبلغ ٣٬٠٠٠ جنيه: ٣٬٠٠٠ × ١٫٠٤ = ٣٬١٢٠ (①). بعد سنتين، تُطبَّق ٤% أخرى على تلك الـ٣٬١٢٠ جنيه: ٣٬١٢٠ × ١٫٠٤ = حوالي ٣٬٢٤٥ (②). الجواب A.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:17Z","updated_at":null},"957":{"id":957,"subject_id":7,"type":"mcq","question_text":"بقراءة كتاب استثمار، تظهر \u0026#34;قاعدة ٧٢\u0026#34;، طريقة لتقدير سنوات تضاعف المال تقريبًا. عندما يعطي استثمار عائدًا ٦% سنويًا، باستخدام هذه القاعدة، كم سنة تقريبًا حتى يتضاعف المال الأصلي؟","image":null,"video":null,"explanation":"تعطي قاعدة ٧٢ دليلًا لسنوات تضاعف المال تقريبًا بـ\u0026#34;٧٢ ÷ رقم نسبة النمو السنوية\u0026#34;. بنمو ٦% كل سنة، ٧٢ ÷ ٦ = ١٢. أي أنه يتضاعف بحوالي ١٢ سنة. الجواب D.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"958":{"id":958,"subject_id":7,"type":"mcq","question_text":"بمعرفة أن الفائدة المركبة تنمو أكثر في النصف الثاني كلما جعلت الوقت حليفك، تقارن بين عدة إدارات. من بين التالية، عند الإدارة بالفائدة المركبة، باستخدام \u0026#34;قاعدة ٧٢\u0026#34;، أيها يحقق أكبر مقدار من النمو في النهاية؟ (نسبة النمو ٥% في السنة لكلها.)","image":null,"video":null,"explanation":"تعطي قاعدة ٧٢ دليلًا لسنوات تضاعف المال تقريبًا بـ\u0026#34;٧٢ ÷ رقم نسبة النمو\u0026#34;. ما يُسأل عنه هو \u0026#34;المقدار المتزايد\u0026#34;، ليس الإجمالي النهائي نفسه. بـ٥% في السنة، ٧٢ ÷ ٥ = حوالي ١٤ سنة لتضاعف أصل المبلغ تقريبًا. لدى B ٣٠ سنة، ضعف تقريبي لفترة الـ١٤ سنة، فتزيد ١٬٠٠٠ جنيه إلى ضِعف الضِعف = حوالي ٤ مرات أو أكثر، أكبر نمو. لدى C أصل مبلغ كبير ٣٬٠٠٠ جنيه، لكن في ٥ سنوات عمل التراكم لا يزال صغيرًا، فالنمو صغير. لدى D أيضًا مدة قصيرة ونمو صغير. للاستفادة من الفائدة المركبة، \u0026#34;مدة إدارة طويلة\u0026#34; تهم أكثر من حجم أصل المبلغ، فأكبر مقدار نمو هو B، الفترة الأطول.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"959":{"id":959,"subject_id":7,"type":"mcq","question_text":"نحو حلمك في فتح محلك الخاص يومًا ما، تريد تحضير مال بدء تشغيل كبير. أي مما يلي أفضل طريقة لتحضير المال؟","image":null,"video":null,"explanation":"تكاليف المعيشة وصندوق الطوارئ أموال قد تواجه مشكلة إذا انخفضت قيمتها، فلا تضعها في الاستثمار؛ أمّنها في اليد. فوق ذلك، ضع جانبًا بشكل منهجي كأموال بدء تشغيل \u0026#34;الأموال الفائضة\u0026#34; المتبقية بعد طرحهما (مال بلا خطط للمعيشة أو الطوارئ القريبة). الجواب C. A، وضع حتى المعيشة والتحضير في الاستثمار يتركك عالقًا عندما يحدث شيء. D، استخدام صندوق الطوارئ خطير. B، تحضير مبالغ كبيرة بشكل مفاجئ صعب؛ التحضير المبكر واقعي.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"960":{"id":960,"subject_id":7,"type":"mcq","question_text":"عمرك ٣٥ سنة، وطفل انضم للأسرة. مع وجود أكثر لحمايته، تفكّر بجدّية في التحضير للطوارئ. ما المقصود بـ\u0026#34;المخاطر\u0026#34; التي تحتاج إلى الاستعداد لها؟ أي مما يلي يشرح ذلك بأفضل شكل؟","image":null,"video":null,"explanation":"المخاطر التي تحتاج تحضيرًا لها خاصيتان: \u0026#34;موعد حدوثها واحتمال وقوعها غير معروفين\u0026#34; و\u0026#34;بمجرد حدوثه له أثر كبير على الحياة\u0026#34;. المرض والإصابة والحوادث والكوارث تطابق؛ هذه نفسها ليست عن المال، لكن بمجرد حدوثها لها أثر كبير على الحياة والمال. الجواب D. A وB يمكن التنبّؤ بهما مسبقًا، وC له أثر صغير جدًا بلا مشكلة حتى إذا حدث؛ لا واحدة منها تُعتبَر \u0026#34;خطرًا\u0026#34; يحتاج تحضيرًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"961":{"id":961,"subject_id":7,"type":"mcq","question_text":"وُلِد طفل، وتفكّر في أخذ تأمين جديد للأسرة. مع التأمين، قسط صغير يوفّر تحضيرًا كبيرًا للطوارئ. أي مما يلي يشرح بأفضل شكل لماذا يصح هذا؟","image":null,"video":null,"explanation":"التأمين آلية يضع فيها أشخاص كثيرون قسطًا صغيرًا كل واحد، واستنادًا إلى حقيقة أن الأحداث المفاجئة لا تحدث للجميع في الوقت نفسه، تُقدِّم مبلغًا لمن ضربه سوء الحظ. كلما زاد المشتركون، زاد الاستقرار، وعبء شخص واحد صغير بينما يُحضَّر لمصروف كبير. الجواب A. B تتجاهل أن الأفراد يدفعون الأقساط؛ C شرح مختلف أقرب للوضع جانبًا المسبق؛ D يختلف عن التأمين في الجمع بعد الحدوث.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"962":{"id":962,"subject_id":7,"type":"mcq","question_text":"بينما تفكّر في التحضير لطفلك، تتحقّق من تفاصيل \u0026#34;تأمين تعاضدي\u0026#34; معين. لهذا التأمين ١٬٠٠٠ مشترك، يضع كل واحد ٦٠٠ جنيه سنويًا، بإجمالي ٦٠٠٬٠٠٠ جنيه. هذا العام، ١٠ أشخاص ضربهم سوء الحظ استلموا ٥٠٬٠٠٠ جنيه كل واحد (٥٠٠٬٠٠٠ جنيه إجمالًا)، والـ١٠٠٬٠٠٠ جنيه المتبقية أصبحت تكاليف تشغيل. من الـ٦٠٠ جنيه التي دفعتها، أي مما يلي هو التقسيم الصحيح لـ\u0026#34;الجزء المُستخدَم لإغاثة شخص\u0026#34; و\u0026#34;الجزء الذي ذهب لتكاليف التشغيل\u0026#34;؟","image":null,"video":null,"explanation":"محتوى القسط، عند حسابه، ينقسم إلى اثنين. بقسمة إجمالي الإغاثة المُستخدَم، ٥٠٠٬٠٠٠ جنيه، على ١٬٠٠٠ مشترك، يكون ٥٠٠ جنيه للفرد. بطرح هذه الـ٥٠٠ جنيه من الـ٦٠٠ جنيه التي دفعتها، الـ١٠٠ جنيه المتبقية تكاليف تشغيل. الجواب B.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"963":{"id":963,"subject_id":7,"type":"mcq","question_text":"بتنظيم التأمين الذي اشتركت فيه، تتعلّم أنه بجانب التأمين الذي تختاره وتلتحق به بنفسك، هناك تأمين تديره الدولة. التحضير للمرض والإصابة والشيخوخة والبطالة وما شابه، حيث يُسجَّل من يستوفون الشروط تلقائيًا، أي مما يلي يُعد تأمينًا عامًا من هذا النوع؟","image":null,"video":null,"explanation":"التأمين العام (التأمين الاجتماعي) تديره الدولة، ومن يستوفون الشروط يُسجَّلون تلقائيًا، ويدعم الرعاية الطبية والمعاشات والبطالة وما شابه. الجواب C. A وB وD تحضيرات طوعية تتقدّم لها بإرادتك الخاصة، ليست تأمينًا عامًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"964":{"id":964,"subject_id":7,"type":"mcq","question_text":"بينما تراجع التحضيرات كأسرة، تتعلّم أن التحضير للطوارئ له ثلاث طبقات: \u0026#34;المساعدة الذاتية\u0026#34;، و\u0026#34;التعاضد\u0026#34;، و\u0026#34;المساعدة العامة\u0026#34;. أي مما يلي تطابقه ①-③؟ أي توليفة صحيحة؟\n① صندوق طوارئ مُدَّخَر بثبات في حسابك الخاص\n② تأمين خاص يضع فيه كثيرون أقساطًا ويدفع لمن في مأزق\n③ ضمان اجتماعي مُغطًّى بالضرائب واشتراكات التأمين الاجتماعي، تديره الدولة","image":null,"video":null,"explanation":"المساعدة الذاتية هي التحضير بنفسك، التعاضد دعم بعضكم بعضًا بين كثيرين، المساعدة العامة دعم من المجتمع بأكمله (الدولة). ① صندوق طوارئ تضعه جانبًا بنفسك مساعدة ذاتية، ② تأمين يضع فيه كثيرون ويدفع تعاضد، ③ ضمان اجتماعي مُغطًّى بالضرائب واشتراكات التأمين الاجتماعي مساعدة عامة. ف① مساعدة ذاتية، ② تعاضد، ③ مساعدة عامة، والجواب A.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"965":{"id":965,"subject_id":7,"type":"mcq","question_text":"بينما تبحث في خيارات التأمين، تتعلّم عن \u0026#34;التكافل\u0026#34;، آلية تعاضد تنتشر في مصر أيضًا. أي مما يلي يصف بأفضل شكل خاصية التكافل؟","image":null,"video":null,"explanation":"التكافل آلية يُستخدَم فيها المال الذي يضعه المشتركون للتعاضد ويُدفَع منه. المال المُجمَّع يُعامَل كملكية لكل المشتركين، ليس ربح المُشغِّل، والمتبقي يمكن أن يعود للمشتركين. الجواب D. A وC تُعطيان الأولوية لربح المُشغِّل، ضد روح التعاضد. B، الإقراض لتنميته لا ينطبق.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"966":{"id":966,"subject_id":7,"type":"mcq","question_text":"في عطلة نهاية أسبوع، بينما تراجعون ميزانية الأسرة كأسرة، تناقشون كيفية التحضير لمصروفات الطوارئ. للمصروفات الصغيرة اليومية والمصروفات الكبيرة النادرة، أيهما منطقي للتحضير به، \u0026#34;الادّخار\u0026#34; أو \u0026#34;التأمين\u0026#34;، على التوالي؟","image":null,"video":null,"explanation":"المصروفات الصغيرة اليومية صغيرة في المقدار، فالتحضير بمدخراتك الخاصة منطقي. المصروفات النادرة لكن الكبيرة يمكن أن تتجاوز المدخرات وحدها، فحضّر بالتأمين المُتشارَك بين كثيرين. الجواب C.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"967":{"id":967,"subject_id":7,"type":"mcq","question_text":"بعد تحضير مجموعة كاملة من التحضيرات لطفلك، تراجع ما إذا كانت تناسب ميزانية أسرتك. ما أقل طريقة تفكير مناسبة للتحضير للمخاطر؟","image":null,"video":null,"explanation":"التحضير للمخاطر يُفكَّر فيه بتوازن حجم الخسارة وميزانية الأسرة. A وC وD منطقية. زيادة التأمين رغم ضيق الميزانية قد يُضعف الاستعداد للطوارئ. فالأقل مناسبة هي B.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"968":{"id":968,"subject_id":7,"type":"mcq","question_text":"عمرك ٣٨ سنة، تبدأ تحضيرات فتح محلك الخاص الذي طال انتظاره. تفكّر في كيفية دفع المعدات المُستخدَمة في الفتح (السعر المُعلَن ٣٠٬٠٠٠ جنيه). لديك مساحة في أموالك في اليد. هذا الجدول يُظهر ثلاث طرق دفع مع رسومها الإضافية (أو رسوم الفائدة) ومقادير الدفع الإجمالية النهائية. أي طريقة دفع هي الأكثر منطقية؟","image":"image_3_12_6_ar.png","video":null,"explanation":"الدفع اللاحق (التقسيط/المتجدّد) يتيح لك تأجيل الدفع، لكن هذا يعني دفع تكلفة إضافية دون حاجة. إذا كانت لديك مساحة في الأموال في اليد، الدفع دفعة واحدة بلا تكلفة إضافية منطقي. الجواب C. الدفع المتجدّد في A سهل الإدارة لكن له أكبر مقدار دفع إجمالي نهائي. B يحتفظ بالمال في اليد، لكن مع وجود مساحة الآن يصبح خسارة بالمبلغ المُضاف. D، حتى مع دفعة صغيرة، التقسيط يزيد الإجمالي النهائي بالمبلغ المُضاف بدلًا من ذلك.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"969":{"id":969,"subject_id":7,"type":"mcq","question_text":"بعد الفتح، تشتري المعدات اللازمة. للحفاظ على النقد في اليد، تقرر الدفع ببطاقة ائتمان. لتقليل عبء رسوم البطاقة إلى الحد الأدنى، أي مما يلي طريقة الدفع الأنسب؟","image":null,"video":null,"explanation":"الدفع اللاحق بالائتمان مريح، لكن التقسيط والدفع المتجدّد يزيدان الرسوم كلما مدّدت فترة الدفع. الدفع دفعة واحدة الشهر القادم يتجنّب زيادة عبء الرسوم. الجواب A. B وC وD جميعها تمدّد فترة الدفع وتميل لزيادة إجمالي الرسوم.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"970":{"id":970,"subject_id":7,"type":"mcq","question_text":"بعد الفتح، تبدأ معاملات مع شريك أعمال جديد. للتحقّق \u0026#34;هل هذا الشخص يدفع في الوقت المناسب\u0026#34;، يستخدمون \u0026#34;معلومات الائتمان\u0026#34;. أي مما يلي هو التوليفة الأنسب للكلمات في ( ① ) و( ② ) في الجملة التالية؟\n\u0026#34;معلومات الائتمان تُصنَع بناءً على تاريخ ( ① ) الماضي، وهي سجل تُديره ( ② )\u0026#34;.","image":null,"video":null,"explanation":"معلومات الائتمان تُصنَع بناءً على تاريخ سداد الدفعات والاقتراض (①)، وتُديرها وكالة متخصّصة (②). ليست سمعة شريك أو إجمالي أصول. الجواب D. تراكم حفظ الدفعات يتصل بالائتمان.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"971":{"id":971,"subject_id":7,"type":"mcq","question_text":"تدفع لاحقًا مقابل معدات فتح بقيمة ٢٠٬٠٠٠ جنيه للحفاظ على النقد في اليد. عندما تُطبَّق رسوم ١٠% لاستخدام المال لفترة إضافية، ما المقدار الإجمالي النهائي للدفع؟","image":null,"video":null,"explanation":"تكلفة استخدام الدفع المؤخَّر (المبلغ المُضاف) هي ١٠% من ٢٠٬٠٠٠ جنيه = ٢٬٠٠٠ جنيه. المقدار الإجمالي النهائي للدفع هو ٢٠٬٠٠٠ + ٢٬٠٠٠ = ٢٢٬٠٠٠ جنيه. الجواب B. A ينسى المبلغ المُضاف، C خطأ حساب بـ٥%، وD مقدار مختلف لا ينطبق.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"972":{"id":972,"subject_id":7,"type":"mcq","question_text":"أنت على وشك شراء معدات للمحل بالدفع بالتقسيط. لتقييم خطر السداد طويل المدى بشكل صحيح، أي مما يلي أنسب عقلية قبل التقديم؟","image":null,"video":null,"explanation":"الدفع بالتقسيط يمكن أن يجعل كل عبء صغيرًا، لكن كلما زادت الدفعات، زاد إجمالي المبلغ المُضاف. فA، التي تعتبر إمكانية تغيّر الدخل والإجمالي شاملًا المُضاف، وتؤكّد أنك تستطيع الدفع دون ضغط حتى النهاية، هي الأنسب. B تنظر فقط لدفعة هذا الشهر، دون اعتبار تغيّرات الدخل المستقبلية أو الإجمالي النهائي. C يقلل من العبء الشهري لكنه يزيد إجمالي المدفوعات على المدى الطويل. D، الدفع المتجدّد أيضًا يُلحَق به مبلغ إضافي وفقًا للرصيد، وكلما امتدّ الدفع، يزيد الإجمالي أكثر.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"973":{"id":973,"subject_id":7,"type":"mcq","question_text":"بعد الفتح بفترة قصيرة، يقترب منك عرض: \u0026#34;اكسب كبيرًا بشكل موثوق بلا رأس مال\u0026#34;. من بين ①-④ التالية، أي توليفة تجمع الخصائص المشتركة للدعوات المشبوهة؟\n① التأكيد \u0026#34;ستكسب مالًا بالتأكيد\u0026#34;\n② جعلك تؤكّد محتويات العقد كتابيًا بثبات\n③ إرباكك بـ\u0026#34;الآن فقط\u0026#34;، \u0026#34;أنت فقط\u0026#34;\n④ إغراؤك بأن المال سيأتي إذا أحضرت آخرين","image":null,"video":null,"explanation":"الدعوات المشبوهة لها خصائص كالتأكيد \u0026#34;ستكسب مالًا بالتأكيد\u0026#34; (①)، والإرباك بـ\u0026#34;الآن فقط\u0026#34;، \u0026#34;أنت فقط\u0026#34; (③)، وحثّك على إحضار آخرين وسحبهم (④). جعلك تؤكّد محتويات العقد كتابيًا بثبات، كما في ②، هو بدلًا من ذلك خاصية معاملات مشروعة. ف①③④، والجواب C.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"974":{"id":974,"subject_id":7,"type":"mcq","question_text":"بالنظر مستقبلًا لتوسيع محلك، تفكّر في الطريقة الصحيحة للتعامل مع الدين. ما الأقل مناسبة كطريقة تفكير في \u0026#34;الدين الجيد والدين السيء\u0026#34;؟","image":null,"video":null,"explanation":"الدين الجيد له غرض واضح وخطة سداد وهو قابل للسداد ضمن الدخل. A وC وD طرق تفكير صحيحة. الاقتراض من جديد لملء فجوة السداد، كما في B، يصبح \u0026#34;دوامة دين\u0026#34; يتضخّم فيها الدين كرة ثلج، مما يزيد الأمور صعوبة. فالأقل مناسبة هي B.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"975":{"id":975,"subject_id":7,"type":"mcq","question_text":"عمرك ٤٥ سنة، وكمدير، تتحقّق دائمًا من حالة إدارة شركاء أعمالك (الائتمان). أخبار عن شريك معين أفادت بـ\u0026#34;أزمة تخلّف عن السداد (عدم أداء الواجب)\u0026#34;. ما الحالة التي تشير إليها؟","image":null,"video":null,"explanation":"التخلّف عن السداد (عدم أداء الواجب) يشير إلى حالة عدم القدرة على سداد مال وعد بسداده (دين أو سعر) كما وُعِد. الجواب A. توقّف العمليات في B، والدمج في C، وتقليص الرواتب في D، كلها تختلف عن التخلّف عن السداد. عندما يقع شريك في هذه الحالة، هناك خطر عدم استلام السعر، فالتحقّق من الائتمان مهم.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"976":{"id":976,"subject_id":7,"type":"mcq","question_text":"محلك المفتوح كسب عملاء دائمين تدريجيًا، لكن في المنتصف، تراكمت دفعات استثمار المعدات وأصبحت السيولة النقدية ضيقة. للنجاة بأمان من هذه الضيقة دون تدمير المحل وحياتك الخاصة، أي مما يلي هو الردّ الأنسب؟","image":null,"video":null,"explanation":"إذا أصبح السداد صعبًا، الأهم هو عدم حمله بمفردك والاستشارة مبكرًا قبل الوصول لحائط مسدود. كما في D، قبل التوقّف تمامًا، التواصل مع المُقرِض أو خط مساعد ومناقشة مراجعة كيفية السداد هو الأفضل. A، الاستمرار في السداد باقتراض جديد يسقط بسهولة في دوامة دين يستدعي فيها الدين دينًا. B، أسلوب سداد يقلّص الحياة بشدة لا يدوم ويصل بسهولة لحائط مسدود في المنتصف. C، تجنّب التواصل يخسر الائتمان ويتصل بدلًا من ذلك بالتخلّف عن السداد. الجواب D.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"977":{"id":977,"subject_id":7,"type":"mcq","question_text":"بلغت ٥٠ سنة. بفضل الخطة التي استمررت فيها بثبات، محلك الأول محبوب في المنطقة، والآن يدخل ربح ثابت ١٠٬٠٠٠ جنيه كل شهر. الآن، بعد ٥ سنوات، تتوجّه نحو حلم جديد: فتح محل ثانٍ بمبلغ هدف ١٨٠٬٠٠٠ جنيه. لتحقيق هذا الهدف بشكل موثوق، ما أدنى نسبة من ربحك الشهري ١٠٬٠٠٠ جنيه تحتاج إلى ادخارها أولًا للمحل الثاني؟","image":null,"video":null,"explanation":"أولًا، احسب عكسيًا الوضع جانبًا الشهري المطلوب: ١٨٠٬٠٠٠ جنيه ÷ ٦٠ شهرًا (٥ سنوات) = ٣٬٠٠٠ جنيه شهريًا. بعده، انظر إلى كم نسبة ذلك من ربح ١٠٬٠٠٠ جنيه: ٣٬٠٠٠ ÷ ١٠٬٠٠٠ = ٣٠%. فوضع ٣٠% من الربح الشهري جانبًا أولًا يكفي. الجواب B.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null}},"options":{"928":[{"id":3709,"question_id":928,"subject_id":7,"sort_order":1,"text":"سجّل الإنفاق اليومي بتفصيل بتطبيق ميزانية وأدره حتى لا تنفق أكثر من اللازم","image":null,"video":null},{"id":3710,"question_id":928,"subject_id":7,"sort_order":2,"text":"انقل راتبك لحساب مخصَّص لتكاليف المعيشة واسحب فقط ما تحتاجه","image":null,"video":null},{"id":3711,"question_id":928,"subject_id":7,"sort_order":3,"text":"قرّر مسبقًا كيفية تخصيص مالك للإيجار، والطعام، والمدخرات، وما شابه","image":null,"video":null,"is_correct":true},{"id":3712,"question_id":928,"subject_id":7,"sort_order":4,"text":"تحقّق بشكل متكرر من رصيد حسابك بينما تنفق، وتوقّف إذا بدا أنه سينفد","image":null,"video":null}],"929":[{"id":3713,"question_id":929,"subject_id":7,"sort_order":1,"text":"أعطِ الأولوية للأكل بالخارج مع الزملاء ظهرًا، وغطِّ إنفاق المساء بتقليص تكاليف الطعام في أيام أخرى","image":null,"video":null},{"id":3714,"question_id":929,"subject_id":7,"sort_order":2,"text":"للتحضير للإنفاق المؤكَّد في المساء، جلب وجبة ظهرًا لتقليل الإنفاق مسبقًا","image":null,"video":null,"is_correct":true},{"id":3715,"question_id":929,"subject_id":7,"sort_order":3,"text":"جلب وجبة ظهرًا لتقليل الإنفاق، واترك تجمّع المساء أيضًا مبكرًا للتوفير","image":null,"video":null},{"id":3716,"question_id":929,"subject_id":7,"sort_order":4,"text":"أعطِ ال