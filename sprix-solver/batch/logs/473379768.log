ل، فيصعب أن تصبح علاقة دعم متبادل.\u003c/li\u003e\u003cli\u003eC: هذا تفسير للتداول قصير المدى، ليس طريقة لتقسيم الأهداف الاستثمارية إلى عدة أجزاء.\u003c/li\u003e\u003cli\u003eD: هذا تفسير للاستثمار بالتقسيط الذي يقسّم الزمن، وبما أن الهدف الاستثماري نفسه يبقى شركة واحدة، ليس تنويعًا.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1250":{"id":1250,"subject_id":7,"type":"mcq","question_text":"يبني شخص استثماره كما يلي ويفكر، \u0026#34;أنا أُنوّع بالمحاور الثلاثة للتنويع\u0026#34;.\n\u0026#34;اخترت ٥ أسهم من قطاعات مختلفة داخل مصر، وأجمّع كل واحد بنفس المبلغ كل شهر. قسّمت الصناعات، واستمر كل شهر، فيجب أن أكون مُنوَّعًا بشكل كافٍ\u0026#34;.\nأي من المحاور التالية لم يُنوّع هذا الشخص فيه؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: مع التنويع عبر فئات الأصول، بما أنها فقط شركات داخل مصر، التنويع عبر المناطق لم يُنفَّذ أيضًا.\u003c/li\u003e\u003cli\u003eB: مع التنويع عبر المناطق، بما أن ما يُحمَل هو أسهم فقط، التنويع عبر فئات الأصول لم يُنفَّذ أيضًا.\u003c/li\u003e\u003cli\u003eC: بما أنه يُجمِّع بنفس المبلغ كل شهر، التنويع عبر الزمن مُنفَّذ.\u003c/li\u003e\u003cli\u003eD: صحيح!\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1251":{"id":1251,"subject_id":7,"type":"mcq","question_text":"محفظة شخص هي \u0026#34;أسهم ٨٠%، سندات ٢٠%\u0026#34;. أي مما يلي عبارة دقيقة عن هذه المحفظة؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: بينما الأسهم الكثيرة تسهّل استهداف ربح كبير، يصبح التحرك السعري كبيرًا أيضًا، ولا يعني أن قلق تحمّل الخسارة يتلاشى.\u003c/li\u003e\u003cli\u003eB: لا توجد إجابة صحيحة واحدة للبناء، وإذا كان يتناسب مع قدرة الشخص على تحمل المخاطر، لا يمكن تسميته خطأ.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: بينما السندات ٢٠% يمكن أن تخفف التحرك السعري، لا يمكنها إزالته تقريبًا.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1252":{"id":1252,"subject_id":7,"type":"mcq","question_text":"أي مما يلي أقرب إلى معنى PER (نسبة السعر إلى الربحية)؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: هذا تفسير للإيرادات، ليس PER.\u003c/li\u003e\u003cli\u003eB: صحيح!\u003c/li\u003e\u003cli\u003eC: هذا تفسير لـPBR، حيث الشيء المُقارَن هو صافي الأصول، لا صافي الربح.\u003c/li\u003e\u003cli\u003eD: هذا تفسير لـROE، رقم يقيس كفاءة الكسب دون استخدام سعر السهم.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1253":{"id":1253,"subject_id":7,"type":"mcq","question_text":"بمقارنة الشركة أ والشركة ب في نفس الصناعة، كان ROE الشركة أ ١٨% وROE الشركة ب ٦%. أي مما يلي شيء مناسب يمكن قوله من هذا؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: ROE رقم لكفاءة الكسب، ليس شيئًا يُظهر ارتفاع أو انخفاض سعر السهم.\u003c/li\u003e\u003cli\u003eB: ROE نسبة كفاءة، وحجم الشركة لا يمكن معرفته من ROE.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: حتى سعر سهم شركة فعّالة يتحرك، فقلق تحمّل الخسارة لا يتلاشى.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1254":{"id":1254,"subject_id":7,"type":"mcq","question_text":"PER شركة معينة أقل بكثير من متوسط الصناعة، وPBR أيضًا أقل من ١ مرة. في المقابل، حقق عملها ربحًا بثبات لسنوات عديدة. أي نوع من المستثمرين سيميل أكثر إلى اعتبار هذه الشركة مرشحة للشراء، ولماذا؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: صحيح!\u003c/li\u003e\u003cli\u003eB: ما يركّز عليه الاستثمار في النمو هو النمو المستقبلي، وانخفاض PER نفسه لا يعني حجم النمو.\u003c/li\u003e\u003cli\u003eC: اتجاه الأسلوب صحيح، لكن حتى أقل من ١ مرة لا يرتفع بالضرورة (هناك أحيانًا سبب للرخص).\u003c/li\u003e\u003cli\u003eD: الاستقرار الحالي والنمو السريع المستقبلي أمران منفصلان، وخصائص هذه الشركة تختلف عن نقطة تركيز النمو.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1255":{"id":1255,"subject_id":7,"type":"mcq","question_text":"يفكر شخص، \u0026#34;لدي فقط حوالي ٢٠٠ جنيه شهريًا لتوجيهه للاستثمار، فحمله مُقسّمًا إلى عدة أجزاء مستحيل بالنسبة لي\u0026#34;. أي مما يلي هو النصيحة الأنسب لهذا الشخص؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: حتى بمبلغ صغير، إذا استخدمت آلية الجمع والتقسيم والاستثمار، لا يجب أن تتنازل عن التنويع.\u003c/li\u003e\u003cli\u003eB: صحيح!\u003c/li\u003e\u003cli\u003eC: الإيداع البنكي ليس منتجًا يُسلَّم للإدارة، ولا يعمل بنفس طريقة صندوق استثماري.\u003c/li\u003e\u003cli\u003eD: صندوق استثماري له أجر للإدارة، ويمكن أن يزيد أو ينخفض.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1256":{"id":1256,"subject_id":7,"type":"mcq","question_text":"أي مما يلي أقرب كخاصية للصندوق المتداول في البورصة (ETF)؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: هذه طريقة شراء وبيع صندوق استثماري عادي، والصندوق المتداول في البورصة يمكن تداوله في السوق بسعر اللحظة.\u003c/li\u003e\u003cli\u003eB: الصندوق المتداول في البورصة عبوة تجمع أسهم وسندات شركات متعددة، ليس فقط شركة واحدة.\u003c/li\u003e\u003cli\u003eC: بما أن الصندوق المتداول في البورصة منتج مُدار، يتحرك سعره، ولا يوجد ضمان لرأس المال.\u003c/li\u003e\u003cli\u003eD: صحيح!\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1257":{"id":1257,"subject_id":7,"type":"mcq","question_text":"تحمل منتجًا مرتبطًا بمؤشر يحتوي على أسهم ٣٠ شركة رئيسية في دولة معينة. إذا تراجع أداء إحدى تلك الشركات وانخفض سعر سهم تلك الشركة فقط بشكل كبير، ماذا يحدث لسعر هذا المنتج من بين التالي؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: صحيح!\u003c/li\u003e\u003cli\u003eB: بما أن المنتج مزيج من ٣٠ شركة، مدى انخفاض شركة واحدة لا يصبح مدى انخفاض الكل كما هو.\u003c/li\u003e\u003cli\u003eC: ليست آلية توزيع الانخفاض بين أشخاص كثيرين -إذا انخفض سعر المنتج نفسه، يؤثر على كل من يحمله بنفس النسبة.\u003c/li\u003e\u003cli\u003eD: منتج مرتبط مبني للربط بحركة السوق، ليس آلية تتجنب الانخفاضات تلقائيًا.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1258":{"id":1258,"subject_id":7,"type":"mcq","question_text":"تقوم بالاستثمار بالتقسيط بـ٣٠٠ جنيه كل شهر. في يناير كان سعر المنتج ٣٠ جنيهًا للوحدة، وفي فبراير ١٥ جنيهًا للوحدة. أي مما يلي يفسّر بأفضل شكل تأثير طريقة الشراء هذه على مدى هذين الشهرين، مع مراعاة آلية الاستثمار بالتقسيط؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: بما أنك شريت أكثر في الشهر الرخيص، يصبح متوسط سعر الشراء الفعلي أرخص من ٢٢٫٥ جنيهًا. لا يصبح نفس نتيجة المتوسط البسيط.\u003c/li\u003e\u003cli\u003eB: صحيح!\u003c/li\u003e\u003cli\u003eC: بما أن متوسط سعر الشراء مُوزَّن بالكمية المُشتراة، لا ينخفض إلى سعر الشهر الأرخص (في هذا المثال، يناير ٣٠ جنيهًا وفبراير ١٥ جنيهًا يجعلان متوسط سعر الشراء ٢٠ جنيهًا). عمل التقسيط هو توسيط المتوسط، لا مطابقة أدنى سعر.\u003c/li\u003e\u003cli\u003eD: في شهر انخفضت فيه القيمة، يمكنك شراء وحدات أكثر بنفس المبلغ. لذلك في الاستثمار بالتقسيط، بالاستمرار في الشراء بمبلغ ثابت حتى إذا تقلب السعر، يسهل تقليل متوسط سعر الشراء.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null}},"options":{"1249":[{"id":4993,"question_id":1249,"subject_id":7,"sort_order":1,"text":"طريقة لتقسيم الأهداف الاستثمارية إلى عدة أجزاء، بحيث حتى إذا انخفض أحدها، يمكن للأخرى دعمه","image":null,"video":null,"is_correct":true},{"id":4994,"question_id":1249,"subject_id":7,"sort_order":2,"text":"طريقة لتضييق الأهداف الاستثمارية إلى شركات في نفس الصناعة فقط، واستثمار الأموال مُقسّمة عبر شركات متعددة","image":null,"video":null},{"id":4995,"question_id":1249,"subject_id":7,"sort_order":3,"text":"طريقة لبيع وشراء سهم شركة واحدة عدة مرات بما يتماشى مع تحرك السعر، مستهدفًا الربح من الفرق","image":null,"video":null},{"id":4996,"question_id":1249,"subject_id":7,"sort_order":4,"text":"طريقة للاستمرار في شراء سهم شركة واحدة بمبلغ ثابت كل شهر، تقسيم توقيت الشراء","image":null,"video":null}],"1250":[{"id":4997,"question_id":1250,"subject_id":7,"sort_order":1,"text":"التنويع عبر فئات الأصول","image":null,"video":null},{"id":4998,"question_id":1250,"subject_id":7,"sort_order":2,"text":"التنويع عبر المناطق","image":null,"video":null},{"id":4999,"question_id":1250,"subject_id":7,"sort_order":3,"text":"التنويع عبر الزمن","image":null,"video":null},{"id":5000,"question_id":1250,"subject_id":7,"sort_order":4,"text":"كلا التنويع عبر فئات الأصول والتنويع عبر المناطق","image":null,"video":null,"is_correct":true}],"1251":[{"id":5001,"question_id":1251,"subject_id":7,"sort_order":1,"text":"بما أن هناك أسهمًا كثيرة، هو بناء يمكن أن يستهدف ربحًا كبيرًا دون القلق من تحمّل خسارة","image":null,"video":null},{"id":5002,"question_id":1251,"subject_id":7,"sort_order":2,"text":"بما أن الأسهم ٨٠% كثيرة جدًا، هو خطأ كبناء","image":null,"video":null}