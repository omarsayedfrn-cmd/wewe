image":null,"video":null},{"id":3963,"question_id":991,"subject_id":7,"sort_order":3,"text":"الاستثمار","image":null,"video":null},{"id":3964,"question_id":991,"subject_id":7,"sort_order":4,"text":"الفائدة المركبة","image":null,"video":null}],"992":[{"id":3965,"question_id":992,"subject_id":7,"sort_order":1,"text":"حوالي ٢٠ سنة","image":null,"video":null},{"id":3966,"question_id":992,"subject_id":7,"sort_order":2,"text":"حوالي ١٤ سنة","image":null,"video":null,"is_correct":true},{"id":3967,"question_id":992,"subject_id":7,"sort_order":3,"text":"حوالي ٣٦ سنة","image":null,"video":null},{"id":3968,"question_id":992,"subject_id":7,"sort_order":4,"text":"حوالي ٧ سنوات","image":null,"video":null}],"993":[{"id":3969,"question_id":993,"subject_id":7,"sort_order":1,"text":"لنمو الفائدة، تُظهر الفائدة الثابتة أثرها أكثر كلما كبر أصل المبلغ، بينما الفائدة المركبة، على العكس، تُظهره أكثر كلما صغر أصل المبلغ","image":null,"video":null},{"id":3970,"question_id":993,"subject_id":7,"sort_order":2,"text":"لنمو الفائدة، الفائدة الثابتة لا تضمّه لأصل المبلغ بينما الفائدة المركبة تدمجه فيه، فيتوسّع الفرق مع مرور الوقت","image":null,"video":null,"is_correct":true},{"id":3971,"question_id":993,"subject_id":7,"sort_order":3,"text":"لنمو الفائدة، الفائدة الثابتة تصبح أقل فائدة كلما قصرت الإدارة، بينما الفائدة المركبة، على العكس، تصبح أكثر فائدة كلما قصرت الإدارة","image":null,"video":null},{"id":3972,"question_id":993,"subject_id":7,"sort_order":4,"text":"بغض النظر عن طول مدة الإدارة، لا ينشأ فرق في نمو الفائدة النهائي بين الثابتة والمركبة","image":null,"video":null}],"994":[{"id":3973,"question_id":994,"subject_id":7,"sort_order":1,"text":"آلية تحتفظ فيها الدولة مؤقتًا بمدخرات فرد وتعيدها له عند الحاجة","image":null,"video":null},{"id":3974,"question_id":994,"subject_id":7,"sort_order":2,"text":"آلية يجتمع فيها فقط من في مأزق ويقدّمون المال المطلوب في الموقع لمساعدة بعضهم بعضًا","image":null,"video":null},{"id":3975,"question_id":994,"subject_id":7,"sort_order":3,"text":"آلية يدفع فيها ك