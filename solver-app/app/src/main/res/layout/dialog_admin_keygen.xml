<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/burgundy_deep"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="🔐 Key Generator (Admin)"
        android:textColor="@color/gold"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="Generate activation keys for clients"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Client Device ID:"
        android:textColor="@color/gold"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/inputClientDeviceCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@color/terminal_bg"
        android:hint="e.g. OM-7B4F-9E21"
        android:textColorHint="@color/muted"
        android:padding="12dp"
        android:textColor="@color/cream"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPasteCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/burgundy"
            android:text="Paste"
            android:textColor="@color/cream"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnMyDeviceCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@color/burgundy"
            android:text="This Device"
            android:textColor="@color/cream"
            android:textSize="12sp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnDoGenerateKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:backgroundTint="@color/gold"
        android:text="Generate Activation Key"
        android:textColor="@color/burgundy_deep"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Generated Key:"
        android:textColor="@color/gold"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/outputGeneratedKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@color/terminal_bg"
        android:editable="false"
        android:focusable="false"
        android:hint="ACT-XXXX-XXXX-XXXX"
        android:textColorHint="@color/muted"
        android:padding="12dp"
        android:textColor="@color/gold"
        android:textIsSelectable="true"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCopyGeneratedKey"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/gold"
        android:text="Copy Key to Clipboard"
        android:textColor="@color/burgundy_deep"
        android:textStyle="bold" />

</LinearLayout>
