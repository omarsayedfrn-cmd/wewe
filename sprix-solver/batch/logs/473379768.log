ربح الشركة.\u003c/li\u003e\u003cli\u003eB: هذا يصف \u0026#34;النفقات\u0026#34;، ليس ربح الشركة.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: هذا عن أموال الاستثمار، ليس وصفًا لربح الشركة.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"856":{"id":856,"subject_id":7,"type":"mcq","question_text":"بخصوص استخدامات ربح الشركة الذي حققته شركة، من بين ① إلى ④ التالية، أي توليفة تختار كل ما ينطبق كاستخدامات لربح الشركة؟\n① الاستثمار الرأسمالي والبحث والتطوير (الاستثمار في مصانع أو آلات جديدة، يُستخدَم للبحث والتطوير لمنتجات أو تصاميم جديدة)\n② توزيعات الأرباح (إعطاء جزء من ربح الشركة كنصيب للمساهمين الذين قدّموا مالًا للشركة)\n③ الأرباح المحتجزة (الاحتفاظ بها داخل الشركة للحالات الطارئة بدلًا من استخدام كل ربح الشركة)\n④ التبرع للمجتمع المحلي (الإعطاء كتبرع لفعاليات أو منظمات محلية)","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: بـ① و② فقط، تُستثنى \u0026#34;الأرباح المحتجزة\u0026#34;، واحدة من ثلاث استخدامات ربح الشركة.\u003c/li\u003e\u003cli\u003eB: بـ① و③ فقط، تُستثنى \u0026#34;توزيعات الأرباح\u0026#34;، واحدة من ثلاث استخدامات ربح الشركة.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: ④ التبرع للمجتمع المحلي يقع تحت \u0026#34;المساهمة في المجتمع والمنطقة المحلية\u0026#34; لـCSR وليس مُضمَّنًا بين استخدامات ربح الشركة الثلاث. إنه تحرّك تُعيد فيه الشركة جزءًا من أرباحها للمجتمع، ويُصنَّف في إطار منفصل عن استخدامات ربح الشركة الثلاث.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"857":{"id":857,"subject_id":7,"type":"mcq","question_text":"في أي من المشاهد التالية يحدث \u0026#34;الفصل بين الملكية والإدارة\u0026#34;؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: لمشروع فردي، الشخص الذي قدّم المال والشخص الذي يديره هما نفس الشخص، فلا يوجد فصل.\u003c/li\u003e\u003cli\u003eB: عندما تقوم أسرة بكلا الاستثمار والإدارة، الشخص الذي قدّم المال والشخص الذي يديره هما نفس الشخص.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: المنشأة العامة لها الحكومة الوطنية أو المحلية كجهة تشغيل ولا تُعامَل في إطار الفصل بين الملكية والإدارة.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"858":{"id":858,"subject_id":7,"type":"mcq","question_text":"لنفترض الأشخاص ① إلى ⑥ التاليين عن شركة أغذية معينة. من بينهم، أي توليفة تشمل كل الأشخاص الذين ينطبقون كـ\u0026#34;أصحاب مصلحة\u0026#34; لتلك الشركة؟\n① مساهم يقدّم مالًا للشركة\n② موظف يعمل في الشركة\n③ عميل يشتري منتجات الشركة (عميل)\n④ شركة أخرى تقدّم مواد خام (دقيق، سكر، إلخ) للشركة\n⑤ أشخاص محليون يعيشون قرب مصنع الشركة مباشرة\n⑥ شخص يعيش في منطقة أخرى لم يسمع باسم الشركة أبدًا","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: بـ① إلى ③ فقط، يُستثنى أصحاب المصلحة \u0026#34;شركاء الأعمال\u0026#34; و\u0026#34;المجتمع المحلي\u0026#34;.\u003c/li\u003e\u003cli\u003eB: بـ① إلى ④ فقط، يُستثنى صاحب المصلحة \u0026#34;المجتمع المحلي\u0026#34;.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: ⑥ شخص لم يسمع باسم الشركة أبدًا وليس له أي اتصال على الإطلاق. بما أنه لا يوجد اتصال مباشر بالشركة، لا ينطبق كصاحب مصلحة.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"859":{"id":859,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يصف بأفضل شكل \u0026#34;CSR (المسؤولية الاجتماعية للشركات)\u0026#34;؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: CSR لا يتناقض مع السعي للربح؛ إنه نهج واسع يأخذ بعين الاعتبار المسؤولية تجاه الأطراف المتورطة.\u003c/li\u003e\u003cli\u003eB: CSR يشير إلى المسؤولية تجاه نطاق واسع من الأطراف يشمل ليس فقط المساهمين بل الموظفين والعملاء والمجتمع المحلي والبيئة.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: CSR ليس واجب تبرّع؛ إنه نهج يأخذ بعين الاعتبار المسؤولية في كيفية عمل المشروع كله.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"860":{"id":860,"subject_id":7,"type":"mcq","question_text":"من بين التالية، أي فعل ينطبق على \u0026#34;الامتثال\u0026#34;؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: صحيح!\u003c/li\u003e\u003cli\u003eB: الإعلان جزء من نشاط المبيعات ويختلف عن الامتثال.\u003c/li\u003e\u003cli\u003eC: هذا عن استخدام لربح الشركة ويختلف عن الامتثال.\u003c/li\u003e\u003cli\u003eD: هذا اهتمام بالبيئة ويختلف عن الامتثال.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"861":{"id":861,"subject_id":7,"type":"mcq","question_text":"أي من التوليفات التالية تحدد بشكل صحيح كل العبارات الصحيحة (①-⑤) بخصوص ربح الشركة وأصحاب المصلحة والمسؤولية الاجتماعية للشركة؟\n① تُدار المنشأة العامة بهدف أساسي هو دعم حياة المواطنين.\n② يُقسَّم ربح الشركة ويُستخدَم في اتجاهات متعددة: الاستثمار الرأسمالي والبحث والتطوير / توزيعات الأرباح / الأرباح المحتجزة.\n③ في الشركة ذات المسؤولية المحدودة، لا يحتاج الأعضاء (المساهمون) إلى دفع دَين الشركة من أصولهم الخاصة بما يتجاوز ما استثمروه.\n④ CSR (المسؤولية الاجتماعية للشركات) واجب يجب على الشركة أن تتبرّع فيه دائمًا بجزء من أرباحها.\n⑤ الاستثمار وفق ESG تحرّك يُقيِّم الشركة بالنظر إلى ثلاثة محاور، البيئة، والمجتمع، والحوكمة، لا ربح الشركة فقط.","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: ① و② صحيحان، لكن ③ و⑤ أيضًا وصفان صحيحان ويجب تضمينهما جميعًا.\u003c/li\u003e\u003cli\u003eB: ②، ③، ⑤ صحيحة، لكن وصف ① للمنشآت العامة صحيح أيضًا ويجب تضمينه.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: ④ خاطئة. CSR هو \u0026#34;نهج تحاول فيه شركة العمل بمسؤولية تجاه نطاق واسع من الأطراف\u0026#34;، ليس واجب تبرّع. إنه شيء تقوم به الشركة طوعًا، ومن بين المسؤوليات الثلاث (الامتثال، والاهتمام بالبيئة، والمساهمة في المجتمع والمنطقة المحلية)، التبرع مثال واحد للمساهمة في المجتمع والمنطقة المحلية، لكنه ليس شيئًا يجب فعله دائمًا.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null}},"options":{"852":[{"id":3405,"question_id":852,"subject_id":7,"sort_order":1,"text":"بقالة محلية صغيرة تديرها أسرة","image":null,"video":null},{"id":3406,"question_id":852,"subject_id":7,"sort_order":2,"text":"حافلة تديرها المدينة يستقلّها المواطنون عادةً","image":null,"video":null,"is_correct":true},{"id":3407,"question_id":852,"subject_id":7,"sort_order":3,"text":"سلسلة مطاعم تديرها شركة خاصة كبرى","image":null,"video":null},{"id":3408,"question_id":852,"subject_id":7,"sort_order":4,"text":"كشك عصير ليمون يديره شخص واحد","image":null,"video":null}],"853":[{"id":3409,"question_id":853,"subject_id":7,"sort_order":1,"text":"شركة مساهمة","image":null,"video":null},{"id":3410,"question_id":853,"subject_id":7,"sort_order":2,"text":"شركة ذات مسؤولية محدودة","image":null,"video":null},{"id":3411,"question_id":853,"subject_id":7,"sort_order":3,"text":"شركة تضامن","image":null,"video":null,"is_correct":true},{"id":3412,"question_id":853,"subject_id":7,"sort_order":4,"text":"منشأة عامة","image":null,"video":null}],"854":[{"id":3413,"question_id":854,"subject_id":7,"sort_order":1,"text":"منظمة بنظام يُصدر أسهمًا لجمع أموال من أشخاص كثيرين","image":null,"video":null},{"id":3414,"question_id":854,"subject_id":7,"sort_order":2,"