xt_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:44:06Z"},{"id":20615099,"test_response_id":1372583,"test_question_id":629,"status":"graded","selected_option_id":4402,"answer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:44:06Z"},{"id":20615100,"test_response_id":1372583,"test_question_id":630,"status":"graded","selected_option_id":4405,"answer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:44:06Z"}],"questions":{"1053":{"id":1053,"subject_id":7,"type":"mcq","question_text":"إنه اليوم الأول الذي انتقلت فيه إلى مركز بدء المشاريع. تنضم إلى \u0026#34;لقاء تبادل\u0026#34; يتحدّث فيه السكان عن كيفية تقدّم مشاريعهم الخاصة. بينما يتحدّث الجميع بشغف عن أفكارهم وأفعالهم الحالية، من يُظهر أكثر ريادة الأعمال، حتى دون أن يكون قد بدأ شركة بعد؟","image":null,"video":null,"explanation":"ريادة الأعمال هي عقلية التحرك بنفسك لخلق قيمة جديدة والاستمرار في الابتكار - ليس فعل بناء الشركة بذاته، بل العقلية المتحدية التي وراءه. الخيار B هو بالضبط صورة الانتباه، والصنع، والاختبار، والإصلاح - التحرك بنفسك والاستمرار في الابتكار. الإجابة هي B. الخيار A يختار فقط أساليب آمنة ومضمونة، دون تحدٍّ جديد. الخيار C يحاول التقليد، لا توليد قيمة جديدة. الخيار D لديه معرفة واهتمام وافران لكنه لم يبدأ التحرك بنفسه، فالعقلية لا تظهر في الفعل (ريادة الأعمال التي تظهر \u0026#34;حتى دون أن يكون قد بدأ بعد\u0026#34; لا تظهر في ما تعرفه، بل في صورة التحرك بنفسك والابتكار).","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1054":{"id":1054,"subject_id":7,"type":"mcq","question_text":"بعد أيام قليلة من الانتقال. بالنظر حول المرفق، رواد أعمال يحملون أهدافًا مختلفة يتحرّكون بنشاط. قبل تحديد أي اتجاه يهدف إليه مشروعك الخاص، فلنرتّب أولًا الأنواع الثلاثة النموذجية لبدء المشروع التجاري (الشركة الناشئة، المشروع الصغير، ريادة الأعمال الاجتماعية). أي نوع تنتمي إليه المشاريع ① إلى ③ أدناه؟\n① مشروع يهدف إلى الانتشار في العالم كله دفعة واحدة في وقت قصير، باستخدام تقنية أو أفكار جديدة\n② مشروع كمطعم عائلي، حيث يكون المالك متجذّرًا في المنطقة المحلية ويُقدّر الاستمرار بثبات وطويلًا\n③ مشروع يجعل خلق أماكن عمل في منطقة قليلة أماكن العمل هدفه الأول، ويستخدم الربح المُكتسَب لحل تلك المشكلة الاجتماعية","image":null,"video":null,"explanation":"تنقسم أنواع بدء المشروع التجاري حسب ما تهدف إليه. الهدف إلى النمو الكبير في وقت قصير هو شركة ناشئة، والاستمرار بثبات وطويلًا هو مشروع صغير، وجعل حل مشكلات المجتمع بذاته الهدف الأول بينما يُعامَل الربح كوسيلة لذلك هو ريادة الأعمال الاجتماعية. ① هو النمو الكبير في وقت قصير = شركة ناشئة، ② هو الثبات والطول = مشروع صغير، ③ هو حل المشكلة كهدف = ريادة أعمال اجتماعية. الإجابة هي D.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1055":{"id":1055,"subject_id":7,"type":"mcq","question_text":"بعد أيام قليلة من الانتقال، يسأل مرشد إداري خبير (مستشار) عن فكرتك: \u0026#34;فلنوضّح نقطة انطلاق مشروعك. أي مما يلي يفسّر بأفضل شكل المعنى الأساسي لـ\u0026#39;خلق القيمة\u0026#39;، أساس كل بدء مشروع تجاري؟\u0026#34; أي مما يلي يفسّر خلق القيمة بأفضل شكل؟","image":null,"video":null,"explanation":"\u003cp\u003eخلق القيمة هو إيجاد وحل مشكلة شخص ما أو \u0026#34;كان ليكون من الجيد لو وُجد هذا\u0026#34;، وتوليد فائدة جديدة لم تكن موجودة من قبل. انتباه شخص ما إلى \u0026#34;كان ليكون من الجيد لو وُجد هذا\u0026#34; يصبح نقطة الانطلاق، ويبدأ بدء المشروع التجاري من هنا أيضًا. الإجابة هي A. الخيار B هو تقليد منتج موجود (البيع بسعر رخيص)، الخيار C هو إجراءات التأسيس، الخيار D هو الترويج - لا واحد منها نقطة انطلاق توليد قيمة جديدة بذاتها.\u003c/p\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":"2026-09-09T12:59:43Z"},"1056":{"id":1056,"subject_id":7,"type":"mcq","question_text":"في أيام تنقية الأفكار، تنضم إلى عرض تقديمي لفكرة مشروع تجاري. يقدّم الزملاء جهودهم بشغف. من بين ① إلى ④ أدناه، أي منها هو التركيبة المناسبة لتلك التي تُحسب أمثلة نجاح لـ\u0026#34;الابتكار\u0026#34;؟\n① غيّر حجوزات تمرين الفريق من الكتابة في سجل ورقي إلى آلية غير مسبوقة يمكنك فيها الحصول على موعد شاغر في أي وقت عبر هاتفك، مزيلًا المشكلة لكثير من الناس\n② ابتكر منافسة سعرية بتخزين مشروب موجود بالجملة وبيعه أرخص قليلًا من المحل المجاور\n③ يبحث عن مادة تزيل الأوساخ بشكل أفضل، طالبًا مواد مختلفة ومكرّرًا النمذجة والتجارب كل يوم في مختبره الخاص\n④ لمساعدة تنقّل كبار السن للتسوق، صنع آلية مشاركة تنقّل غير مسبوقة تربط المقاعد الشاغرة في سيارات الحي عبر تطبيق وتقديم توصيلات بمقابل صغير","image":null,"video":null,"explanation":"الابتكار هو قيمة لم تكن موجودة من قبل تصل فعليًا إلى الناس، من خلال ليس فقط منتجات جديدة بل طرقًا وآليات جديدة أيضًا. ① غيّر آلية الحجز لإزالة المشكلة لكثير من الناس، و④ ولّد آلية جديدة لمساعدة أشخاص منزعجين من التنقّل - كل واحد يولّدها فعليًا. الإجابة هي C. ② هو تخفيض سعر لمنتج موجود، لا يولّد قيمة جديدة. ③ لا يزال في مرحلة النمذجة والتجربة والخطأ، دون أن تصل القيمة فعليًا إلى الناس بعد.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1057":{"id":1057,"subject_id":7,"type":"mcq","question_text":"تعلمت من مرشد أن \u0026#34;عرض القيمة الجيد يصل بنظرة واحدة: لمن هو، وما المشكلة التي يحلها، وما القوة الفريدة التي تستخدمها لحلها.\u0026#34; أولًا، كتبت عرض قيمة يستهدف زملاء المركز (العملاء) على السبورة المشتركة للمركز هكذا.\nأي مما يلي يحدّد بأفضل شكل \u0026#34;الجمهور المستهدف\u0026#34;، و\u0026#34;المشكلة\u0026#34;، و\u0026#34;القوة الفريدة\u0026#34; المُعبَّر عنها في هذه العبارة؟\n\u0026#34;بعد النادي أو التمرين، حتى دون ماء، تنظف الأحذية المُغطّاة بالطين في دقائق قليلة. قابلة للاستخدام في لمح البصر حتى بين التنقّلات!\u0026#34;","image":null,"video":null,"explanation":"عرض القيمة يلخّص، في كلمات تصل فورًا إلى الطرف الآخر: لمن هو، وما المشكلة التي يحلها، وما القوة الفريدة التي يستخدمها لحلها. من هذا السطر الواحد، يمكنك قراءة: لمن = أشخاص تتغطّى أحذية كرة القدم لديهم بالطين بعد التمرين، ما المشكلة = لا يوجد مصدر ماء قريب ولا يمكنهم تنظيفها فورًا في الموقع، ما القوة الفريدة = إزالة الأوساخ في دقائق قليلة دون ماء، حتى بين التنقّلات. الثلاثة كلها تتطابق مع المحتوى، فالإجابة هي D. الخيار A لأشخاص يريدون العناية بعناية بالأحذية الجلدية، ولا الطرف ولا قوة \u0026#34;التلميع الشامل\u0026#34; تتطابق مع السطر. الخيار B يوسّع الهدف كثيرًا إلى \u0026#34;أي شخص على الإطلاق\u0026#34; ويؤكد على الاستخدام الشامل، دون أن يصبح عرض قيمة يحل مشكلة محددة. الخيار C يتجه نحو خلق الضجة، بعيدًا عن المشكلة والقوة الفعليتين المُعبَّر عنهما في الجملة الواحدة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1058":{"id":1058,"subject_id":7,"type":"mcq","question_text":"بعد إنهاء عرض الفكرة، تُظهر للمرشد (المستشار) صورة النموذج الأولي لـ\u0026#34;سلع العناية بحذاء كرة القدم\u0026#34; التي كنت ترعاها. يقول المرشد: \u0026#34;فكرة مثيرة للاهتمام. من هنا، \u0026#39;المخاطرة المحسوبة\u0026#39; التي تحافظ على الفشل صغيرًا مهمة.\u0026#34; عند تطوير المشروع مع تقليل خطر الفشل بأقصى قدر ممكن، أي مما يلي هو الفعل الأكثر ملاءمة كـ\u0026#34;مخاطرة محسوبة\u0026#34;؟","image":null,"video":null,"explanation":"المخاطرة المحسوبة هي التحدي ضمن نطاق يمكن التحكم فيه بتصوّر واضح، مع توقّع أنه قد لا ينجح. الخيار B يصنع كمية صغيرة فقط ويتأكد بالرد المؤكد لهل هناك من يدفع فعلًا للشراء، خاطيًا خطوة ضمن نطاق يمكن التحكم فيه. الإجابة هي B. الخيار A يعتمد فقط على كلمات \u0026#34;أريده\u0026#34; في الاستبيان، دون التأكد من هل سيشترون فعلًا. الخيار C يصنع كمية كبيرة من البداية ويراهن بشدة دفعة واحدة. الخيار D يقضي وقتًا في رفع الاكتمال دون التأكد من وجود مشترين، محاولًا المضي قدمًا دون التأكد برد مؤكد.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1059":{"id":1059,"subject_id":7,"type":"mcq","question_text":"إنها مرحلة قبل الصنع بجدية. تبدأ بفتح الشاشة لطلب مواد بالجملة، ثم توقف يدك. لعدم الانزعاج بصنع الكثير هدرًا، تتأكد أولًا من وجود أشخاص يريدونه فعلًا. كـ\u0026#34;دراسة سوق\u0026#34;، أي مما يلي هو الفعل الأكثر ملاءمة؟","image":null,"video":null,"explanation":"دراسة السوق هي التأكد من وجود أشخاص يريدونه فعلًا، قبل صنع أي شيء، بالسؤال المباشر عن أو مراقبة تجربة الطرف الآخر وسلوكه الفعلي. الخيار D يسأل الهدف الفعلي مباشرة (زملاء الرياضة وطلاب النادي) عن تجربتهم ومشكلاتهم المعتادة. الإجابة هي D. الخيار A هو انطباعات العائلة، لا أصوات عملاء حقيقيين. الخيار B هو خطأ ترتيب العمليات بتحضير المواد قبل التأكد. الخيار C يعتمد ليس على قبل الصنع بل على الرد بعد التقديم.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1060":{"id":1060,"subject_id":7,"type":"mcq","question_text":"بعد التأكد من وجود أشخاص يريدونه، حول وقت محاولة التقدّم إلى الخطوة القادمة، يصرخ مرشد المركز، \u0026#34;أولًا من المنتج الأولي القابل للتطبيق.\u0026#34; أي مما يلي يفسّر المنتج الأولي القابل للتطبيق بأفضل شكل؟","image":null,"video":null,"explanation":"المنتج الأولي القابل للتطبيق هو منتج أو خدمة تجريبية مُضيَّقة إلى النقطة الأهم فقط. بدلًا من الهدف إلى الكمال من البداية، تختبر بشكل صغير وسريع، وتصلح خلال مراقبة ردود من استخدمه. الإجابة هي A. الخيار B هو نهج حشو كل الميزات ورفع الاكتمال قبل الإطلاق - عكس المنتج الأولي القابل للتطبيق. الخيار C نشاط ترويجي، الخيار D بحث قبل بدء التطوير (دراسة سوق) - لا واحد منهما هو المنتج الأولي القابل للتطبيق بذاته.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1061":{"id":1061,"subject_id":7,"type":"mcq","question_text":"بدأت الأفعال اللازمة لبدء مشروع تجاري تصبح واضحة تدريجيًا. مع زملاء دفعة المركز، بلصق ملاحظات لاصقة على السبورة الجدارية، تناقشون الخطة القادمة. من بين ① إلى ④ أدناه، من منظور التقدّم مع التأكد من الفكرة، أي مما يلي يرتّب بشكل صحيح فقط الخطوات اللازمة للمضي قدمًا بثبات مع خطر قليل، بالترتيب الصحيح؟\n① [منتج أولي قابل للتطبيق] صنع كمية صغيرة فقط من السلع والاختبار\n② [دراسة السوق] سؤال من يتمرّنون مباشرة عن مشكلات العناية لديهم\n③ [عرض القيمة] تلخيص قوة \u0026#34;التنظيف دون ماء\u0026#34;\n④ [إجراءات التأسيس] تقديم الوثائق اللازمة للافتتاح إلى المكتب الحكومي","image":null,"video":null,"explanation":"خطوات التسويق التجاري هي تدفّق الانتباه إلى المشكلة (خلق القيمة) ← عرض القيمة ← دراسة السوق ← اختبار صغير بمنتج أولي قابل للتطبيق. أولًا، بـ③ عرض القيمة، تلخّص لمن تقدّم قوة \u0026#34;التنظيف دون ماء\u0026#34;؛ بعد ذلك، بـ② دراسة السوق، تتأكد من وجود أشخاص يريدونه فعلًا؛ ثم، بـ① منتج أولي قابل للتطبيق، تصنع كمية صغيرة فقط وتختبر بشكل صغير. لاحظ أن ③ عرض القيمة و② دراسة السوق غالبًا، في الممارسة، يتقدّمان ذهابًا وعودة - \u0026#34;تحديد عرض قيمة مؤقت أولًا، إجراء دراسة سوق بتلك الفرضية، وتلميع عرض القيمة بما يعكس النتائج\u0026#34; - لكن هنا يُفهَم بترتيب تلخيص عرض قيمة مؤقت أولًا عن لمن وبأي قوة تقدّم، ثم الذهاب للتأكد. ④ إجراءات التأسيس (وثائق للمكتب الحكومي) لها مشاهد تُحتاج فيها عند الافتتاح، لكنها لا تدخل في هذا التدفّق للتقدّم بثبات مع التأكد من الفكرة. الخطوات اللازمة هي الثلاثة ③②①، والترتيب الصحيح هو B. الإجابة هي B. الخيار A يفعل المنتج الأولي القابل للتطبيق أولًا، مقلّبًا الترتيب؛ الخيار C يضع ④ أخيرًا، متخطّيًا تأكيد ①؛ الخيار D يبدأ من ④ - لا واحد منها مناسب.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1062":{"id":1062,"subject_id":7,"type":"mcq","question_text":"في يوم أثناء تطوير التحضيرات، يحكي رواد أعمال كبار بدؤوا مشاريع من قبل \u0026#34;قصص فشل\u0026#34; عن اقترابهم من الإفلاس في الماضي. أي من المخاطر الثلاثة لبدء المشروع التجاري (الخطر المالي، خطر المنافسة، خطر السوق) تنتمي إليه كل من ① إلى ③ أدناه؟\n① الكبير أ: بعد نصف عام من الافتتاح، كان الإيراد ينمو بثبات، لكن الدفعات تراكمت على مدى بضعة أشهر، وكانت هناك إمكانية عدم القدرة على دفع تكلفة التخزين\n② الكبير ب: صنع وباع سلعًا أصلية معيّنة، لكن منتجات بتصميم مشابه كانت مُتداوَلة على نطاق واسع بالفعل، وانطمرت منتجاته الخاصة\n③ الكبير ج: عقد ورشة عمل واكتمل عدد المشاركين، لكن كثيرًا من المشاركين قالوا \u0026#34;فعاليات كهذه شائعة بالقرب، ويجب أن تكون أرخص لنا لنأتي المرة القادمة\u0026#34;","image":null,"video":null,"explanation":"الخطر المالي هو نفاد المال المتوفر، خطر المنافسة هو أن يُختار الطرف الذي يقدّم أشياء مشابهة بدلًا منك، خطر السوق هو عدد أقل من المتوقع من الأشخاص الذين يريدونه. ① هو تكلفة التطوير التي تستهلك المال ونفاد النقد = تمويل، ② هو دخول لاعب كبير بمنتج مشابه وأخذ العملاء = منافسة، ③ هو عدد قليل من الناس يريدونه بعد تقديمه = سوق. الإجابة هي D.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1063":{"id":1063,"subject_id":7,"type":"mcq","question_text":"في تشكيل سلع النموذج الأولي، تقرر القيام بـ\u0026#34;إدارة الخطر المالي\u0026#34; بشكل شامل بحيث تستطيع الحفاظ على أموال الافتتاح حتى قليلًا. باستخدام بيئة مركز بدء المشاريع، أي طريقة للمضي قدمًا تتيح لك صنع النموذج الأولي بينما تترك المال بأذكى شكل؟","image":null,"video":null,"explanation":"إدارة الخطر ليست جعل الخطر صفرًا، بل الخروج ضمن نطاق يمكن التحكم فيه. تحمي الأموال بوسائل كالاختبار بشكل صغير، والحفاظ على احتياطي مسبقًا، واستعارة قوة من حولك. الخيار B يستخدم معدات المركز المشتركة بسعر رخيص ويختبر بشكل صغير ضمن ميزانية يمكن التحكم فيها، مُحدِّدًا الخطر المالي باستخدام الآلية المحيطة. الإجابة هي B. الخيار A يجمع معدات غالية بشكل فردي، متجاوزًا نطاقًا يمكن التحكم فيه. الخيار C يتجنّب فقط إنفاق المال ولم يخطُ خطوة على الإطلاق. الخيار D يحمله بمفرده دون استخدام الدعم المحيط.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1064":{"id":1064,"subject_id":7,"type":"mcq","question_text":"أثناء تطوير التحضيرات، يخبرك كبير في المركز، \u0026#34;مشروع خارجي عبر الإنترنت بدأ ببيع سلع عناية بحذاء كرة القدم تمامًا كفكرتك.\u0026#34; فبحيث، عندما يخرج الأمر أخيرًا إلى العالم، تُختار سلعك بدلًا من سلع المنافس، تخطط لإجراءات مقابلة الآن. كطريقة مواجهة هذا \u0026#34;خطر المنافسة\u0026#34;، أي مما يلي هو الاستراتيجية الأكثر ملاءمة؟","image":null,"video":null,"explanation":"خطر المنافسة هو أن يُختار الطرف الذي يقدّم شيئًا مشابهًا لسلعتك بدلًا منك. كطريقة مواجهته، حسّن قوتك الفريدة الخاصة (الجودة الفريدة) واجعل سبب اختيار العملاء لك واضحًا. الإجابة هي A. الخيار B يخفّض السعر فقط دون إظهار قوتك الفريدة الخاصة، وحرب الأسعار غالبًا تُنهك الطرفين فقط. الخيار C يترك المشروع قبل النظر في تحسين القوة. الخيار D يراقب فقط، دون خلق سبب للاختيار.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1065":{"id":1065,"subject_id":7,"type":"mcq","question_text":"أصبحت نقاط التمييز التي لن تخسر أمام المنافسين واضحة. تستشير المرشد: \u0026#34;أريد اختبار النموذج الأولي ليس فقط مع زملاء المركز بل مع فرق كرة قدم محلية. أريد أيضًا جمع أموال تطوير حقيقية.\u0026#34; يقول المرشد، \u0026#34;من هنا فصاعدًا، هذه مرحلة استخدام \u0026#39;منظومة الشركات الناشئة (آلية المجتمع الداعمة لبدء المشاريع)\u0026#39; المنتشرة خارج المركز أيضًا.\u0026#34; أي طريقة للمضي قدمًا تستخدم هذه المنظومة بأفضل شكل؟","image":null,"video":null,"explanation":"المنظومة آلية تداول يتشارك فيها رواد أعمال كبار، وداعمون، وزملاء، وحكومة، ومدارس، وما شابه، الحكمة والموارد (الأموال، الأماكن) مع بعضهم، ويدعمون تحديات جديدة عبر المنطقة كلها. الخيار C يتواصل مع دعم متعدد - الحكومة (إعانات)، الجامعة (تقنية)، الفريق الإقليمي (مكان للاختبار) - مُطوِّرًا المشروع باستخدام المنظومة. الإجابة هي C. الخيار A ينغلق على روابط شخص واحد، دون التواصل مع دعم التمويل أو الأماكن. الخيار B يستلم التشجيع فقط، الخيار D يقلّد طريقة شخص آخر بالكامل - لا واحد منهما يستخدم دعمًا مُركَّبًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1066":{"id":1066,"subject_id":7,"type":"mcq","question_text":"تواصلت مع \u0026#34;المنظومة\u0026#34; - مكاتب الإعانات الحكومية والفرق الرياضية الإقليمية. لتُدعَم رسميًا وتُشرِك المنطقة كلها، تلخّص \u0026#34;الأهمية الاجتماعية\u0026#34; لمشروعك في عرض تقديمي. أي مما يلي هو التركيبة الصحيحة لـ\u0026#34;الأهميات الكبرى الثلاث التي يجلبها بدء المشروع التجاري للمجتمع بأكمله\u0026#34;، بعيدًا عن ربحك الخاص فقط؟","image":null,"video":null,"explanation":"الأهمية الاجتماعية لبدء المشروع التجاري هي المعنى الذي يحمله للعالم بأكمله بعيدًا عن الشخص الواحد الذي بدأه: التوظيف (توظيف الناس لخلق أماكن عمل)، والابتكار (نشر قيمة جديدة)، وحل المشكلات (تقليل مشكلات العالم) - هذه الثلاثة. الإجابة هي B. A و C و D - الربح، والتعرّف بالاسم، والرخص، ومعيشتك الخاصة - تبدو كلها أشياء جيدة، لكنها قيمة لك أو لمشروعك، لا معنى ينتشر إلى المجتمع بأكمله.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1067":{"id":1067,"subject_id":7,"type":"mcq","question_text":"مع عرض تقديمي يلخّص الأهمية الاجتماعية في يدك، تقف في \u0026#34;عرض النموذج الأولي\u0026#34; الذي يستضيفه المركز. أمام مدرّبي فرق كرة قدم إقليمية مدعوّين، أنجزت عرض وتجربة سلع حذاء كرة القدم. لكن بعد ذلك، يقدّم مدرّب ملاحظات: \u0026#34;فكرة إزالة الطين دون ماء هي الأفضل. لكن بهذا الحجم والاستخدام كما هو، من الصعب نوعًا ما التعامل معه في ملعب مُغطّى بالطين.\u0026#34; كرائد أعمال، أي مما يلي هو الطريقة الأكثر ملاءمة لمواجهة هذه \u0026#34;المشكلة الجديدة\u0026#34; التي طُرحت عليك بالضبط لأنك طبّقت الأمر عمليًا؟","image":null,"video":null,"explanation":"مشكلة جديدة تُطرح عليك فقط بعد تطبيق الأمر عمليًا تصبح دليلًا قيّمًا لتحسين المنتج. رائد الأعمال يقبلها، ويتأكد منها، ويربطها بالتحسين القادم ضمن نطاق يمكن التحكم فيه. الإجابة هي C. الخيار C يأخذ الملاحظة كبيانات، ويسأل الآخر بالتفصيل، ويستخدمها للنموذج الأولي القادم. الخيار A يتفانى في النشر وفق الخطة الأصلية، الخيار B يوقف التطوير، الخيار D يبني بمفرده - لا واحد منها يربط المشكلة المكتشفة بالتحسين القادم.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1068":{"id":1068,"subject_id":7,"type":"mcq","question_text":"بناءً على ملاحظة المدرّب، تبدأ في تحسين شكل السلعة وقابلية استخدامها. يدعوك المرشد: \u0026#34;بعيدًا عن إصلاح تفاصيل المنتج، فلنحدّث معًا أيضًا آلية المشروع بأكملها (نموذج العمل) لـ\u0026#39;لمن، وماذا، وكيفية التوصيل، وكيفية توليد الإيراد،\u0026#39;\u0026#34; وتنضم إلى \u0026#34;ورشة تصميم نموذج العمل\u0026#34; في المركز. قبل الانضمام إلى الورشة، تفكّر في تلخيص أفكارك داخل نفسك مسبقًا. أي مما يلي هو الطريقة الأفضل لتجميع آلية مشروعك مسبقًا؟","image":null,"video":null,"explanation":"تصميم آلية المشروع (نموذج العمل) ليس شيئًا يُصنَع مثاليًا دفعة واحدة - إنه يُجمَّع بناءً على الردود التي تأكدت منها، ويُصلَح خلال الاختبار. الإجابة هي B. الخيار A يُعطي الأولوية لمثالك الخاص ويحاول تشكيل كل شيء دفعة واحدة من البداية؛ الخيار D يحاول تحديد كل تفصيلة بشكل مثالي من التوقع المستقبلي، مُفوِّتًا فرضية الإصلاح خلال الاختبار؛ الخيار C يُعطي الأولوية ويصبّ الجهد في التصميم في نفس وقت التفكير في الآلية - لا واحد منها يمثل الشكل \u0026#34;الترتيب خلال الاختبار بناءً على الردود المؤكدة\u0026#34;.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1069":{"id":1069,"subject_id":7,"type":"mcq","question_text":"بدأت \u0026#34;ورشة تصميم نموذج العمل\u0026#34; بجدية. يقف المدرّب أمام السبورة ويسأل، \u0026#34;قبل تعبئة الورقة، فلنتأكد أولًا من الأساسيات معًا. ما هو \u0026#39;نموذج العمل\u0026#39; الذي نحن على وشك تصميمه بالضبط؟\u0026#34; أي مما يلي يفسّر نموذج العمل (آلية المشروع) بأفضل شكل؟","image":null,"video":null,"explanation":"نموذج العمل هو الآلية الكاملة لتوليد المال. أي مشروع، إذا تتبّعته إلى الجوهر، يجيب عن الأسئلة الأربعة \u0026#34;لمن، وماذا، وكيفية التوصيل، وكيفية توليد الإيراد.\u0026#34; الإجابة هي A. الخيار B هو خطوات الصنع، الخيار C خطة الترويج، الخيار D ترتيب التأسيس - كل واحد جزء من المشروع، لكن لا واحد منها يعبّر عن الآلية الكاملة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1070":{"id":1070,"subject_id":7,"type":"mcq","question_text":"انتهى محاضرة الورشة، وحان وقت العمل الفردي. على ورقة تصميمك، ترتّب بشكل صحيح الملاحظات اللاصقة الأربع (① إلى ④) مع فكرة مشروع منظّف حذاء كرة القدم في المجالات الأربعة \u0026#34;لمن، وماذا، وكيفية التوصيل، وكيفية توليد الإيراد.\u0026#34; أي مما يلي هو التركيبة الصحيحة لمنطقة الورقة والملاحظة اللاصقة؟\n① نقطة تواصل يمكنهم فيها استلامه فعليًا، كمحل أو موقع فعالية\n② أشخاص منزعجون من اتساخ حذاء كرة القدم بعد التمرين\n③ وسيلة للاستمرار في توليد المال بشكل مستمر بالشراء بالجملة أو المجموعات، دون الاعتماد على الدفع بالقطعة الواحدة فقط\n④ فائدة القدرة على التنظيف بسرعة دون ماء","image":null,"video":null,"explanation":"لمن هو الطرف الذي يحمل المشكلة، \u0026#34;ماذا\u0026#34; هي القيمة المُقدَّمة، \u0026#34;كيفية التوصيل\u0026#34; هي نقطة التواصل/طريقة تقديم القيمة، \u0026#34;كيفية توليد الإيراد\u0026#34; هي وسيلة توليد المال المستمر. ① نقطة تواصل يستلمونه فيها في موقع = كيفية التوصيل، ② أشخاص منزعجون من الاتساخ = لمن، ③ وسيلة للاستمرار في توليد المال بالشراء بالجملة أو المجموعات = كيفية توليد الإيراد، ④ فائدة التنظيف دون ماء = ماذا. الإجابة هي C.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1071":{"id":1071,"subject_id":7,"type":"mcq","question_text":"يتقدّم العمل الفردي في الورشة، وتُظهر أوراق التصميم لبعضكما مع الزميل في المقعد المجاور. يشرح الزميل فكرته: \u0026#34;للأشخاص الذين يحبون الفن، أريد صنع بطاقات بريدية بتصميم خاص ووضعها في محلات محلية أنيقة بحيث يستلمها الناس.\u0026#34; من بين الأسئلة الأربعة لنموذج العمل، أي عنصر لا يزال غير واضح في هذا التفسير؟","image":null,"video":null,"explanation":"نموذج العمل يعمل للمرة الأولى عندما تكون الأربعة \u0026#34;لمن، وماذا، وكيفية التوصيل، وكيفية توليد الإيراد\u0026#34; موجودة كلها. في هذا التفسير، لمن (أشخاص يحبون الفن)، وماذا (بطاقات بريدية بتصميم خاص)، وكيفية التوصيل (نقطة تواصل بوضعها في محلات محلية أنيقة لاستلامها) واضحة، لكن كيفية توليد الإيراد (بأي مقدار تبيع، ووسيلة الاستمرار في توليد المال) غير واضحة. الإجابة هي B.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1072":{"id":1072,"subject_id":7,"type":"mcq","question_text":"في الورشة، يجلب زميل من مجموعة أخرى ورقة تصميمه: \u0026#34;عبّأت العناصر الأربعة كلها، لكن المرشد أخبرني أن هناك تناقضًا كبيرًا. هل يمكنك تحديد أين المشكلة؟\u0026#34; أي عنصر من نموذج العمل لا يتلاءم مع وضع العميل المستهدف؟\nمشروع يبيع لوازم يومية أساسية تُستخدَم في الحياة اليومية، لأشخاص لديهم أطفال صغار ولا يمكنهم الخروج للتسوق بسهولة. يُستلَم الدفع فقط بمقدار المنتجات المُباعة، ويأتون إلى المحل ويختارون ويشترون بأنفسهم.","image":null,"video":null,"explanation":"الأسئلة الأربعة لا تحتاج فقط إلى أن تكون موجودة بل إلى أن تتلاءم مع بعضها. رغم استهداف أشخاص لا يمكنهم الخروج للتسوق، طريقة التوصيل بجعلهم يأتون إلى المحل ويختارون ويشترون بأنفسهم تعني أن هؤلاء الأشخاص لا يمكنهم المجيء للشراء - لا تتلاءم مع وضع الطرف. الإجابة هي D. لمن، وماذا، وكيفية توليد الإيراد متوافقة في اتجاه اللوازم اليومية التي يحتاجها أشخاص يجدون صعوبة في الخروج.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1073":{"id":1073,"subject_id":7,"type":"mcq","question_text":"إنه النصف الثاني من الورشة. يقول المدرّب، \u0026#34;لتصميم \u0026#39;كيفية توليد الإيراد\u0026#39; في الورقة، فلنفهم أولًا الأنواع الأربعة النموذجية في العالم (نماذج الإيراد)،\u0026#34; ويعرض حالات فعلية (① إلى ④) لكبار المركز. أي مما يلي هو التركيبة الصحيحة للأنواع المُلائمة لكل حالة؟\n① بيع سلع عناية مريحة طوّرها واحدة تلو الأخرى في المحلات أو عبر الإنترنت واستلام الدفع\n② دفع رسم شهري يجعل معدات ورشة المركز الغالية قابلة للاستخدام في أي وقت لشهر، دون حدود\n③ تشغيل موقع مطابقة يربط أشخاصًا يريدون البيع وأشخاصًا يريدون الشراء، واستلام رسم بنسبة قليلة في كل مرة تتم فيها معاملة\n④ توزيع تطبيق صور عالي الوظائف يمكن لأي شخص استخدامه مجانًا، وتقديم خطة مدفوعة أيضًا فقط لمن يريدون تحريرًا متقدمًا، للكسب","image":null,"video":null,"explanation":"① يصنع أشياء ويبيعها واحدة تلو الأخرى، مستلمًا الدفع = نموذج الدفع لمرة واحدة؛ ② استخدام غير محدود بينما يدفع مبلغًا محددًا بشكل مستمر = نموذج الاشتراك؛ ③ يربط البائع والمشتري ويستلم رسمًا لكل معاملة = نموذج المنصة؛ ④ مجاني أساسًا مع تقديم مدفوع فقط لبعضهم = نموذج فريميوم. الإجابة هي B. الخيارات A و C و D تُبدّل بعض الأنواع، وهذا خطأ.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1074":{"id":1074,"subject_id":7,"type":"mcq","question_text":"من بين نماذج الإيراد، هناك آلية رائعة يمكنها الحفاظ على استمرار مشروع حتى دون استلام تكاليف أولية من المستخدمين. لتحويل \u0026#34;تطبيق خرائط يمكن لأي شخص استخدامه مجانًا\u0026#34; طوّره أحد كبار المركز إلى آلية تستمر في توليد المال، أي مما يلي هو التصميم الأكثر ملاءمة؟","image":null,"video":null,"explanation":"حتى خدمة تُستخدَم مجانًا لها آلية للاستمرار في توليد المال. تجمع المستخدمين بجعل كثير من الناس يستخدمونها، وتستمر في الكسب بجعلهم يرون إعلانات أو جعل بعضهم يستخدم ميزات أكثر راحة برسم. هذه طريقة تفكير نموذج الإعلانات أو فريميوم، والإجابة هي C. بيع التطبيق لمرة واحدة في A لا يصبح آلية تستمر في التوليد. B يعتمد فقط على التبرعات، D فقط على الإعانات - كلاهما صعب الاستمرار.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1075":{"id":1075,"subject_id":7,"type":"mcq","question_text":"في الورشة، ظهرت آلية \u0026#34;الامتياز التجاري\u0026#34; أيضًا. أي مما يلي يصف بأفضل شكل الامتياز التجاري؟","image":null,"video":null,"explanation":"نموذج الامتياز التجاري يمنح حق استخدام اسم مشروع ناجح وأساليب إدارته مُجمَّعة معًا لأشخاص يريدون فتح محلات. بما أن الطرف الحاصل على الامتياز يفتح محلًا باستخدام تلك الآلية، القوة هي النشر على نطاق واسع بسرعة لا يمكن تحقيقها بمفردك، مع الحفاظ على الجودة موحّدة. الإجابة هي B. الخيار A يبقى عند محل واحد، مفوّتًا قوة النشر؛ الخيار C، بسياسات مختلفة لكل محل، لا يمكنه الحفاظ على الجودة موحّدة؛ الخيار D خطأ لأنك لا تستلم كل إيراد المحلات الأعضاء - كل محل عضو يدير مشروعه الخاص وأنت تستلم مقابلًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1076":{"id":1076,"subject_id":7,"type":"mcq","question_text":"ورشة تصميم نموذج العمل في مرحلتها الأخيرة. بناءً على نماذج الإيراد المختلفة التي تعلمتها، تحدد طريقة استلام مشروعك للدفع. أولًا، تبدأ من شكل \u0026#34;تقديم منظّف حذاء كرة القدم المكتمل للعملاء كمنتج نهائي واستلام الدفع مقابله.\u0026#34; كنوع نموذج العمل الذي تتناسب معه طريقة البيع هذه أكثر، أي مما يلي هو؟","image":null,"video":null,"explanation":"ما تفكّر فيه هو شكل تقديم السلعة المكتملة كمنتج نهائي واستلام الدفع. هذا يتناسب مع نموذج الدفع لمرة واحدة، الذي يصنع ويقدّم شيئًا ويستلم الدفع. الإجابة هي D. الخيار A لا يحمل شيئًا لبيعه ويربط العملاء ببعضهم. الخيار B يوزّع المنتجات مجانًا ويستلم دفعًا إضافيًا من بعضهم. الخيار C يمنح حق استخدام آلية لنشر المشروع. لا الخيار B ولا C يتناسب مع شكل بيع السلع نفسها.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1077":{"id":1077,"subject_id":7,"type":"mcq","question_text":"تم تحديد أساس نموذج الإيراد كـ\u0026#34;نموذج الدفع لمرة واحدة.\u0026#34; لجعل الإيراد أكثر استقرارًا، تفكّر في \u0026#34;وسيلة واحدة أخرى\u0026#34; بدمج نوع آخر على هذا الأساس. كطريقة رفع الإيراد الأكثر تلاؤمًا طبيعيًا مع خاصية المنتج بأن \u0026#34;منظّف حذاء كرة القدم ينفد بعد استخدامات قليلة،\u0026#34; أي مما يلي هو؟","image":null,"video":null,"explanation":"منظّف حذاء كرة القدم منتج استهلاكي ينفد مع الاستخدام، وبعد نفاده، سيشترون مرة أخرى. فدمج الإيراد المتكرر (التوصيل المنتظم) - التوصيل بانتظام وجعلهم يستمرون في استخدامه - يتلاءم بأكثر طبيعية مع المشروع الحالي. الإجابة هي A. الخيار B مجموعة غالية لمرة واحدة، دون الاستفادة من قوة إعادة الشراء للمنتج الاستهلاكي. الخيار C يضيف آلية استلام سلع آخرين، مُشوِّشًا التركيز عن مشروع بيع المنتج نفسه. الخيار D، وضع إعلانات على منتج صغير، ليس واقعيًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1078":{"id":1078,"subject_id":7,"type":"mcq","question_text":"تم تحديد \u0026#34;نموذج الإيراد\u0026#34; الخاص بك، فمن هنا تصمّم بشكل ملموس تدفّق مال المشروع. في عالم الأعمال، تُسمّى هذه طريقة دخول المال \u0026#34;تدفّق الإيراد.\u0026#34; أي مما يلي يفسّر تدفّق الإيراد بأفضل شكل؟","image":null,"video":null,"explanation":"تدفّق الإيراد هو طريقة تحقيق الإيرادات - بأي شكل تستلم المقابل (المال) للقيمة المُقدَّمة. هناك نموذج الدفع لمرة واحدة الذي يستلم في كل مرة تبيع، ونموذج الإيراد المتكرر الذي يجعلهم يستمرون في الاستخدام، ونموذج العمولة الذي يربط المعاملات ويستلم. الإجابة هي B. الخيار A هو تحديد السعر، الخيار C الترويج، الخيار D تكلفة جمع العملاء (CAC) - لا واحد منها تدفّق الإيراد بذاته.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1079":{"id":1079,"subject_id":7,"type":"mcq","question_text":"لتصميم تدفّق الإيراد (طريقة تحقيق الإيرادات) بشكل ملموس، ترتّب ميزات الأنواع الثلاثة النموذجية (نموذج الدفع لمرة واحدة، نموذج العمولة، نموذج الإيراد المتكرر). أي مما يلي هو التركيبة الصحيحة لـ① إلى ③ والنوع المُلائم؟\n① بيع منتجات مصنوعة واحدة تلو الأخرى واستلام ذلك الدفع في الموقع\n② الوساطة بين أشخاص يريدون طلب خدمة وأشخاص يريدون تقديمها، واستلام جزء من مقدار المعاملة في كل مرة تُقرَّر معاملة\n③ استلام رسم محدد (مبلغ ثابت) كل شهر، وجعل مساحة معيّنة قابلة للاستخدام في أي وقت، بأي قدر تريد","image":null,"video":null,"explanation":"نموذج الدفع لمرة واحدة يستلم الدفع في كل مرة تبيع، نموذج العمولة يربط المعاملات ويستلم جزءًا من مقدار المعاملة، نموذج الإيراد المتكرر يجعلهم يستمرون في الاستخدام ويستلم بانتظام. ① بيع منتجات واحدة تلو الأخرى واستلام في الموقع = نموذج الدفع لمرة واحدة. ② الوساطة بين طالبي الخدمة ومقدّميها واستلام جزء من مقدار المعاملة = نموذج العمولة. ③ جعلهم يستمرون في الاستخدام برسم شهري محدد = نموذج الإيراد المتكرر. الإجابة هي D.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1080":{"id":1080,"subject_id":7,"type":"mcq","question_text":"تم تحديد نموذج الإيراد (نموذج الدفع لمرة واحدة)، فبعد ذلك تتأكد من كم من الربح يبقى في اليد في كل مرة تبيع فيها منظّف حذاء كرة قدم واحدًا. بناءً على أرقام هذا الجدول، كم من الربح يبقى في كل مرة يُباع واحد؟","image":"image_4_16_2_ar.png","video":null,"explanation":"الربح لكل منتج في كل مرة يُباع واحد يُوجَد بطرح التكلفة المتغيرة لذلك المنتج الواحد (تكلفة المواد وتكلفة الحاوية/التغليف) من سعر البيع. ٢٠٠ − (٨٠ + ٤٠) = ٨٠ جنيهًا. هذا هو الربح المتبقي في كل مرة يُباع، والإجابة هي A.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1081":{"id":1081,"subject_id":7,"type":"mcq","question_text":"بما أن منظّف حذاء كرة القدم \u0026#34;منتج استهلاكي\u0026#34; ينفد مع الاستخدام، إذا أحبّه، يشتري نفس العميل مرارًا وتكرارًا. تُقدّر إجمالي الربح الذي يجلبه عميل واحد بين أول شراء له وحين يتوقف عن الشراء - أي \u0026#34;القيمة الدائمة للعميل (LTV).\u0026#34; بناءً على أرقام هذا الجدول، ما هي القيمة الدائمة للعميل لكل عميل؟","image":"image_4_16_3_ar.png","video":null,"explanation":"القيمة الدائمة للعميل (LTV) هي إجمالي الربح الذي يجلبه عميل واحد بين أول شراء له وحين يتوقف عن الشراء. الربح لكل منتج ٨٠ جنيهًا × متوسط ٧ مرات = ٥٦٠ جنيهًا. الإجابة هي A.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1082":{"id":1082,"subject_id":7,"type":"mcq","question_text":"تُقدّر كم من التكلفة يتطلبه جمع عميل واحد جديد. في عالم الأعمال، تُسمّى هذه تكلفة اكتساب عميل واحد \u0026#34;تكلفة اكتساب العميل (CAC).\u0026#34; بناءً على أرقام هذا الجدول، ما هي تكلفة اكتساب العميل لكل شخص؟","image":"image_4_16_4_ar.png","video":null,"explanation":"تكلفة اكتساب العميل (CAC) تُوجَد بقسمة إجمالي التكلفة المُنفَقة على جمع العملاء على عدد من جُمِعوا. إجمالي التكلفة هو الإعلانات ٣٬٥٠٠ + المنشورات ١٬٥٠٠ = ٥٬٠٠٠ جنيه. ٥٬٠٠٠ / ٥٠ شخصًا = ١٠٠ جنيهًا. الإجابة هي C.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1083":{"id":1083,"subject_id":7,"type":"mcq","question_text":"من الحسابات حتى الآن، واضح أن إجمالي الربح الذي يجلبه عميل واحد (LTV) يتجاوز بشدة تكلفة اكتساب ذلك الواحد (CAC). تحكم على هل من المقبول إنفاق مال لزيادة العملاء لهذا المشروع. أي مما يلي يصف بأفضل شكل الحالة الراهنة لهذا المشروع؟","image":null,"video":null,"explanation":"الإجابة هي D. في حالة تتجاوز فيها القيمة الدائمة للعميل (إجمالي الربح الذي يجلبه عميل واحد طوال استمرار العلاقة) تكلفة اكتساب العميل (تكلفة اكتساب عميل واحد جديد)، في كل مرة يزيد عميل واحد، يتراكم الربح بمقدار الفرق بين القيمة الدائمة وتكلفة الاكتساب. الخياران A و B حذران أكثر من اللازم رغم أنها فرصة للربح. الخيار C خطأ لأنه إذا انخفضت كفاءة الاكتساب وارتفعت التكلفة (تكلفة الاكتساب)، هناك خطر الدخول في العجز، فلا يمكن القول إن الربح \u0026#34;سيستمر بالتأكيد في التراكم.\u0026#34; ما يهم هو الحفاظ دائمًا على حالة القيمة الدائمة \u0026gt; تكلفة الاكتساب.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1084":{"id":1084,"subject_id":7,"type":"mcq","question_text":"كإنهاء للتصميم، تتوقّع هل يمكن نشر المشروع بشكل كبير في المستقبل. أي مما يلي يفسّر بأفضل شكل \u0026#34;قابلية التوسّع،\u0026#34; خاصية مهمة لنشر مشروع بشكل كبير؟","image":null,"video":null,"explanation":"قابلية التوسّع هي الخاصية التي، حتى مع زيادة العملاء، يمكنك التعامل معها دون زيادة العمل أو التكلفة كثيرًا، ويرتفع هامش الربح مع توسّع الإيراد. بالاقتران مع حالة تكون فيها القيمة الدائمة أكبر من تكلفة الاكتساب، تصبح القوة لنمو مشروع بشكل كبير. الإجابة هي C. الخيار A هو التفسير المعكوس حيث يزيد العمل بمقدار الزيادة، الخيار B هو سهولة رفع الأسعار، الخيار D هو سرعة زيادة المحلات بالاستدانة - لا واحد منها قابلية التوسّع بذاتها.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1085":{"id":1085,"subject_id":7,"type":"mcq","question_text":"في مركز بدء المشاريع، تتحقق من سياسة التشغيل لتوسيع مشروع منظّف حذاء كرة القدم المُطوَّر بشكل انفجاري في وقت قصير. من بين ما يلي، أي طريقة للمضي قدمًا لديها أعلى \u0026#34;قابلية توسّع\u0026#34; وأسهل في التعامل مع زيادة طلب مفاجئة؟","image":null,"video":null,"explanation":"ما يكون عالي قابلية التوسّع هو طريقة للمضي قدمًا لا يزيد فيها العمل والتكلفة كثيرًا حتى مع زيادة العملاء. لتوسيع مشروع، من المهم أن عمل صنع وتوصيل المنتج نفسه لا يزيد بما يتناسب مع عدد العملاء. الخيار A يوحّد خطوات التصنيع للإنتاج الضخم دفعة واحدة، فحتى طفرة طلبات مفاجئة تُعالَج بنفس الطريقة مع عمل لا يزيد كثيرًا. الإجابة هي A. الخيار B عمل يدوي لكل شخص حتى بسعر مرتفع، الخيار C زيادة الموظفين بنفس المقدار في كل مرة تزيد الطلبات، الخيار D شراء المواد لكل طلب والصنع واحدًا تلو الآخر يدويًا - كل واحد منها يزيد العمل والتكلفة بنفس المقدار كلما زاد العملاء، فمن الصعب النشر بشكل كبير.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1086":{"id":1086,"subject_id":7,"type":"mcq","question_text":"قبل طرح منظّف حذاء كرة القدم للبيع، لتوقّع الدخل والمصروفات الشهرية بشكل صحيح، ترتّب آلية التكلفة. عند التفكير في كل التكاليف مقسّمة إلى \u0026#34;تكاليف ثابتة\u0026#34; و\u0026#34;تكاليف متغيرة،\u0026#34; كتفسير لـ\u0026#34;التكلفة المتغيرة\u0026#34; من بين هذه، أي مما يلي هو الأكثر ملاءمة؟","image":null,"video":null,"explanation":"التكلفة المتغيرة هي تكلفة تتحرك مع عدد المُباع. كمواد المنتج، يُحتاج إلى أكثر في الأشهر التي يُباع فيها كثيرًا، ويُحدُّ منها في الأشهر التي لا تُباع فيها. الإجابة هي C. الخيار A هو تفسير تكلفة ثابتة لا تتغيّر بالإيراد، الخيار B مصروف لمرة واحدة، الخيار D تكلفة تتحرك عكس الإيراد - لا واحد منها تكلفة متغيرة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1087":{"id":1087,"subject_id":7,"type":"mcq","question_text":"قبل طرحه للبيع، لتوقّع الدخل والمصروفات الشهرية، ترتّب التكاليف القادمة واحدة تلو الأخرى. من بين التكاليف التالية، أيها يُحسب \u0026#34;تكلفة ثابتة\u0026#34; - مقدار محدد يحدث كل شهر بغض النظر عن زيادة أو انخفاض كمية المبيعات (المبيعات)؟","image":null,"video":null,"explanation":"التكلفة الثابتة هي تكلفة تخرج بشكل محدد تقريبًا كل شهر، غير متأثرة بالإيراد. إيجار المكان المُستأجر كمساحة عمل يكلّف نفس المقدار كل شهر سواء بيعت الأشياء أم لا، فهو تكلفة ثابتة. الإجابة هي C. الخيار A (المواد)، والخيار B (الأكياس والصناديق)، والخيار D (رسم التوصيل) كلها تكاليف متغيرة تزيد مع مقدار المُباع.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1088":{"id":1088,"subject_id":7,"type":"mcq","question_text":"لزيادة الربح أكثر بينما تستمر في البيع، تفكّر في \u0026#34;إعادة النظر في تكلفة المواد (تكلفة متغيرة) لجعلها أرخص\u0026#34; لتحسين الربح لكل منتج. في هذا الوقت، بناءً على \u0026#34;المقايضة\u0026#34; بين التكلفة والجودة، أي مما يلي هو الطريقة الأكثر ملاءمة للرؤية؟","image":null,"video":null,"explanation":"المقايضة هي اختيار نقطة التوازن بين تحديد التكلفة والحفاظ على الجودة أو رضا العملاء. جعل المواد أرخص يقلّل التكلفة، لكن الجودة أو قابلية الاستخدام قد تتغيّر وتؤثر على الإيراد، فتقرر برؤية كلا الأمرين. الإجابة هي D. الخيار A يرى فقط أثر التكلفة دون التأثير على الجودة أو قابلية الاستخدام، الخيار B ينظر فقط إلى الجودة دون رؤية كم انخفضت التكلفة - كلاهما ينحاز لجانب واحد. الخيار C يركّز فقط على جانب التكلفة بـ\u0026#34;إذا كان يمكن توقّع بقاء الإيراد،\u0026#34; دون رؤية كافية لتأثير انخفاض الجودة على الإيراد.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1089":{"id":1089,"subject_id":7,"type":"mcq","question_text":"في مرحلة توقّع سعر البيع والتكاليف، تتأكد من كيفية إيجاد \u0026#34;نقطة التعادل،\u0026#34; الدليل لـ\u0026#34;كم يحتاج إلى بيعه للهروب من العجز والانتقال إلى الربح.\u0026#34; أي مما يلي هو الصيغة الصحيحة لإيجاد كمية المبيعات التي هي نقطة التعادل؟","image":null,"video":null,"explanation":"نقطة التعادل تُوجَد بقسمة إجمالي التكاليف الثابتة على \u0026#34;الربح المتبقي لكل منتج واحد (هامش المساهمة) = سعر البيع لكل منتج واحد − التكلفة المتغيرة لكل منتج واحد.\u0026#34; ما يمكن أن يذهب نحو استرداد التكاليف الثابتة في كل مرة يُباع واحد هو الربح لكل منتج بعد طرح التكلفة المتغيرة من سعر البيع. الإجابة هي C. الخيار A يقسم على سعر البيع دون طرح التكلفة المتغيرة، الخيار B يستخدم التكلفة المتغيرة دون سعر البيع، الخيار D يجمع سعر البيع والتكلفة المتغيرة ويقسم - لا واحد منها يصبح الربح المتبقي لكل منتج واحد.","explanation_image":"image_4_16_5_ar.png","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1090":{"id":1090,"subject_id":7,"type":"mcq","question_text":"بعد أشهر قليلة من الطرح للبيع، استقر الإيراد. بناءً على بيانات هذا الجدول، ما هي \u0026#34;كمية المبيعات عند نقطة التعادل\u0026#34; الحد الأدنى المطلوبة لاسترداد التكاليف الثابتة الشهرية بالكامل والانتقال إلى الربح؟","image":"image_4_16_6_ar.png","video":null,"explanation":"نقطة التعادل تُوجَد بقسمة إجمالي التكاليف الثابتة على \u0026#34;الربح المتبقي لكل منتج واحد (هامش المساهمة) = سعر البيع − التكلفة المتغيرة.\u0026#34; لاحظ أن التكاليف الثابتة تحدث كل شهر بغض النظر عن الإيراد، والتكاليف المتغيرة تزيد أو تنخفض مع عدد المُباع. الربح المتبقي لكل منتج واحد هو ١٢٠ − ٤٥ = ٧٥ جنيهًا. ١٥٬٠٠٠ / ٧٥ = ٢٠٠ منتج. الإجابة هي A.","explanation_image":"image_4_16_5_ar.png","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1091":{"id":1091,"subject_id":7,"type":"mcq","question_text":"تُقيّم بيانات كمية المبيعات الفعلية وتحلّل الحالة الراهنة للمشروع. بناءً على نقطة التعادل المُبيَّنة في هذا الجدول (٢٠٠ منتج)، تحكم هل كان كل شهر ربحًا أو عجزًا من كميات إيراد الشهر الماضي وهذا الشهر. أي مما يلي هو الأكثر ملاءمة؟","image":"image_4_16_7_ar.png","video":null,"explanation":"الشهر الذي يُباع فيه أكثر من نقطة التعادل (٢٠٠ منتج) هو ربح، والشهر الذي يكون تحتها هو عجز. الشهر الماضي كان ٢٤٠ منتجًا، فوق ٢٠٠، فهو ربح؛ هذا الشهر كان ١٦٠ منتجًا، تحت ٢٠٠، فهو عجز. الإجابة هي B.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1092":{"id":1092,"subject_id":7,"type":"mcq","question_text":"مرّ نصف عام منذ بدء بيع المنتج، وبدأ الإيراد ينمو بثبات. على لوحة معلومات مركز بدء المشاريع، لتحليل أداء شركتك بشكل صحيح، يُعرَض الربح مقسّمًا إلى مراحل: \u0026#34;الربح الإجمالي ← الربح التشغيلي ← الربح الصافي.\u0026#34; ما الهدف الأساسي من تقسيم والتحقق من الربح على مراحل، بدلًا من النظر إلى رقم واحد مُجمَّع؟","image":null,"video":null,"explanation":"رؤية الربح مقسّمًا إلى مراحل هي للتأكد في كل مرحلة من \u0026#34;إلى أي تكلفة طُرحت لهذا الربح\u0026#34; من الإيراد، وتحديد أي تكلفة هي سبب انخفاض الربح. برؤية الربح الإجمالي (ربح المنتج نفسه) ← الربح التشغيلي (ربح النشاط الرئيسي) ← الربح الصافي (الربح المتبقي أخيرًا)، يمكنك معرفة في أي مرحلة يُقتطَع الربح، مما يسهّل تضييق وتحديد إجراءات لمكان التحسين. الإجابة هي D. الخيار A خطأ لأن زيادة المراحل لا تغيّر الربح الصافي بذاته، الخيار B خطأ لأن الربح على مراحل رؤية مفيدة للحكم الإداري، الخيار C خطأ لأن المقدار يختلف في كل مرحلة.","explanation_image":"image_4_16_8_ar.png","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1093":{"id":1093,"subject_id":7,"type":"mcq","question_text":"بينما تقرأ جوهر الأرباح، تتأكد من أي نوع من الربح \u0026#34;الربح الإجمالي\u0026#34; من بين مراحل الربح. أيها مناسب؟","image":null,"video":null,"explanation":"الربح الإجمالي هو الربح من طرح، من الإيراد، التكلفة المُنفَقة مباشرة على تصنيع المنتج نفسه أو تخزينه (تكلفة البضاعة المُباعة). يعبّر عن كم ولّدت السلع المتوفرة بعد تكلفتها الأساسية. الإجابة هي C. الخيار A هو الربح التشغيلي بعد طرح المصروفات التشغيلية والإدارية، الخيار B هو الربح الصافي بعد طرح الضريبة أيضًا (الربح المتبقي أخيرًا)، الخيار D ربح غامض بتكاليف مطروحة على التقدير - لا واحد منها الربح الإجمالي.","explanation_image":"image_4_16_8_ar.png","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1094":{"id":1094,"subject_id":7,"type":"mcq","question_text":"نصف عام منذ بدء بيع منظّف حذاء كرة القدم. للتأكد من هل يسير المشروع بسلاسة، تحسب \u0026#34;الربح التشغيلي،\u0026#34; ربح النشاط الرئيسي للمحل. بالتحقق مع هذا الجدول، ما هو الربح التشغيلي لهذا الشهر؟","image":"image_4_16_9_ar.png","video":null,"explanation":"الربح التشغيلي هو ربح النشاط الرئيسي، يُوجَد بطرح تكلفة البضاعة المُباعة والمصروفات التشغيلية والإدارية من الإيراد. ٦٤٬٠٠٠ − ٢٥٬٠٠٠ = ٣٩٬٠٠٠ (الربح الإجمالي). ٣٩٬٠٠٠ − ٢٨٬٠٠٠ = ١١٬٠٠٠ جنيه. الإجابة هي A. لاحظ أن الربح التشغيلي لا يطرح الضريبة.","explanation_image":"image_4_16_8_ar.png","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1095":{"id":1095,"subject_id":7,"type":"mcq","question_text":"نصف عام منذ بدء البيع. باستخدام برنامج محاكاة مركز بدء المشاريع، تحسب \u0026#34;الربح الصافي\u0026#34; من بيانات ربح شهر آخر. ما هو الربح الصافي لهذا الشهر؟","image":"image_4_16_10_ar.png","video":null,"explanation":"الربح الصافي هو الربح المتبقي أخيرًا بعد طرح كل التكاليف من الإيراد. إجمالي التكاليف هو ٢٢٬٠٠٠ + ٢٤٬٠٠٠ + ٢٬٠٠٠ = ٤٨٬٠٠٠ جنيه. ٥٦٬٠٠٠ − ٤٨٬٠٠٠ = ٨٬٠٠٠ جنيه. الإجابة هي A.","explanation_image":"image_4_16_8_ar.png","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1096":{"id":1096,"subject_id":7,"type":"mcq","question_text":"نصف عام منذ بدء البيع. باستخدام قاعدة بيانات مركز بدء المشاريع، تقارن بيانات من ثلاثة محلات أخرى تبيع نفس المنتج، وتتحقق من العلاقة بين حجم المشروع والربح. من بين المحلات A إلى C المُبيَّنة في الشكل، أي محل له أكثر \u0026#34;ربح تشغيلي،\u0026#34; ربح النشاط الرئيسي؟","image":"image_4_16_11_ar.png","video":null,"explanation":"الربح التشغيلي هو ربح النشاط الرئيسي المتبقي بعد طرح التكاليف من الإيراد، لا يُحدَّد بحجم الإيراد فقط. المحل A: ٩٠٬٠٠٠ − ٨٦٬٠٠٠ = ٤٬٠٠٠، المحل B: ٤٥٬٠٠٠ − ٣٧٬٠٠٠ = ٨٬٠٠٠، المحل C: ٦٠٬٠٠٠ − ٥٧٬٠٠٠ = ٣٬٠٠٠. الإيراد أكبر في المحل A، لكن الربح التشغيلي أكثر في المحل B. الإجابة هي C.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1097":{"id":1097,"subject_id":7,"type":"mcq","question_text":"بينما تستمر في البيع، في محاكاة الإدارة، تواجه وضعًا حيث \u0026#34;المشروع مربح على الورق (الربح الصافي إيجابي)، لكن لا يوجد نقد كافٍ في الحساب لشراء الدفعة القادمة من المواد.\u0026#34; لمنع الوقوع في هذا الوضع، كمنظور \u0026#34;الربح والنقد\u0026#34; الذي يجب أن يحمله رائد الأعمال دائمًا، أي مما يلي مناسب؟","image":null,"video":null,"explanation":"الربح في بيان الدخل والنقد المتوفر يتحركان بشكل منفصل. حتى لو تحدد الإيراد، إذا أتى الدفع لاحقًا، يمكن أن ينفد النقد حتى مع تحقيق الربح. فمنظور التأكد، بشكل منفصل، من توقيت دخول وخروج كل من الربح والنقد مهم. الإجابة هي D. الخيار A يرى فقط توقيت الدفع القادم، لا توقيت خروج المال، فلا يمكن القول إنه يمنع النفاد بذلك وحده - أحادي الجانب؛ الخيار B عن تخطيط المصروفات، الخيار C عن ادّخار النقد - لا واحد منهما يصل إلى جوهر \u0026#34;الربح والنقد يتحركان بشكل منفصل، فتأكّد من كليهما بشكل مستقل.\u0026#34;","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1098":{"id":1098,"subject_id":7,"type":"mcq","question_text":"مضى عام منذ بدء المشروع في مركز بدء المشاريع، وأخيرًا بدأ \u0026#34;الربح الصافي\u0026#34; يتراكم بثبات. الاستخدامات الرئيسية للربح المتبقي في المحل هي الثلاثة: \u0026#34;توزيعات الأرباح،\u0026#34; و\u0026#34;الأرباح المحتجزة،\u0026#34; و\u0026#34;إعادة الاستثمار.\u0026#34; فاستخدام \u0026#34;إدخال معدات تصنيع جديدة لصنع المنتجات أسرع وبكميات أكبر\u0026#34; - أي من هذه ينتمي إليه؟","image":null,"video":null,"explanation":"إعادة الاستثمار هي استخدام الربح المتبقي على المشروع، لجعله أفضل أو أكبر. جمع معدات جديدة لرفع القدرة على تصنيع المنتجات ينتمي إلى إعادة الاستثمار. الإجابة هي B. الخيار A، توزيعات الأرباح، هو الحصة المُقدَّمة لحاملي الأسهم؛ الخيار C، الأرباح المحتجزة، هو الجزء المحتفَظ به دون استخدام؛ الخيار D، تكلفة البضاعة المُباعة، هو التكلفة على السلع نفسها - ليس استخدامًا للربح.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1099":{"id":1099,"subject_id":7,"type":"mcq","question_text":"ترتّب \u0026#34;الأرباح المحتجزة،\u0026#34; استخدامًا مهمًا آخر للربح الصافي المتبقي في اليد. كتفسير لهذه \u0026#34;الأرباح المحتجزة،\u0026#34; أي مما يلي مناسب؟","image":null,"video":null,"explanation":"الأرباح المحتجزة هي ربح محتفَظ به في اليد بالشركة، غير مُحوَّل إلى توزيعات أرباح ولا إعادة استثمار، استعدادًا لمخاطر كنفقات مفاجئة أو فترات لا تُباع فيها الأشياء. الإجابة هي A. الخيار B هو إعادة استثمار في المشروع، الخيار C هو توزيعات أرباح مُقدَّمة لحاملي الأسهم، الخيار D هو تفسير مكافأة مدفوعة للموظفين - لا واحد منها الأرباح المحتجزة بذاتها.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1100":{"id":1100,"subject_id":7,"type":"mcq","question_text":"تشغيل المشروع في مركز بدء المشاريع على المسار الصحيح، ومن هنا تهدف إلى التوسّع إلى حجم أكبر. عندما يُستخدَم الربح الصافي المُكتسَب، لا يُحتفَظ به في الشركة، لمعدات جديدة أو تطوير سلع جديدة، أي ظاهرة هي الأكثر احتمالًا أن تحدث في نمو المشروع اللاحق؟","image":null,"video":null,"explanation":"استخدام الربح لمعدات جديدة أو تطوير سلع (إعادة استثمار) يجعل القوة الإنتاجية والبيعية المرتفعة تولّد الربح القادم، الذي يرتبط بإعادة الاستثمار القادمة مرة أخرى، مائلًا إلى التراكم بطريقة كرة الثلج (تأثير يشبه الفائدة المركّبة كثيرًا). الإجابة هي C. الخيار A يرى الاستثمار كمصروف لمرة واحدة فقط، الخيار B خطأ بأن تأثيرًا لمرة واحدة يستمر، الخيار D يفوّت تأثير الاستثمار بذاته.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1101":{"id":1101,"subject_id":7,"type":"mcq","question_text":"أكثر من عام بقليل منذ بدء المشروع في مركز بدء المشاريع. أثمرت إعادة الاستثمار الجادة حتى الآن، وتضاعفت طلبات المنتج، والمشروع ينمو بسرعة لا تستطيع القدرة الإنتاجية الحالية مواكبتها. للاستفادة من فرصة النمو هذه بينما تستعد أيضًا لمخاطر المحل، كتخصيص للربح الصافي المتوفر حاليًا، أي مما يلي هو الحكم الأكثر ملاءمة؟","image":null,"video":null,"explanation":"في فترة نمو بطلبات متضاعفة، تحويل المزيد إلى إعادة الاستثمار (استثمار النمو) لرفع القدرة الإنتاجية يسهّل انتهاز فرصة النمو. لكن ترك \u0026#34;أرباح محتجزة\u0026#34; أيضًا للاستعداد للنفقات المفاجئة يُثبّت المشروع. الخيار B، الذي يوازن كلا الأمرين، هو الأكثر ملاءمة. الخيار A ينحاز كثيرًا نحو الاستعداد ويفوّت فرصة النمو، الخيار C يستنفد الربح دون ترك استعداد، الخيار D يحوّل آليًا إلى توزيعات الأرباح بغض النظر عن الوضع.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null},"1102":{"id":1102,"subject_id":7,"type":"mcq","question_text":"دخل تشغيل المشروع في مركز بدء المشاريع عامه الثاني. منتج منظّف حذاء كرة القدم، الذي بدأ من فكرتك الصغيرة الخاصة \u0026#34;كان ليكون من الجيد لو وُجد هذا،\u0026#34; نما الآن إلى مشروع يحبه كثير من العملاء. بالنظر من هنا إلى \u0026#34;نشر المشروع بشكل أكبر وتقديم قيمة لمزيد من الناس في المجتمع،\u0026#34; كأهم سياسة إدارية يجب أن يضعها رائد الأعمال في أساس \u0026#34;كيفية استخدام الربح،\u0026#34; أي مما يلي هو؟","image":null,"video":null,"explanation":"ما يجب وضعه في أساس استخدام الربح لتقديم قيمة لمزيد من الناس هو النظرة طويلة المدى للاستمرار في إعادة استثمار الربح المُولَّد في النمو القادم، رفع قيمة المنتج والقوة الإنتاجية، وتوسيع دائرة حل المشكلات. الإجابة هي A. الخيار B يُعطي الأولوية لبيئة الموظفين واستقرار المنظمة ويوقف توسّع المشروع، الخيار C يستنفد الربح دفعة واحدة دون النظر في الاستعداد (الأرباح المحتجزة)، الخيار D يُعطي الأولوية للحفاظ على الآلية القائمة ولا يخطو نحو تحديات جديدة - لا واحد منها يرتبط بسهولة بإعادة استثمار الربح لتوسيع دائرة حل المشكلات للمجتمع أكثر.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:23Z","updated_at":null}},"options":{"1053":[{"id":4209,"question_id":1053,"subject_id":7,"sort_order":1,"text":"بما أنني لا أريد الفشل على الإطلاق، أبحث فقط في بيانات الأداء، محاولًا تقليد فقط مشاريع مُثبَتة بالفعل بأنها \u0026#34;تكسب المال بأمان وثبات\u0026#34;","image":null,"video":null},{"id":4210,"question_id":1053,"subject_id":7,"sort_order":2,"text":"\u0026#34;بما أنني لاحظت مشكلة قريبة مني، بدأت أولًا خدمة تجريبية صغيرة (منتج أولي قابل للتطبيق) في مجموعة على وسائل التواصل الاجتماعي. الآن أصلحها بشدة بناءً على انتقادات من استخدمها\u0026#34;","image":null,"video":null,"is_correct":true},{"id":4211,"question_id":1053,"subject_id":7,"sort_order":3,"text":"\u0026#34;أفكّر في تقليد خدمة رائجة جدًا الآن، بالجملة، وبيعها بالطريقة نفسها تمامًا. اتّباع الرواج هو الأسرع، في النهاية\u0026#34;","image":null,"video":null},{"id":4212,"question_id":1053,"subject_id":7,"sort_order":4,"text":"\u0026#34;أنا على معرفة واسعة بأحدث توجهات أعمال تقنية المعلومات وحالات الشركات الناشئة في الخارج، وأدرس في ندوات المركز يوميًا تقريبًا، لكنني لم أبدأ أي شيء خاص بي بعد\u0026#34;","image":null,"video":null}],"1054":[{"id":4213,"question_id":1054,"subject_id":7,"sort_order":1,"text":"① مشروع صغير ② ريادة أعمال اجتماعية ③ شركة ناشئة","image":null,"video":null},{"id":4214,"question_id":1054,"subject_id":7,"sort_order":2,"text":"① ريادة أعمال اجتماعية ② شركة ناشئة ③ مشروع صغير","image":null,"video":null},{"id":4215,"question_id":1054,"subject_id":7,"sort_order":3,"text":"① شركة ناشئة ② ريادة أعمال اجتماعية ③ مشروع صغير","image":null,"video":null},{"id":4216,"question_id":1054,"subject_id":7,"sort_order":4,"text":"① شركة ناشئة ② مشروع صغير ③ ريادة أعمال اجتماعية","image":null,"video":null,"is_correct":true}],"1055":[{"id":4217,"question_id":1055,"subject_id":7,"sort_order":1,"text":"إيجاد وحل مشكلة شخص ما أو \u0026#34;لكان من الجيد لو وُجد هذا\u0026#34;، وتوليد فائدة جديدة لم تكن موجودة من قبل","image":null,"video":null,"is_correct":true},{"id":4218,"question_id":1055,"subject_id":7,"sort_order":2,"text":"إيجاد منتج منافس يُباع بالفعل، وتقليد جودته كما هي، وجعله قابلًا للبيع بسعر أرخص فقط","image":null,"video":null},{"id":4219,"question_id":1055,"subject_id":7,"sort_order":3,"text":"تأسيس شركة بشكل صحيح وفقًا للقانون، وإنهاء إجراءات بدء المشروع المُقدَّمة للمكاتب الحكومية حتى النهاية","image":null,"video":null},{"id":4220,"question_id":1055,"subject_id":7,"sort_order":4,"text":"دون تغيير محتوى المنتج، إصدار إعلانات كثيرة لنشر الاسم، وعلى أي حال، جعل كثير من الناس يعرفونه","image":null,"video":null}],"1056":[{"id":4221,"question_id":1056,"subject_id":7,"sort_order":1,"text":"① و ②","image":null,"video":null},{"id":4222,"question_id":1056,"subject_id":7,"sort_order":2,"text":"② و ③","image":null,"video":null},{"id":4223,"question_id":1056,"subject_id":7,"sort_order":3,"text":"① و ④","image":null,"video":null,"is_correct":true},{"id":4224,"question_id":1056,"subject_id":7,"sort_order":4,"text":"③ و ④","image":null,"video":null}],"1057":[{"id":4225,"question_id":1057,"subject_id":7,"sort_order":1,"text":"لمن = أشخاص يريدون الحفاظ على نظافة الأحذية الجلدية لفترة طويلة / المشكلة = العناية بأحذية غالية تتطلب جهدًا ومالًا / القوة = التلميع ببطء وشمولية بكريم خاص","image":null,"video":null},{"id":4226,"question_id":1057,"subject_id":7,"sort_order":2,"text":"لمن = أي شخص على الإطلاق / المشكلة = الرغبة في إزالة كل نوع من الأوساخ تمامًا / القوة = الاستخدام الشامل على أي مادة","image":null,"video":null},{"id":4227,"question_id":1057,"subject_id":7,"sort_order":3,"text":"لمن = رياضيون يريدون التميّز / المشكلة = الرغبة في جذب الانتباه في المباريات / القوة = عامل الحديث عن استخدام لاعبين مشهورين له","image":null,"video":null},{"id":4228,"question_id":1057,"subject_id":7,"sort_order":4,"text":"لمن = أشخاص تتغطّى أحذية كرة القدم لديهم بالطين في التمرين / المشكلة = لا يوجد مصدر ماء قريب، ولا يمكنهم تنظيفها فورًا في الموقع / القوة = إزالة الأوساخ في دقائق قليلة دون ماء، حتى بين التنقّلات","image":null,"video":null,"is_correct":true}],"1058":[{"id":4229,"question_id":1058,"subject_id":7,"sort_order":1,"text":"إجراء استبيان على وسائل التواصل الاجتماعي، وإذا كانت هناك إجابات \u0026#34;أريده\u0026#34; كثيرة، بدء التصنيع فورًا بناءً على ذلك","image":null,"video":null},{"id":4230,"question_id":1058,"subject_id":7,"sort_order":2,"text":"صنع كمية صغيرة فقط أولًا، والبحث عن أشخاص يدفعون فعلًا للشراء، والتأكد من ردهم","image":null,"video":null,"is_correct":true},{"id":4231,"question_id":1058,"subject_id":7,"sort_order":3,"text":"لجعل الربح كبيرًا، تصنيع كمية كبيرة من البداية بالمال الذي يمكنك تحضيره، وبيعها كلها دفعة واحدة","image":null,"video":null},{"id":4232,"question_id":1058,"subject_id":7,"sort_order":4,"text":"دون التأكد من وجود من سيشتري، تكرار التحسينات لرفع الجودة أكثر، والبيع فقط بعد ارتفاع الاكتمال تمامًا","image":null,"video":null}],"1059":[{"id":4233,"question_id":1059,"subject_id":7,"sort_order":1,"text":"سؤال صديق محلي مقرّب \u0026#34;ما رأيك في سلع كهذه؟\u0026#34;، وبما أنه قال \u0026#34;جميل، سأدعمك\u0026#34;، التفكير أنه مطلوب","image":null,"video":null},{"id":4234,"question_id":1059,"subject_id":7,"sort_order":2,"text":"التفكير أنه يجب أن يكون هناك طلب بالتأكيد، ودون سؤال أحد، طلب مواد بقيمة شهر بالجملة أولًا لتكون جاهزة","image":null,"video":null},{"id":4235,"question_id":1059,"subject_id":7,"sort_order":3,"text":"الاعتماد فقط على النص المكتوب على السبورة، شراء المواد وصنع نموذج أولي أولًا، نشر صورة على وسائل التواصل الاجتماعي، والانتظار حتى يتواصل معك المهتمون","image":null,"video":null},{"id":4236,"question_id":1059,"subject_id":7,"sort_order":4,"text":"سؤال زملاء المركز في الرياضة الناشئة وطلاب النادي الفعليين مباشرة عن أساليب العناية المعتادة والخطوات كثيفة العمالة، والتأكد","image":null,"video":null,"is_correct":true}],"1060":[{"id":4237,"question_id":1060,"subject_id":7,"sort_order":1,"text":"صنع منتج أو خدمة تجريبية مُضيَّقة إلى النقطة الأهم فقط في الفكرة، وإصلاحها خلال مراقبة ردود العملاء","image":null,"video":null,"is_correct":true},{"id":4238,"question_id":1060,"subject_id":7,"sort_order":2,"text":"حشو ميزات مختلفة يمكن تصوّرها من البداية بحيث يشعر العملاء بالرضا، وتقديمها بعد رفع الاكتمال","image":null,"video":null},{"id":4239,"question_id":1060,"subject_id":7,"sort_order":3,"text":"التخطيط لأنشطة ترويجية مسبقًا لجعل أكبر عدد ممكن من الناس يعرفون بوجود مشروع جديد","image":null,"video":null},{"id":4240,"question_id":1060,"subject_id":7,"sort_order":4,"text":"السؤال والبحث مباشرة، قبل بدء التطوير، عن المشكلات الحقيقية التي يحملها العملاء في حياتهم اليومية","image":null,"video":null}],"1061":[{"id":4241,"question_id":1061,"subject_id":7,"sort_order":1,"text":"① ← ② ← ③","image":null,"video":null},{"id":4242,"question_id":1061,"subject_id":7,"sort_order":2,"text":"③ ← ② ← ①","image":null,"video":null,"is_correct":true},{"id":4243,"question_id":1061,"subject_id":7,"sort_order":3,"text":"③ ← ② ← ④","image":null,"video":null},{"id":4244,"question_id":1061,"subject_id":7,"sort_order":4,"text":"④ ← ③ ← ②","image":null,"video":null}],"1062":[{"id":4245,"question_id":1062,"subject_id":7,"sort_order":1,"text":"① خطر السوق ② خطر المنافسة ③ الخطر المالي","image":null,"video":null},{"id":4246,"question_id":1062,"subject_id":7,"sort_order":2,"text":"① خطر المنافسة ② الخطر المالي ③ خطر السوق","image":null,"video":null},{"id":4247,"question_id":1062,"subject_id":7,"sort_order":3,"text":"① الخطر المالي ② خطر السوق ③ خطر المنافسة","image":null,"video":null},{"id":4248,"question_id":1062,"subject_id":7,"sort_order":4,"text":"① الخطر المالي ② خطر المنافسة ③ خطر السوق","image":null,"video":null,"is_correct":true}],"1063":[{"id":4249,"question_id":1063,"subject_id":7,"sort_order":1,"text":"لنموذج أولي مثالي، شراء طابعات وأدوات ثلاثية الأبعاد حديثة غالية بشكل فردي أولًا، وإعداد مساحة عمل مخصصة في المنزل","image":null,"video":null},{"id":4250,"question_id":1063,"subject_id":7,"sort_order":2,"text":"استئجار معدات ورشة العمل المشتركة للمركز بسعر رخيص، وتجميع النموذج الأولي الأول أولًا ضمن ميزانية بضعة آلاف من الجنيهات المتوفرة فقط","image":null,"video":null,"is_correct":true},{"id":4251,"question_id":1063,"subject_id":7,"sort_order":3,"text":"بما أن انخفاض المال خطر كبير، عدم شراء مواد النموذج الأولي وقضاء الوقت في تكرار المحاكاة في رأسك فقط عند مقعدك","image":null,"video":null},{"id":4252,"question_id":1063,"subject_id":7,"sort_order":4,"text":"لتوفير تكاليف التطوير، عدم الاعتماد على خبراء خارجيين، والتقدّم في كل الإجراءات القانونية وإجراءات البراءات الصعبة بمفردك بشراء كتب","image":null,"video":null}],"1064":[{"id":4253,"question_id":1064,"subject_id":7,"sort_order":1,"text":"تحسين القوة الفريدة الخاصة بسلعك أكثر - القدرة على التنظيف بسرعة دون ماء - وتقديمها للعملاء","image":null,"video":null,"is_correct":true},{"id":4254,"question_id":1064,"subject_id":7,"sort_order":2,"text":"لعدم أخذ العملاء من قِبل المنافس، تخفيض سعر سلعك ضمن نطاق ممكن ومواجهة الأمر بكونك أرخص من الآخر","image":null,"video":null},{"id":4255,"question_id":1064,"subject_id":7,"sort_order":3,"text":"بما أن منافسًا قويًا ظهر أولًا، التفكير أن منافسة هذا المنتج عالية الخطر، والتحوّل فورًا إلى مشروع مختلف تمامًا","image":null,