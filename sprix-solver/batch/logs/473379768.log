_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:42:03Z"},{"id":20611039,"test_response_id":1372349,"test_question_id":469,"status":"graded","selected_option_id":3400,"answer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:42:03Z"},{"id":20611040,"test_response_id":1372349,"test_question_id":470,"status":"graded","selected_option_id":3403,"answer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:42:04Z"}],"questions":{"802":{"id":802,"subject_id":7,"type":"mcq","question_text":"عندما تستيقظ في عالم المحاكي، يبدأ يومك كشخص بالغ عامل. قبل مغادرة العمل، على الجريدة المنتشرة على الطاولة، ثلاث عبارات تظهر: \u0026#34;بقالة محلية\u0026#34;، و\u0026#34;سلسلة مطاعم كبرى\u0026#34;، و\u0026#34;مرفق مياه\u0026#34;. من بين هذه، أيها \u0026#34;منشأة عامة\u0026#34;؟","image":null,"video":null,"explanation":"المنشأة العامة هي التي تديرها الحكومة الوطنية أو المحلية، تدعم أساسيات الحياة اليومية. مرفق المياه يقع تحت هذا. A وB وC كلها منشآت خاصة يديرها القطاع الخاص، شركة تكنولوجيا المعلومات وسلسلة المطاعم منشآت قانونية، والبقالة التي تديرها الأسرة مشروع فردي. محور التصنيف ليس \u0026#34;النطاق\u0026#34; بل \u0026#34;من يديرها\u0026#34;.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"803":{"id":803,"subject_id":7,"type":"mcq","question_text":"بعد غسل وجهك، تحزم حقيبتك للتنقّل. بشكل مفاجئ، يجذب انتباهك كتاب أعمال بدأت قراءته بالأمس. تقول الصفحة، \u0026#34;أشكال إدارة المشروع التجاري تنقسم بشكل عام إلى مشاريع فردية ومنشآت قانونية\u0026#34;. من بين هذه، أي منها يصف بأفضل شكل \u0026#34;المشروع الفردي\u0026#34;؟","image":null,"video":null,"explanation":"المشروع الفردي شكل يدير فيه فرد المشروع مباشرة، وكلا الأرباح والديون تخص الفرد بالكامل. الإجابة B. A يصف منشأة قانونية، D يصف شركة مساهمة، كلاهما يُعامَل كيانًا منفصلًا عن الفرد. C يصف منشأة عامة، مختلفة عن المشروع الفردي الذي هو منشأة خاصة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"804":{"id":804,"subject_id":7,"type":"mcq","question_text":"في طريقك للمحطة بعد ترك البيت، لافتات شركات متعددة تصطفّ في الشارع: \u0026#34;شركة تضامن\u0026#34;، و\u0026#34;شركة توصية بسيطة\u0026#34;، و\u0026#34;شركة ذات مسؤولية محدودة\u0026#34;، و\u0026#34;شركة مساهمة\u0026#34;. من بين هذه، أي منها يصف بأفضل شكل \u0026#34;الشركة المساهمة\u0026#34;؟","image":null,"video":null,"explanation":"الشركة المساهمة شكل مسؤولية محدودة يتحمّل فيه كل المساهمين مسؤولية فقط بحدود استثمارهم. الإجابة C. A خاصية شركة التضامن، B خاصية شركة التوصية البسيطة، كلاهما يشمل أعضاء بمسؤولية غير محدودة. D يصف منشأة عامة، مختلفة عن الشركة المساهمة التي هي منشأة خاصة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"805":{"id":805,"subject_id":7,"type":"mcq","question_text":"بينما تنتظر القطار على الرصيف، يجذب انتباهك مقال عن \u0026#34;المسؤولية المحدودة وغير المحدودة\u0026#34; في الجريدة في يدك. أي من المشاهد التالية ينطبق بأفضل شكل على \u0026#34;المسؤولية غير المحدودة\u0026#34;؟","image":null,"video":null,"explanation":"المسؤولية غير المحدودة آلية يجب فيها، عندما تصبح شركة معسرة، الدفع من أصولك الخاصة بما يتجاوز المقدار المستثمر. مستثمرو شركة التضامن يقعون تحت هذا، والإجابة D. A مشهد مسؤولية محدودة ينتهي ضمن مقدار الاستثمار، B مشهد نشاط منظمة غير ربحية، وC مشهد تشغيل منشأة عامة، لا شيء منها ينطبق على المسؤولية غير المحدودة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"806":{"id":806,"subject_id":7,"type":"mcq","question_text":"داخل القطار الذي ركبته، تسمع شخصين يقفان قريبًا يقولان، \u0026#34;أنشطة تلك المنظمة غير الربحية عظيمة، أليس كذلك؟\u0026#34; ما الفرق الأكبر بين \u0026#34;منظمة غير ربحية\u0026#34; و\u0026#34;شركة\u0026#34;؟","image":null,"video":null,"explanation":"بينما هدف الشركة الأساسي هو السعي للربح، المنظمة غير الربحية منظمة تضع أهدافًا كتحقيق المساهمة الاجتماعية، وتستخدم الدخل من أنشطتها لاستمرارها أو توسيعها. هذا \u0026#34;الفرق في غرض النشاط\u0026#34; هو الأكبر، والإجابة B. A خاطئة لأن المنظمات غير الربحية يُسمَح لها أيضًا بتوظيف موظفين بأجر وكسب دخل من الأنشطة. C خاطئة لأن المنظمات غير الربحية تُسجَّل كشخصيات اعتبارية أيضًا للعمل. D خاطئة لأن المنظمات غير الربحية منظمات يبدأها ويديرها أفراد من القطاع الخاص، ليست الحكومة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"807":{"id":807,"subject_id":7,"type":"mcq","question_text":"تخرج من القطار وتعبر بوابة المصنع. في الاجتماع الصباحي، يخاطب المدير التنفيذي الموظفين: \u0026#34;لننمّي ربح شركتنا أكثر\u0026#34;. ماذا يعني \u0026#34;ربح الشركة\u0026#34; هنا؟","image":null,"video":null,"explanation":"ربح الشركة هو المال المتبقي في اليد بعد طرح النفقات من الإيرادات. الإجابة A. B هي الإيرادات نفسها قبل طرح النفقات، C إجمالي النفقات المدفوعة، وD الضرائب المدفوعة للحكومة، كلها مختلفة عن ربح الشركة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"808":{"id":808,"subject_id":7,"type":"mcq","question_text":"عندما تصل إلى موقعك، يعطيك موظف محاسبة تقريرًا قائلًا، \u0026#34;هذه أرقام الشهر الماضي\u0026#34;. وفقًا للتقرير، كانت إيرادات الشهر الماضي ٣٠٠٬٠٠٠ جنيه، والنفقات ١٢٠٬٠٠٠ جنيه للمواد الخام، و٧٠٬٠٠٠ جنيه للعمالة، و٢٠٬٠٠٠ جنيه لتكاليف أخرى. ما كان ربح هذا المصنع الشهر الماضي؟","image":null,"video":null,"explanation":"ربح الشركة هو ما يتبقى بعد طرح كل النفقات من الإيرادات. إجمالي النفقات ١٢٠٬٠٠٠+٧٠٬٠٠٠+٢٠٬٠٠٠=٢١٠٬٠٠٠، فـ٣٠٠٬٠٠٠−٢١٠٬٠٠٠=٩٠٬٠٠٠، والإجابة B. A هي الإيرادات نفسها قبل الطرح، C إجمالي النفقات، وD مقدار نسي طرح التكاليف الأخرى وطرح جزءًا فقط من النفقات، كلها مختلفة عن ربح الشركة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"809":{"id":809,"subject_id":7,"type":"mcq","question_text":"بالنظر إلى بيان الدخل أعلاه، تفكّر، \u0026#34;لزيادة ربح الشركة أكثر، أي نفقة سيكون فعّالًا تقليصها؟\u0026#34; إذا استطعت تقليص كل نفقة بنفس النسبة، أي عنصر نفقات يمكن أن يزيد ربح الشركة أكثر من خلال التقليص؟","image":"image_2_8_2_ar.png","video":null,"explanation":"لزيادة ربح الشركة تحتاج إلى تقليل النفقات، وإذا قلّصت بنفس النسبة، كلما كان المقدار الأصلي أكبر، كان التقليص أكبر. أكبر نفقة هي تكاليف المواد الخام (٢٠٠٬٠٠٠)، فالأثر الأكبر هو A. تكاليف العمالة في B (١٥٠٬٠٠٠) والتكاليف الأخرى في C (٥٠٬٠٠٠) أصغر. الإيرادات في D ليست نفقة بل دخل قادم للشركة، وتقليصها سيقلّل ربح الشركة فعليًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"810":{"id":810,"subject_id":7,"type":"mcq","question_text":"اليوم كان يوم الجمعية العامة للمساهمين، فتجمّع مساهمون لا يأتون عادة للمصنع. المساهمون هم من يستثمرون في الشركة، لكن من يتعاملون مع الإدارة اليومية هم الرئيس والمسؤولون المختارون. أي مما يلي يصف بأفضل شكل بنية هذه الشركة؟","image":null,"video":null,"explanation":"التقسيم الذي يكون فيه المساهمون الذين يستثمرون في شركة والأشخاص الذين يديرونها فعليًا في مناصب منفصلة يُسمى \u0026#34;الفصل بين الملكية والإدارة\u0026#34;. في هذه الشركة، يستثمر المساهمون ويدير الرئيس والمسؤولون المختارون، فالإجابة C. A الشرح المعكوس حيث يدير المساهمون كلهم، B الخطأ بأن الربح يخصّ فقط الإدارة، الربح يُشارَك أيضًا مع المساهمين الذين استثمروا، وD خاطئة لأن المساهمين يمكن أن يتورطوا في الإدارة من خلال الجمعية العامة للمساهمين.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"811":{"id":811,"subject_id":7,"type":"mcq","question_text":"خلال استراحة في العمل الصباحي، تم نشر رسم بياني واحد بعنوان \u0026#34;الشركاء الذين يجب أن نقدّرهم\u0026#34; على جدار مساحة الاستراحة. من بين ① إلى ④ التالية، أي توليفة تختار بشكل صحيح كل الأطراف التي تُحسَب \u0026#34;أصحاب مصلحة\u0026#34; الشركة؟ ① مساهمو الشركة\n② الموظفون العاملون في الشركة\n③ العملاء الذين يشترون منتجات الشركة\n④ شركة في صناعة مختلفة بلا صفقات أو اتصال بالشركة","image":null,"video":null,"explanation":"أصحاب المصلحة أطراف لها اتصال مباشر بالشركة وتؤثر على بعضها بعضًا بشكل متبادل، تشمل المساهمين والموظفين والعملاء وشركاء الأعمال والمجتمع المحلي. ① المساهمون، ② الموظفون، ③ العملاء كلها تنطبق، وC، التي تشمل ①②③، صحيحة. ④، شركة في صناعة مختلفة بلا صفقات أو اتصال، ليس لها اتصال مباشر بالشركة، فلا تُحسَب صاحب مصلحة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"812":{"id":812,"subject_id":7,"type":"mcq","question_text":"عندما تمرّ قرب مدخل المصنع، ملصق يُظهر أنشطة حفاظ بيئي معروض على الجدار. زميل ينظر إليه يخاطبك: \u0026#34;لا نسعى فقط للربح، نبذل جهدًا في أنشطة كهذه أيضًا، صحيح؟\u0026#34; أي فكرة تمثّل الجهد الذي يتحدث عنه هذا الزميل؟","image":null,"video":null,"explanation":"ما يُظهره الملصق هو جهد للعمل بمسؤولية تجاه نطاق واسع من الأطراف، لا السعي للربح فقط، أي CSR. الإجابة A. B وC وD كلها مصطلحات عن استخدام ربح الشركة، نصيب للمساهمين، احتياط داخل الشركة، استثمار للمستقبل، وليست جهد المسؤولية الاجتماعية نفسه.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"813":{"id":813,"subject_id":7,"type":"mcq","question_text":"خلال الاستراحة، تسمع موظفين قريبين يقولان، \u0026#34;مؤخرًا، مستثمرون أكثر ينظرون إلى الشركات من منظور ESG\u0026#34;. أي مما يلي هو التوليفة الأفضل للعناصر الثلاثة لهذا \u0026#34;ESG\u0026#34;؟","image":null,"video":null,"explanation":"ESG يشير إلى المحاور الثلاثة التي ينظر إليها المستثمرون عند تقييم شركة: E (البيئة)، وS (المجتمع)، وG (الحوكمة). الإجابة B. A هي الأطراف الثلاثة للدورة الاقتصادية، C جزء من أصحاب المصلحة، وD عناصر الربح والخسارة، كل هذه أطر مختلفة عن ESG.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"814":{"id":814,"subject_id":7,"type":"mcq","question_text":"بينما تستمر في العمل الصباحي، يخاطبك زميل: \u0026#34;هذا العمل، في النهاية، يقوم على الحفاظ على الامتثال، صحيح؟\u0026#34; أي مما يلي يصف بأفضل شكل معنى هذا \u0026#34;الامتثال\u0026#34;؟","image":null,"video":null,"explanation":"الامتثال يشير إلى العمل بينما تراعي ليس فقط القوانين التي تضعها الحكومة الوطنية أو المحلية، بل أيضًا لوائح المنظمة وحتى الأخلاقيات التي يطلبها المجتمع والتي ليست في القانون. النقطة المهمة هي أنه لا يتوقف عند \u0026#34;عدم مخالفة القانون\u0026#34; فقط. الإجابة D. A اهتمام بالبيئة، B نشاط مبيعات، وC معاملة، كلها جوانب مختلفة عن الامتثال.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"815":{"id":815,"subject_id":7,"type":"mcq","question_text":"بينما تراقب جهود المصنع المتنوعة، تتساءل، \u0026#34;كيف يتصل \u0026#39;مراعاة القواعد\u0026#39; بـ\u0026#39;العمل لصالح المجتمع\u0026#39;؟\u0026#34; أي مما يلي يصف بأفضل شكل العلاقة بين CSR والامتثال؟","image":null,"video":null,"explanation":"الامتثال أساس CSR، مراعاة القوانين والقواعد، والقاعدة لتحقيق المسؤولية الاجتماعية. الإجابة B. A خاطئة لأن الامتثال وحده لا يستطيع تحقيق كل CSR، C بها الشرحان معكوسان، وD خاطئة لأن لا واحد منهما يشير فقط للاعتبار البيئي.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"816":{"id":816,"subject_id":7,"type":"mcq","question_text":"خلال استراحة الظهيرة، تدخل الكافتيريا، وبينما تأكل الغداء، تسمع من الطاولة المجاورة، \u0026#34;تلك المعدات يمكن تمويلها بدعم حكومي\u0026#34;. أي مما يلي يصف بأفضل شكل الهدف الأساسي من إعطاء الحكومة دعمًا لشركات كهذه؟","image":null,"video":null,"explanation":"يهدف الدعم لدعم أنشطة الشركة وتنشيط الاقتصاد كله. الإجابة C. A هدف جمع الضرائب، وهو الاتجاه المعكوس؛ العمالة في B تدفق من الأسر للشركات، غير مرتبط بهدف الدعم؛ وD، علاقة تشتري وتتوسّط فيها الحكومة المنتجات، مختلفة أيضًا عن هدف الدعم.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"817":{"id":817,"subject_id":7,"type":"mcq","question_text":"بعد إنهاء الغداء، بينما تقضي بقية الوقت في غرفة الاستراحة، شخص في مقعد قريب كان يقول بسعادة، \u0026#34;اليوم يوم استلام الراتب، فسأشتري شيئًا جيدًا في طريقي للبيت\u0026#34;. بمشاهدة هذا، تفكّر، \u0026#34;إذا توقفت الشركات عن دفع الرواتب للأسر، ماذا سيحدث لتدفق المال كله؟\u0026#34; أي مما يلي يصف بأفضل شكل ما سيحدث؟","image":null,"video":null,"explanation":"عندما تتوقف الرواتب، تنخفض قدرة الأسر الشرائية، وينخفض دخل الشركات، وفي النهاية تنخفض الضرائب التي تدفعها كلا الأسر والشركات، مما يقلّل إيرادات الحكومة الضريبية أيضًا، وينتشر التأثير عبر الدورة كلها. الإجابة A. B خاطئة لأن التأثير لا يبقى مع الأسر وحدها، C خاطئة لأن الإيرادات الضريبية تنخفض فعليًا، وD لا يمكن تسميته جيدًا بما أن الاستهلاك يتوقف وتنخفض إيرادات الشركات أيضًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"818":{"id":818,"subject_id":7,"type":"mcq","question_text":"سمعت أن شركة بناء شريكة فازت بعقد أعمال عامة حكومية جديد. زميل علّمك عن التأثير الاقتصادي: \u0026#34;المال المصروف حديثًا يصبح إيرادات الشركة، ثم رواتب، ومن خلال التسوّق، يستمر في زيادة رواتب أشخاص آخرين واحدًا تلو الآخر\u0026#34;. أي ظاهرة اقتصادية تُظهرها هذه القصة؟","image":null,"video":null,"explanation":"الظاهرة التي يُولِّد فيها صرف واحد الاستهلاك التالي، متسلسلة حتى تتضخّم حركة مال المجتمع كله أكبر من مبلغ الصرف الأولي، هي أثر المضاعف. الإجابة A. B هي \u0026#34;الطرق الثلاث لقياس الناتج المحلي الإجمالي\u0026#34; ولا تُظهر تسلسل الصرف، C عن الدورة الاقتصادية حيث تتكرّر الأوقات الجيدة والسيئة، وD عن توازن العرض والطلب وتحديد السعر.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"819":{"id":819,"subject_id":7,"type":"mcq","question_text":"عندما زرت مصنعًا شريكًا، سمعت أن الطعام الذي يصل هناك يُحمَل بترتيب \u0026#34;توفير المواد الخام ← المعالجة في المصنع ← التوزيع ← متجر التجزئة ← المستهلك\u0026#34;. أي كلمة تمثّل هذا التسلسل من التدفق الذي تتبعه المنتجات؟","image":null,"video":null,"explanation":"تدفق المنتجات من توفير المواد الخام حتى تصل ليد المستهلك يُسمى سلسلة التوريد. الإجابة B. مسار التوزيع في A هو طريق نقل المنتجات، والدورة الاقتصادية في C عن دوران المال بين ثلاثة أطراف، وخط الإنتاج في D ترتيب تجميع المنتجات داخل مصنع، كلها مختلفة عن التدفق الكامل من المواد الخام إلى المستهلك.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"820":{"id":820,"subject_id":7,"type":"mcq","question_text":"أظهر لك موظف في المصنع الشريك الجدول أعلاه الذي يلخّص كم يُباع المنتج في كل مرحلة. كم قيمة مضافة جديدة تتولّد في مرحلة \u0026#34;المصنع ← التوزيع\u0026#34;؟ (القيمة المضافة = سعر البيع − سعر الشراء)","image":"image_2_8_3_ar.png","video":null,"explanation":"يشتري المصنع من الفلّاح بـ١٬٠٠٠ ويبيع للتوزيع بـ٣٬٠٠٠، فالقيمة المضافة هي ٣٬٠٠٠−١٬٠٠٠=٢٬٠٠٠. الإجابة C. A سعر بيع مرحلة الفلّاح، B سعر البيع الذي يبيع به المصنع للتوزيع نفسه، وD السعر الذي يبيع به التوزيع للتجزئة، لا شيء منها نتيجة حساب القيمة المضافة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"821":{"id":821,"subject_id":7,"type":"mcq","question_text":"خلال جولة المصنع الشريك، سمعت، \u0026#34;يُسمى تدفق المنتج أحيانًا باسم مختلف حسب الزاوية التي تنظر منها\u0026#34;. أي مما يلي يصف بأفضل شكل خاصية منظور \u0026#34;سلسلة القيمة\u0026#34;؟","image":null,"video":null,"explanation":"سلسلة القيمة اسم لرؤية التدفق من المواد الخام إلى المستهلك من جانب كم قيمة تتولّد في كل مرحلة. الإجابة D. A فقط تجارة، B تدفق المرتجعات، وC منظور محدود بسرعة العمل داخل المصنع، كلها مختلفة عن خاصية سلسلة القيمة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"822":{"id":822,"subject_id":7,"type":"mcq","question_text":"سمعت أن من بين شركاء المصنع شركة توفّر مواد خام من الخارج. أي مما يلي يفسّر بأفضل شكل طريقة اتصال الدول ببعضها من خلال التجارة؟","image":null,"video":null,"explanation":"الآلية التي تتولّى فيها كل دولة إنتاج مجالها التخصصي وتتكامل من خلال التجارة هي تقسيم العمل الدولي. الإجابة B. A تقسيم عمل إقليمي داخل دولة واحدة، يختلف في النطاق؛ C جزء من الاستثمار الأجنبي المباشر؛ وD عن الصرف الأجنبي، كلها آليات مختلفة عن تقسيم العمل الدولي.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"823":{"id":823,"subject_id":7,"type":"mcq","question_text":"قال موظف في المصنع: \u0026#34;نترك أعمال المحاسبة لشركة متخصصة خارجية\u0026#34;. أي مما يلي يفسر هذا النهج بأفضل شكل؟","image":null,"video":null,"explanation":"الاستعانة بمصادر خارجية هي تفويض جزء من عمليات الشركة إلى شركة متخصصة خارجية. الإجابة D. A استيراد، B تصدير، وC نقل داخلي للموظفين، كلها مختلفة عن التفويض الخارجي.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"824":{"id":824,"subject_id":7,"type":"mcq","question_text":"بعد الظهر، عندما توقفت عند المكتب، تمتم أحد المديرين هناك قائلًا: \u0026#34;ضريبة الشركات مرتفعة هذا العام\u0026#34;. أي مما يلي يصف بأفضل شكل هذه \u0026#34;ضريبة الشركات\u0026#34;؟","image":null,"video":null,"explanation":"ضريبة الشركات ضريبة تدفعها شركة للحكومة وفقًا لربح الشركة. الإجابة A. B رسوم جمركية على الاستيراد، C ضريبة استهلاك، وD وصف لضريبة الممتلكات، كلها ضرائب مختلفة عن ضريبة الشركات.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"825":{"id":825,"subject_id":7,"type":"mcq","question_text":"عُيِّنت مدرّبًا لتدريب الموظفين الجدد، وسألك متدرّب، \u0026#34;كيف تختلف ضريبة الدخل عن ضريبة الشركات؟\u0026#34; أي مما يلي يفسّر بأفضل شكل هذا الفرق؟","image":null,"video":null,"explanation":"تُفرَض ضريبة الدخل على دخل فرد، وضريبة الشركات على ربح شركة، الهدفان مختلفان. الإجابة D. A خاطئة لأن الأهداف تختلف ولا تتطابق، B بها الهدفان معكوسان، وC لا تُفرَض على الإيرادات أو النفقات نفسها.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"826":{"id":826,"subject_id":7,"type":"mcq","question_text":"في اجتماع مكتبي، ظهر موضوع: \u0026#34;تُغطّي الحكومة الخدمات العامة بالضرائب التي تجمعها\u0026#34;. أي مما يلي هو التوليفة الأفضل لأمثلة هذه \u0026#34;الخدمة العامة\u0026#34;؟","image":null,"video":null,"explanation":"الخدمات العامة أشياء كالطرق والمياه والتعليم والشرطة، تُشغِّلها الحكومة بالضرائب وتدعم بنية أساسية يستخدمها المجتمع كله. الإجابة C. A مؤسسات مالية خاصة، B خدمات شركات خاصة، وD دعم متبادل شخصي، كلها مختلفة عن الخدمات العامة التي تقدّمها الحكومة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"827":{"id":827,"subject_id":7,"type":"mcq","question_text":"في الاجتماع، تبيّن أن المنطقة التي يقع فيها مصنع شريك مُصنَّفة منطقة اقتصادية خاصة. أي مما يلي يصف بأفضل شكل هذه \u0026#34;المنطقة الاقتصادية الخاصة\u0026#34;؟","image":null,"video":null,"explanation":"المنطقة الاقتصادية الخاصة منطقة تضع فيها الحكومة حوافز ضريبية وما شابه في منطقة محدَّدة لجلب الاستثمار والأعمال. الإجابة B. A سوق تقليدي أو شارع تسوّق، C تجمّع لمرافق عامة، وD منطقة سياحية، كلها مختلفة عن نظام المنطقة الاقتصادية الخاصة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"828":{"id":828,"subject_id":7,"type":"mcq","question_text":"كان هناك تقرير من قسم الأعمال الخارجية: \u0026#34;مؤخرًا، حركة الاستثمار الأجنبي المباشر (FDI) من شركات أجنبية نشطة\u0026#34;. أي مما يلي يصف بأفضل شكل ما ينطبق على هذا الاستثمار؟","image":null,"video":null,"explanation":"الاستثمار الأجنبي المباشر (FDI) هو أن تبني شركة أجنبية مصنعًا أو فرعًا في دولة أخرى وتبدأ فيها أعمالًا طويلة الأمد. الإجابة A. B استثمار في الأوراق المالية، C تصدير، وD شراكة تكنولوجية، كلها تحرّكات تتضمّن شركات أجنبية لكنها مختلفة عن الاستثمار الأجنبي المباشر.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"829":{"id":829,"subject_id":7,"type":"mcq","question_text":"عندما رافقت تفتيشًا ميدانيًا للمصنع، سمعت أنه بفضل التنظيم والترخيص الحكومي، يمكن بيع الطعام بأمان. أي مما يلي يصف بأفضل شكل الدور الذي يلعبه \u0026#34;التنظيم والترخيص\u0026#34; الحكومي؟","image":null,"video":null,"explanation":"التنظيم والترخيص آلية تضع فيها الحكومة قواعد معينة على النشاط التجاري لحفظ سلامة السوق ونزاهته. الإجابة D. A حماية للصناعة المحلية، B جمع ضرائب وإعادة توزيع، وC الحفاظ على منافسة حرة، كلها مختلفة عن دور التنظيم والترخيص.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"830":{"id":830,"subject_id":7,"type":"mcq","question_text":"في عمل بعد الظهر، فكّرت، \u0026#34;عندما تفعل شركة أشياء جيدة للمجتمع، ماذا يحدث من أشياء جيدة للشركة نفسها؟\u0026#34; أي مما يلي يصف بأفضل شكل الميزة التي يجلبها العمل على CSR وESG للشركة؟","image":null,"video":null,"explanation":"العمل على CSR وESG يؤدي إلى ثقة اجتماعية، والميزة للشركة هي أن تصبح أكثر احتمالًا لأن يختارها العملاء والمستثمرون على المدى الطويل. الإجابة D. مفاوضات الأسعار المواتية دائمًا في A، والإيرادات المُتزايدة بالتأكيد في B، وضريبة الشركات الأخف في C، لا شيء منها مضمون، وتختلف عن آثار CSR وESG.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"831":{"id":831,"subject_id":7,"type":"mcq","question_text":"في نهاية عمل بعد الظهر، نظّمت في عقلك العلاقة بين المصنع والحكومة. أي مما يلي هو المثال الأفضل لـ\u0026#34;العلاقة ثنائية الاتجاه\u0026#34; بين الشركات والحكومة؟","image":null,"video":null,"explanation":"العلاقة الداعمة المتبادلة التي تدفع فيها الشركات ضرائب وتقدّم الحكومة بيئة أعمال كالخدمات العامة والمناطق الاقتصادية الخاصة هي العلاقة ثنائية الاتجاه. الإجابة C. الدعم والإعانات في A والقوانين/التنظيمات في B أيضًا جزء من الاتصال، لكن ما يمثّل العلاقة ثنائية الاتجاه بأفضل شكل هو تقديم الخدمات العامة وبيئة الأعمال. علاقة شراء الحكومة المنتجات دائمًا في D لا تصح.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"832":{"id":832,"subject_id":7,"type":"mcq","question_text":"في المساء، بعد إنهاء عمل اليوم، وأنت تحمل قسيمة راتبك، فكّرت، \u0026#34;أي نوع من الدخل هو دخلي هذا؟\u0026#34; ما نوع الدخل الذي يُحصَل عليه مقابل العمل موظَّفًا لدى شركة أو شخص؟","image":null,"video":null,"explanation":"الدخل الذي تحصل عليه مقابل العمل لدى شركة أو شخص يُسمى دخل العمل. الإجابة A. دخل الأعمال في B هو دخل مكتسب من إدارة مشروعك الخاص، ودخل الأصول في C هو دخل مُتولِّد من أصول تحملها كالمدخرات أو الأسهم، ودخل مؤقت في D هو دخل مكتسب مؤقتًا أو عرضيًا، كلها فئات منفصلة عن الدخل المكتسب من العمل موظَّفًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"833":{"id":833,"subject_id":7,"type":"mcq","question_text":"في طريقك للبيت، سمعت حلم مستقبل صديق يريد فتح مقهاه الخاص يومًا ما. أي مما يلي هو التوليفة الأفضل لنوع الدخل الذي يكسبه الصديق إذا شغّل مقهى فعليًا وطريقة حساب المقدار؟","image":null,"video":null,"explanation":"الدخل المكتسب من إدارة مقهاك الخاص هو دخل الأعمال، ويُحسب بطرح النفقات الضرورية من الإيرادات. الإجابة B. A خاطئة لأن نوع الدخل هو دخل الأعمال، C خاطئة لأن طريقة الحساب تطرح فقط تكاليف الشراء، وD نوعها دخل الأصول وطريقة الحساب أيضًا ليست طريقة دخل الأعمال.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"834":{"id":834,"subject_id":7,"type":"mcq","question_text":"بينما تسير، تذكّرت كلمات سمعتها من معرفة، \u0026#34;هناك أيضًا طريقة للكسب بجعل المال يعمل لصالحك\u0026#34;. أي مما يلي هو التوليفة الأفضل لأمثلة \u0026#34;دخل الأصول\u0026#34; التي تناسب هذه الفكرة؟","image":null,"video":null,"explanation":"دخل الأصول دخل مُتولِّد من أصول كالمدخرات والأسهم والعقارات، بالفائدة والتوزيعات ودخل الإيجار كأمثلة عليه. D، التي تُجمِّع هذه، صحيحة. A دخل عمل، B تلخّص عناصر دخل ونفقات الأعمال، لا واحد منهما دخل مُتولِّد من أصول. C تخلط دخل العمل والتحويلات ودخل الأعمال، فالأنواع غير متسقة ولا يمكن تسميتها دخل أصول.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"835":{"id":835,"subject_id":7,"type":"mcq","question_text":"بالنظر إلى الأخبار على هاتفك الذكي، ترى مصطلح \u0026#34;الأجور الحقيقية\u0026#34;. أي مما يلي يفسّر بأفضل شكل الفرق بين \u0026#34;الأجور الاسمية\u0026#34; و\u0026#34;الأجور الحقيقية\u0026#34;؟","image":null,"video":null,"explanation":"الأجور الاسمية هي قيمة الراتب نفسها، بينما الأجور الحقيقية تعكس مقدار السلع والخدمات التي يمكنك شراؤها بهذا الراتب. الإجابة B. A عن قبل وبعد الضرائب، C عن تفصيل الراتب، كلاهما نقاط منفصلة عن الفرق الاسمي/الحقيقي، وD خاطئة لأنهما يختلفان بالعلاقة بالأسعار.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"836":{"id":836,"subject_id":7,"type":"mcq","question_text":"بينما تتحدث مع صديق قابلته في المحطة في طريقك للبيت، شكا، \u0026#34;مؤخرًا، ارتفع راتبي قليلًا، لكنني أشعر أن الأشياء التي أستطيع شراءها لم تزد كثيرًا\u0026#34;. أي مما يلي يفسّر بأفضل شكل هذا الوضع؟","image":null,"video":null,"explanation":"ارتفاع الراتب دون زيادة في الكمية التي يمكنك شراؤها يعني أن ارتفاع الأسعار تجاوز ارتفاع الأجور الاسمية، فلم تنمُ الأجور الحقيقية. الإجابة C. A وB وD تتشارك أيضًا أن الراتب ارتفع، لكنها عن ساعات العمل والراتب الفعلي والمدخرات على التوالي، بينما C، التي تفسّر \u0026#34;الكمية القابلة للشراء لا تزيد\u0026#34; بالعلاقة بالأسعار، هي الأصح.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"837":{"id":837,"subject_id":7,"type":"mcq","question_text":"الصديق الذي قابلته في المحطة يعمل عادة بالخارج ويرسل جزءًا من المال الذي يكسبه لأسرته في البيت. أي مما يلي يصف بأفضل شكل هذه \u0026#34;التحويلات\u0026#34;؟","image":null,"video":null,"explanation":"التحويلات مال يرسله شخص عامل بالخارج لأسرته في البيت، وعند تراكمه، يصبح عمودًا لدخل الدولة من العملة الأجنبية. الإجابة D. A فقط نقل أصوله الخاصة، B دفع للخارج (كتكاليف الاستيراد)، وC تجارة صرف أجنبي، كلها أنشطة اقتصادية منفصلة عن التحويلات.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"838":{"id":838,"subject_id":7,"type":"mcq","question_text":"بالنظر إلى قسيمة راتبك في القطار عائدًا للبيت، كانت الأجور الاسمية (الراتب الإجمالي) ١٠٬٠٠٠ جنيه. من هذا، يُطرَح ١٬٥٠٠ جنيه ضرائب و٥٠٠ جنيه اشتراكات تأمين اجتماعي. أي مما يلي هو التوليفة الأفضل لإجمالي المقدار المطروح والمقدار المتبقي في اليد (الدخل المتاح للتصرف)؟","image":"image_2_8_4_ar.png","video":null,"explanation":"إجمالي المبلغ المطروح هو ١٬٥٠٠ جنيه من الضرائب + ٥٠٠ جنيه من اشتراكات التأمين الاجتماعي = ٢٬٠٠٠ جنيه، والمبلغ المتبقي هو ١٠٬٠٠٠ − ٢٬٠٠٠ = ٨٬٠٠٠ جنيه. الإجابة C. A نسي طرح الضرائب، B نسي طرح اشتراكات التأمين الاجتماعي، وD أضاف المقدار المطروح للقيمة الاسمية، كلها حسابات خاطئة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"839":{"id":839,"subject_id":7,"type":"mcq","question_text":"القيمة الاسمية (الأجر الاسمي) للراتب في قسيمتك لم تتغيّر منذ الشهر الماضي. في الوقت نفسه، ارتفعت الأسعار خلال هذه الفترة. في هذا الوقت، ماذا يُعتبَر حدث للأجور الحقيقية؟","image":null,"video":null,"explanation":"الأجور الحقيقية هي الأجر المرئي بمقدار ما تستطيع شراءه فعليًا بالقيمة الاسمية (الأجر الاسمي)، مع أخذ حركة الأسعار بالحسبان. حتى إذا كانت القيمة الاسمية نفسها، إذا ارتفعت الأسعار، تنخفض الكمية القابلة للشراء، فتُعتبَر الأجور الحقيقية قد انخفضت، والإجابة B. A تتجاهل تأثير الأسعار، C بها الصعود والنزول معكوسان، وD تتجاهل أن الأجور الحقيقية مرتبطة بالأسعار، كلها خاطئة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"840":{"id":840,"subject_id":7,"type":"mcq","question_text":"بعد التسوّق في طريقك للبيت من العمل وعند وصولك للبيت، تنفّست وبدأت تفكّر في ميزانية الأسرة لهذا الشهر. أي مما يلي هو التوليفة الأفضل للتمييز بين \u0026#34;التكاليف الثابتة\u0026#34; و\u0026#34;التكاليف المتغيّرة\u0026#34; ضمن نفقات الأسرة؟","image":null,"video":null,"explanation":"التكاليف الثابتة نفقات تخرج بمقدار متساوٍ تقريبًا كل شهر (الإيجار، ورسوم الاتصالات، وأقساط التأمين)، والتكاليف المتغيّرة نفقات يتغيّر مقدارها حسب الشهر (الطعام، والترفيه، والنقل). A، التي تقسّمها بشكل صحيح، هي الإجابة. B بها التكاليف الثابتة والمتغيّرة معكوسة تمامًا. C وD تخلطان بشكل خاطئ الطعام (يجب أن يكون متغيّرًا) في التكاليف الثابتة، أو رسوم الاتصالات وأقساط التأمين (ثابتة) في المتغيّرة، تصنيف خاطئ.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"841":{"id":841,"subject_id":7,"type":"mcq","question_text":"راجعت بيان ميزانية الأسرة لهذا الشهر. بناءً على بيان ميزانية الأسرة أعلاه، ما مقدار المدخرات هذا الشهر؟","image":"image_2_8_5_ar.png","video":null,"explanation":"يُحسب مقدار المدخرات بطرح إجمالي النفقات من الدخل المتاح للتصرف. إجمالي النفقات ٢٬٠٠٠+٥٠٠+٥٠٠+٢٬٥٠٠+٧٠٠+٨٠٠=٧٬٠٠٠، فـ٨٬٠٠٠−٧٬٠٠٠=١٬٠٠٠، والإجابة C. A الدخل والنفقات مجموعين معًا، B إجمالي النفقات نفسه، وD الدخل نفسه، لا شيء منها مقدار المدخرات.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"842":{"id":842,"subject_id":7,"type":"mcq","question_text":"تحقّقت من تفصيل نفقات هذا الشهر مرة أخرى. من بين النفقات في بيان ميزانية الأسرة أعلاه، عندما تجمع فقط التكاليف الثابتة، أي نسبة تقريبية تحتلّها من إجمالي النفقات؟","image":"image_2_8_6_ar.png","video":null,"explanation":"التكاليف الثابتة هي الإيجار، ورسوم الاتصالات، وأقساط التأمين التي تخرج بمقدار متساوٍ تقريبًا كل شهر، إجماليها ٢٬٠٠٠+٥٠٠+٥٠٠=٣٬٠٠٠. نسبتها من إجمالي النفقات ٧٬٠٠٠ هي ٣٬٠٠٠/٧٬٠٠٠، حوالي ٤٣%، والإجابة A. B نسبة التكاليف المتغيّرة (٤٬٠٠٠)، وC وD أرقام من الخلط بين البسط والمقام، لا شيء منها النسبة الصحيحة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"843":{"id":843,"subject_id":7,"type":"mcq","question_text":"بالنظر إلى بيان ميزانية الأسرة، تساءلت، \u0026#34;كم من دخلي أستخدم؟\u0026#34; عندما كان الدخل المتاح للتصرف لشهر معين ٢٠٬٠٠٠ جنيه، منه ١٥٬٠٠٠ جنيه للاستهلاك و٥٬٠٠٠ جنيه للادّخار، ما أقرب \u0026#34;ميل للاستهلاك\u0026#34; لهذا الشهر؟","image":null,"video":null,"explanation":"الميل للاستهلاك هو نسبة الدخل الموضوعة نحو الاستهلاك. ١٥٬٠٠٠/٢٠٬٠٠٠=٠٫٧٥، فحوالي ٧٥%، والإجابة C. A نسبة الموضوعة نحو المدخرات، B نصف الدخل، وD النسبة إذا استُهلِك كل الدخل، لا شيء منها الميل للاستهلاك لهذا الشهر.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"844":{"id":844,"subject_id":7,"type":"mcq","question_text":"في المساء، فكّرت في كيفية استخدام وقت فراغك. تستطيع استخدام هذه الساعة الواحدة لعمل قصير بأجر ١٥٠ جنيهًا في الساعة، أو استخدام نفس الساعة للدراسة. إذا اخترت الدراسة، أي مما يلي يصف بأفضل شكل القيمة التي تنازلت عنها لهذا الخيار؟","image":null,"video":null,"explanation":"عندما تتخذ خيارًا، القيمة التي كنت تستطيع الحصول عليها من الخيار الذي لم تخترْه هي القيمة المُتنازَل عنها بذلك الاختيار. هنا، باختيار الدراسة، تنازلت عن دخل ١٥٠ جنيهًا الذي كنت ستكسبه لو اخترت العمل، والإجابة D. A تتجاهل القيمة المُتنازَل عنها، B تخلط القيمة المُتنازَل عنها بـ\u0026#34;تكلفة مدفوعة\u0026#34;، وC تتجاهل أن اختيار واحد يعني عدم إمكانية استخدام وقت الآخر.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"845":{"id":845,"subject_id":7,"type":"mcq","question_text":"تذكّرت سماع، \u0026#34;إذا كنت تراجع ميزانية الأسرة، جيد أن تبدأ بالتكاليف الثابتة الشهرية\u0026#34;. أي مما يلي يفسّر بأفضل شكل لماذا تُعتبَر مراجعة التكاليف الثابتة فعّالة لتحسين ميزانية الأسرة؟","image":null,"video":null,"explanation":"بما أن التكاليف الثابتة تخرج بمقدار متساوٍ تقريبًا كل شهر، بمجرد مراجعتها، يستمر أثر الادّخار ويدوم طويلًا. الإجابة A. B تخلط بين التكاليف الثابتة والضرائب خطأً، C خاطئة لأن التكاليف الثابتة ليست بالضرورة أكبر من التكاليف المتغيّرة، وD خاطئة لأن مراجعة التكاليف الثابتة لا تزيد الدخل تلقائيًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"846":{"id":846,"subject_id":7,"type":"mcq","question_text":"بالتفكير في اليوم، فكّرت في كيف تتصل ميزانية أسرتك باقتصاد الدولة كلها. وفقًا لوثيقة واحدة، كان توزيع الناتج المحلي الإجمالي لمصر: استهلاك شخصي حوالي ٦٠%، واستثمار شركات حوالي ٢٠%، وإنفاق حكومي حوالي ١٥%، وصافي صادرات حوالي ٥%. من هذه الأرقام، أي مما يلي يفسّر بأفضل شكل الدور الذي يلعبه الاستهلاك الشخصي في الناتج المحلي الإجمالي؟","image":null,"video":null,"explanation":"في الأرقام المُظهَرة، الاستهلاك الشخصي حوالي ٦٠%، أكبر من أي عنصر آخر، ويمكن قراءته كأنه يحتلّ أكبر نسبة ضمن الناتج المحلي الإجمالي ويدعم الاقتصاد كله. الإجابة B. A خاطئة لأن الاستهلاك الشخصي عنصر رئيسي في الناتج المحلي الإجمالي، C تتناقض مع كونه أكبر نسبة، وD خاطئة لأن الاستهلاك الشخصي (حوالي ٦٠%) والإنفاق الحكومي (حوالي ١٥%) يختلفان كثيرًا في النسبة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"847":{"id":847,"subject_id":7,"type":"mcq","question_text":"بقراءة الجريدة الاقتصادية قبل العشاء، قُدِّمت ظاهرة اقتصادية معينة. المحتوى: \u0026#34;عندما تبدأ كل الأسر بالادّخار دفعة واحدة، الاستهلاك الشخصي ( ① )، وإيرادات الشركات ( ② )، والشركات ( ③ ) التوظيف والأجور، فينخفض دخل الأسر أيضًا ويصبح ادّخار أكثر ضروريًا\u0026#34;. أي مما يلي هو التوليفة الأفضل للكلمات من ① إلى ③؟","image":null,"video":null,"explanation":"عندما يدّخر الجميع دفعة واحدة، ينخفض الاستهلاك الشخصي، وتنخفض إيرادات الشركات، وتُقلِّص الشركات التوظيف والأجور، فينخفض دخل الأسر أيضًا ويصبح ادّخار أكثر ضروريًا. يُسمى هذا مفارقة الادّخار، والإجابة A، \u0026#34;ينخفض، ينخفض، تقلّص\u0026#34;. B وC وD بها واحد من ① إلى ③ في الاتجاه المعكوس، لا تتطابق مع تسلسل تبريد الاقتصاد.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"848":{"id":848,"subject_id":7,"type":"mcq","question_text":"بتشغيل التلفاز بينما تتناول العشاء، عُرِضت \u0026#34;تحويلات\u0026#34; مصر. إذا انخفضت هذه التحويلات بشكل كبير، ما التأثير الأكثر احتمالًا على اقتصاد مصر؟","image":null,"video":null,"explanation":"التحويلات تمثل أحد المصادر الرئيسية للعملة الأجنبية في مصر، وإذا انخفضت بشكل كبير، تنخفض العملة الأجنبية الداخلة إلى الدولة، ويتراجع أحد مصادر الدخل بالعملة الأجنبية. الإجابة C. A تتناقض بقولها تزداد عندما تنخفض، B تتجاهل أن التحويلات الفردية تتراكم لتؤثر على الدولة كلها، وD خاطئة لأن التحويلات ليست تحت إدارة حكومية مباشرة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"849":{"id":849,"subject_id":7,"type":"mcq","question_text":"بعد إنهاء الوجبة ومشاهدة التلفاز بينما تغسل الأطباق، عُرِض الاقتصاد الأخير. بسبب تراجع الأحوال الاقتصادية، الاستثمار الرأسمالي للشركات واستهلاك الأسر يتراجعان. عندما تريد الحكومة منع تقلّص النشاط الاقتصادي أكثر، أي سياسة هي الأنسب لهذا الغرض؟","image":null,"video":null,"explanation":"لمنع التراجع الاقتصادي، سياسة دعم نشاط الأسر والشركات وتخفيف التراجع في الاستهلاك والاستثمار مناسبة. الإجابة B. إيقاف التجارة في A، واستبدال الصفقات في C، وجمع وإعادة توزيع ربح الشركات بالكامل في D، كلها غير مناسبة لغرض منع التقلّص وستُلقي الاقتصاد في فوضى بدلًا من ذلك.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"850":{"id":850,"subject_id":7,"type":"mcq","question_text":"بالتفكير في تجربة اليوم، فكّرت في كيفية استخدام ربح الشركة الذي ستكسبه إذا بدأت مشروعًا تجاريًا في المستقبل. ما الطريقة الأكثر استحسانًا لاستخدامه؟","image":null,"video":null,"explanation":"لا يجب أن يُوجَّه ربح الشركة نحو هدف محدَّد واحد فقط. تخصيصه بشكل واسع للاستثمار المستقبلي والعوائد للأطراف المتورطة كالمساهمين والموظفين والمجتمع المحلي هو الأكثر استحسانًا. الإجابة D. مدخرات الشركة (الأرباح المحتجزة) في A، وتوزيعات الأرباح للمساهمين في B، والتعويضات لنفسك في C، كلها استخدامات مهمة، لكن بما أنها تُوجِّه \u0026#34;معظم\u0026#34; ربح الشركة لمكان واحد فقط، مقارنة بد، التي لها منظور شامل، لا يمكن تسميتها الأكثر استحسانًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"851":{"id":851,"subject_id":7,"type":"mcq","question_text":"قبل النوم، فكّرت في إدارة مال الشركة وميزانية الأسرة الشخصية إذا بدأت وشغّلت شركتك الخاصة في المستقبل. ما هو الفعل الأكثر عدم ملاءمة لصاحب مشروع تجاري؟","image":null,"video":null,"explanation":"يجب الفصل تمامًا بين أموال الشركة والميزانية الشخصية للأسرة، وحتى لو كنت تنوي إعادته لاحقًا، فعل تحويل إيرادات الشركة للتسوّق الشخصي غير مناسب. الإجابة C. A وB وD كلها أفعال مناسبة لترسيم الحدود بوضوح بين أموال الشركة والحياة الشخصية، وإدارة المال بصورة صحيحة ضمن كل نطاق.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null}},"options":{"802":[{"id":3205,"question_id":802,"subject_id":7,"sort_order":1,"text":"شركة تكنولوجيا معلومات صغيرة بدأها صديقان","image":null,"video":null},{"id":3206,"question_id":802,"subject_id":7,"sort_order":2,"text":"سلسلة مطاعم تديرها شركة كبرى","image":null,"video":null},{"id":3207,"question_id":802,"subject_id":7,"sort_order":3,"text":"بقالة محلية تديرها أسرة من ثلاثة أفراد","image":null,"video":null},{"id":3208,"question_id":802,"subject_id":7,"sort_order":4,"text":"مرفق مياه تديره الحكومة الوطنية أو المحلية","image":null,"video":null,"is_correct":true}],"803":[{"id":3209,"question_id":803,"subject_id":7,"sort_order":1,"text":"شكل مُسجَّل كشركة ويُعامَل كيانًا منفصلًا عن الفرد","image":null,"video":null},{"id":3210,"question_id":803,"subject_id":7,"sort_order":2,"text":"شكل يدير فيه فرد المشروع، ويعود كل من الدخل المكتسب والديون إلى الفرد بالكامل","image":null,"video":null,"is_correct":true},{"id":3211,"question_id":803,"subject_id":7,"sort_order":3,"text":"شكل من المنشآت العامة تموّله وتديره الحكومة الوطنية أو المحلية للمصلحة العامة","image":null,"video":null},{"id":3212,"question_id":803,"subject_id":7,"sort_order":4,"text":"شكل شركة تُصدر أسهمًا لجمع أموال من أشخاص كثيرين لتشغيلها","image":null,"video":null}],"804":[{"id":3213,"question_id":804,"subject_id":7,"sort_order":1,"text":"شكل شركة يتحمّل فيه كل المستثمرين مسؤولية غير محدودة","image":null,"video":null},{"id":3214,"question_id":804,"subject_id":7,"sort_order":2,"text":"شكل شركة يتحمّل فيه بعض المستثمرين مسؤولية غير محدودة","image":null,"video":null},{"id":3215,"question_id":804,"subject_id":7,"sort_order":3,"text":"شكل يتحمّل فيه كل المستثمرين مسؤولية فقط بحدود استثمارهم","image":null,"video":null,"is_correct":true},{"id":3216,"question_id"