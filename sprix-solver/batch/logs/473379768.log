ة، والبنوك ليست مُضمَّنة هنا.\u003c/li\u003e\u003cli\u003eB: صحيح!\u003c/li\u003e\u003cli\u003eC: الأطراف الثلاثة للدورة الاقتصادية هي الأسر والشركات والحكومة. هنا، بدلًا من البنوك، الأسر، اللاتي يشترين منتجات ويدفعن ضرائب، مُضمَّنة.\u003c/li\u003e\u003cli\u003eD: الأطراف الثلاثة للدورة الاقتصادية هي الأسر والشركات والحكومة. هنا، بدلًا من الخارج، الشركات، التي تصنع وتبيع السلع والخدمات، مُضمَّنة.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"863":{"id":863,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يصف بأفضل شكل الطرق الثلاث لقياس الناتج المحلي الإجمالي؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: شرح أن مؤشرات متعددة كالناتج المحلي الإجمالي (إجمالي القيمة المُنتَجة محليًا في سنة واحدة) دائمًا بنفس القيمة. الطرق الثلاث لقياس الناتج المحلي الإجمالي فكرة رؤية نفس الحركة الاقتصادية الواحدة من ثلاثة منظورات: الإنتاج، والدخل، والإنفاق، وتخرج بنفس الإجمالي.\u003c/li\u003e\u003cli\u003eB: شرح أن الأسر والشركات والحكومة تستخدم المال بنفس النسبة. الطرق الثلاث لقياس الناتج المحلي الإجمالي ليست عن مطابقة النسب، بل فكرة رؤية نفس الحركة الواحدة من ثلاثة منظورات تعطي نفس الإجمالي.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: شرح لآلية مختلفة يتوازن فيها العرض والطلب في السوق لتحديد السعر. الطرق الثلاث لقياس الناتج المحلي الإجمالي عن رؤية حركة الاقتصاد كله من ثلاثة منظورات وأن الإجماليات متساوية.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"864":{"id":864,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يصف بأفضل شكل أثر المضاعف؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: صحيح!\u003c/li\u003e\u003cli\u003eB: بما أن الشخص الذي يستلم المال يحتفظ ببعضه في يده كل مرة، المقدار المُمرَّر للتالي يصغر تدريجيًا. تصبح الحركة للمجتمع بأكمله أكبر من الأول، لكنها لا تستمر في الزيادة بلا نهاية.\u003c/li\u003e\u003cli\u003eC: شرح أقرب للوظيفة التي تُعيد فيها الحكومة المال المُجمَّع كضرائب للمجتمع كخدمات عامة. أثر المضاعف هو الحركة التي تنتقل فيها دورة واحدة من الصرف من شخص لآخر واحدة تلو الأخرى وتنتشر للمجتمع بأكمله.\u003c/li\u003e\u003cli\u003eD: شرح لآلية تُقسِّم فيها شركة وتدفع جزءًا من ربحها للأشخاص الذين قدّموا مالًا. أثر المضاعف يشير إلى الحركة التي يتسلسل فيها الصرف وينتشر واحدًا تلو الآخر عبر المجتمع بأكمله.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"865":{"id":865,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يصف بأفضل شكل سلسلة التوريد؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: شرح لتدفق إقراض واقتراض المال، حيث يُقرَض المال الذي أودعته الأسر في بنك للشركات. سلسلة التوريد هي تدفق \u0026#34;الأشياء\u0026#34; من المواد الخام حتى يصل المنتج للمستهلك.\u003c/li\u003e\u003cli\u003eB: شرح \u0026#34;إكمال ذاتي\u0026#34;، حيث تتعامل شركة واحدة مع كل شيء من التطوير إلى البيع داخليًا. سلسلة التوريد تدفق تتورط فيه شركات متعددة في سلسلة بينما تتشارك كل مرحلة.\u003c/li\u003e\u003cli\u003eC: شرح للعلاقة بين الشركات والحكومة، حيث تجمع الحكومة ضرائب وتقدّم خدمات عامة. سلسلة التوريد تدفق تتصل فيه الشركات في مراحل صنع الأشياء.\u003c/li\u003e\u003cli\u003eD: صحيح!\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"866":{"id":866,"subject_id":7,"type":"mcq","question_text":"أي مما يلي هي المعادلة الصحيحة لحساب القيمة المضافة؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: حساب يقسّم الإيرادات على عدد الموظفين لرؤية الإيرادات لكل موظف. تُحسب القيمة المضافة من خلال\u0026#34;سعر البيع مطروحًا منه تكلفة الشراء\u0026#34;.\u003c/li\u003e\u003cli\u003eB: صحيح!\u003c/li\u003e\u003cli\u003eC: المقدار الإجمالي لربح الشركة زائد الضريبة ليس حساب القيمة المضافة.\u003c/li\u003e\u003cli\u003eD: المقدار المتبقي بعد طرح الضريبة من الإيرادات ليس حساب القيمة المضافة.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"867":{"id":867,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يصف بأفضل شكل تقسيم العمل الدولي؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: صحيح!\u003c/li\u003e\u003cli\u003eB: شرح لآلية تشارك العمل حسب المنطقة داخل نفس الدولة. تقسيم العمل الدولي آلية تتخصّص فيها الدول في ما تتميّز فيه.\u003c/li\u003e\u003cli\u003eC: شرح غير صحيح؛ تقسيم العمل الدولي لا يتعلق بتخصيص الحكومة للعمل.\u003c/li\u003e\u003cli\u003eD: هذا عكس تقسيم العمل الدولي، حيث تتشارك دول متعددة العمل بدلًا من إكمال دولة واحدة كل شيء.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"868":{"id":868,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يصف بأفضل شكل الاستعانة بمصادر خارجية؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: شرح لـ\u0026#34;الاستثمار الأجنبي المباشر (FDI)\u0026#34;، حيث تبني شركة من الخارج مصنعًا أو مكتبًا في دولة أخرى وتبدأ أعمالًا. الاستعانة بمصادر خارجية آلية لترك العمل لشركات خارجية.\u003c/li\u003e\u003cli\u003eB: هذا عن التدريب الداخلي، ليس الاستعانة بمصادر خارجية.\u003c/li\u003e\u003cli\u003eC: هذا عن إذن الحكومة، ليس الاستعانة بمصادر خارجية.\u003c/li\u003e\u003cli\u003eD: صحيح!\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"869":{"id":869,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يصف بأفضل شكل الفرق بين ضريبة الشركات وضريبة الدخل؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: صحيح!\u003c/li\u003e\u003cli\u003eB: تُدفَع ضريبة الشركات من جزء من ربح الشركة، وضريبة الدخل من جزء من دخل الفرد العامل. لا يدفعان كل الإيرادات أو كل الراتب.\u003c/li\u003e\u003cli\u003eC: هذا وصف خاطئ لكل من ضريبة الشركات وضريبة الدخل.\u003c/li\u003e\u003cli\u003eD: هذا وصف خاطئ؛ كلاهما ضريبتان مستمرتان، ليس دفعة واحدة.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"870":{"id":870,"subject_id":7,"type":"mcq","question_text":"أي مما يلي هو المثال الأفضل لـ\u0026#34;التنظيم والترخيص\u0026#34; الحكومي؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: شرح لطريقة دفع الشركة الراتب للموظفين. التنظيم والترخيص آلية للحصول على إذن وفقًا لقواعد تضعها الحكومة، منفصلة عن ذلك.\u003c/li\u003e\u003cli\u003eB: صحيح!\u003c/li\u003e\u003cli\u003eC: هذا عن اتفاق تعاقدي بين الشركات، ليس التنظيم والترخيص.\u003c/li\u003e\u003cli\u003eD: هذا عن توزيعات الأرباح، ليس التنظيم والترخيص.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"871":{"id":871,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يصف بأفضل شكل آلية المناطق الاقتصادية الخاصة والاستثمار الأجنبي المباشر (FDI)؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: المنطقة الاقتصادية الخاصة منطقة تُنشَأ لجلب شركات أجنبية للدولة. ليست آلية لإرسال شركات محلية للخارج.\u003c/li\u003e\u003cli\u003eB: الجهة التي تُنشئ منطقة اقتصادية خاصة هي حكومة الدولة المُستقبِلة، ليس الشركة الأجنبية. تُنشَأ لجلب شركات أجنبية بإعطاء معاملة تفضيلية على الضرائب والقواعد.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: المنطقة الاقتصادية الخاصة هي \u0026#34;منطقة محلية خاصة تُعطى فيها معاملة تفضيلية على الضرائب والقواعد\u0026#34;، وFDI هو \u0026#34;آلية تدخل فيها شركة من الخارج الدولة وتبني مصنعًا أو مكتبًا لبدء أعمال\u0026#34;. المنطقة ليست منطقة بضرائب مرتفعة.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null}},"options":{"862":[{"id":3445,"question_id":862,"subject_id":7,"sort_order":1,"text":"الأسر، والبنوك، والشركات","image":null,"video":null},{"id":3446,"question_id":862,"subject_id":7,"sort_order":2,"text":"الأسر، والشركات، والحكومة","image":null,"video":null,"is_correct":true},{"id":3447,"question_id":862,"subject_id":7,"sort_order":3,"text":"الشركات، والحكومة، والبنوك","image":null,"video":null},{"id":3448,"question_id":862,"subject_id":7,"sort_order":4,"text":"الأسر، والحكومة، والخارج","image":null,"video":null}],"863":[{"id":3449,"question_id":863,"subject_id":7,"sort_order":1,"text":"المبدأ القائل بأن الناتج المحلي الإجمالي والمؤشرات الاقتصادية المتعددة المرتبطة به دائمًا بنفس القيمة بالضبط","image":null,"video":null},{"id":3450,"question_id":863,"subject_id":7,"sort_order":2,"text":"المبدأ القائل بأن، ضمن الاقتصاد كله، الأطراف الثلاثة للأسر والشركات والحكومة تصنع نفس نسبة الصرف","image":null,"video":null},{"id":3451,"question_id":863,"subject_id":7,"sort_order":3,"text":"المبدأ القائل بأن عندما تنظر إلى حركة الاقتصاد كله من ثلاثة منظورات، الإجماليات دائمًا بنفس الحجم","image":null,"video":null,"is_correct":true},{"id":3452,"question_id":863,"subject_id":7,"sort_order":4,"text":"القانون القائل بأنه في اقتصاد السوق، يتوازن العرض والطلب لتحديد السعر، مُثبَّت من ثلاثة","image":null,"video":null}],"864":[{"id":3453,"question_id":864,"subject_id":7,"sort_order":1,"text":"ظاهرة تت