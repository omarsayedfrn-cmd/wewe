حسب المدة، ليس أغراض المدخرات نفسها.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: هذا خطأ يخلط بينها والتكاليف الثابتة والمتغيّرة، ليس توليفة الأغراض الثلاثة للمدخرات.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"989":{"id":989,"subject_id":7,"type":"mcq","question_text":"أي مصدر مالي تستخدمه عندما يتعطّل جهاز بشكل مفاجئ يومًا ويحتاج تكلفة إصلاح عاجلة؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: صحيح!\u003c/li\u003e\u003cli\u003eB: أموال التقاعد غرض ادّخاري لتكاليف المعيشة بعد أن تتقدّم في السن وتتوقّف عن العمل.\u003c/li\u003e\u003cli\u003eC: أموال الأهداف غرض ادّخاري للادّخار المنهجي نحو هدف محدَّد، كرحلة أو تعليم عالٍ.\u003c/li\u003e\u003cli\u003eD: لا توجد فئة \u0026#34;أموال ضريبية\u0026#34; ضمن الأغراض الثلاثة للمدخرات.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"990":{"id":990,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يفسّر بأفضل شكل الفرق بين الادّخار والاستثمار؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: للادّخار استقرار عدم تقلّص أصل المبلغ كثيرًا، مختلف في طبيعته عن الاستثمار.\u003c/li\u003e\u003cli\u003eB: الادخار والاستثمار يختلفان في طبيعتهما، وليسا الشيء نفسه بالضبط.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: النمو الكبير في وقت قصير ليس طبيعة الادّخار، والادّخار قليلًا قليلًا على مدى طويل ليس طبيعة الاستثمار.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"991":{"id":991,"subject_id":7,"type":"mcq","question_text":"من بين طرق حساب الفائدة، ماذا تُسمى الآلية التي يُطبَّق فيها سعر محدَّد فقط على أصل المبلغ ويكون المقدار الذي ينمو نفسه كل سنة؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: صحيح!\u003c/li\u003e\u003cli\u003eB: قاعدة ٧٢ طريقة لتقدير سنوات تضاعف المال تقريبًا بالفائدة المركبة (٧٢ ÷ معدل النمو (%) هي تقريبًا سنوات التضاعف)، ليست اسمًا لكيفية نمو المال نفسها.\u003c/li\u003e\u003cli\u003eC: الاستثمار هو استخدام المال لمحاولة تنميته، ليس اسمًا لطريقة حساب فائدة.\u003c/li\u003e\u003cli\u003eD: الفائدة المركبة آلية ينضم فيها النمو لأصل المبلغ وينمو مرة أخرى بنفس السعر على ذلك المجموع.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"992":{"id":992,"subject_id":7,"type":"mcq","question_text":"عند إدارة ١٬٠٠٠ جنيه بـ٥% في السنة، باستخدام قاعدة ٧٢، أي مما يلي أقرب لعدد السنوات التقريبي حتى يتضاعف إلى ٢٬٠٠٠ جنيه بالفائدة المركبة؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: حوالي ٢٠ سنة هي الدليل للتضاعف بحوالي ٣٫٦% في السنة. ٧٢ ÷ ٣٫٦ = ٢٠.\u003c/li\u003e\u003cli\u003eB: صحيح!\u003c/li\u003e\u003cli\u003eC: حوالي ٣٦ سنة هي الدليل للتضاعف بحوالي ٢% في السنة. ٧٢ ÷ ٢ = ٣٦.\u003c/li\u003e\u003cli\u003eD: حوالي ٧ سنوات هي الدليل للتضاعف بحوالي ١٠% في السنة. ٧٢ ÷ ١٠ = ٧٫٢.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"993":{"id":993,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يفسّر بأفضل شكل الفرق بين الفائدة الثابتة والمركبة؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: حجم أصل المبلغ والفرق الأساسي بين الثابتة والمركبة مسألتان منفصلتان.\u003c/li\u003e\u003cli\u003eB: صحيح!\u003c/li\u003e\u003cli\u003eC: الفرق بين الثابتة والمركبة صغير على المدى القصير ويكبر كلما مرّ وقت أكثر.\u003c/li\u003e\u003cli\u003eD: كلما طال الوقت، يتوسّع الفرق بين الثابتة والمركبة أكثر.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"994":{"id":994,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يفسّر بأفضل شكل الآلية الأساسية للتأمين؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: هذا أقرب للاحتفاظ بمدخرات فردية، ليس آلية التأمين.\u003c/li\u003e\u003cli\u003eB: جمع المال قبل سوء الحظ هي خاصية التأمين؛ جمعه بعد الحدوث ليس آلية التأمين.\u003c/li\u003e\u003cli\u003eC: هذا أقرب للادّخار المسبق، ليس آلية التأمين.\u003c/li\u003e\u003cli\u003eD: صحيح!\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"995":{"id":995,"subject_id":7,"type":"mcq","question_text":"للتحضير للمخاطر، هناك ثلاث طبقات: المساعدة الذاتية، والتعاضد، والمساعدة العامة. من بين ① إلى ⑥ التالية، أي توليفة تُحسَب مساعدة عامة؟\n① صندوق طوارئ مُدَّخَر في حسابك الخاص للمصروفات المفاجئة\n② تأمين صحي مُموَّل بأقساط تُخصَم تلقائيًا من الراتب\n③ تأمين حياة يسجّل فيه النظراء بوضع أقساط معًا\n④ معاش تديره الدولة، يجب على من يستوفون شروطًا محدَّدة التسجيل فيه\n⑤ تأمين سيارات تتعاقد عليه طوعًا، تختار شروطه بنفسك\n⑥ مدخرات تبنيها بمالك الخاص تحضيرًا للشيخوخة","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: ② مساعدة عامة، لكن ⑤ (تأمين سيارات) تأمين خاص تختار التسجيل فيه، وهو \u0026#34;تعاضد\u0026#34;، فهي خاطئة.\u003c/li\u003e\u003cli\u003eB: ③ (تأمين حياة) \u0026#34;تعاضد\u0026#34; يدعم فيه النظراء بعضهم بعضًا، و⑥ (مدخرات تبنيها بنفسك) \u0026#34;مساعدة ذاتية\u0026#34;، فلا واحدة منهما مساعدة عامة.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: ④ مساعدة عامة، لكن ① (صندوق الطوارئ) \u0026#34;مساعدة ذاتية\u0026#34; تحضّرها بنفسك، فهي خاطئة.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"996":{"id":996,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يصف بأفضل شكل خاصية التكافل؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: هذا يصف التأمين العام؛ التكافل ليس آلية تديرها الدولة.\u003c/li\u003e\u003cli\u003eB: صحيح!\u003c/li\u003e\u003cli\u003eC: هذا يصف التأمين الخاص العادي، الذي يختلف عن التكافل في فكرة تشغيله.\u003c/li\u003e\u003cli\u003eD: هذا يصف ادّخارًا دوريًا يستلم فيه الجميع بالتناوب؛ يختلف التكافل في أن من ضربه سوء الحظ يستلم التعويض.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null},"997":{"id":997,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يطابق بأفضل شكل موقفًا مع التحضير الفعّال له (المساعدة الذاتية، والتعاضد، والمساعدة العامة)؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: صحيح!\u003c/li\u003e\u003cli\u003eB: المصروفات الصغيرة اليومية لها مقادير متوقَّعة يمكن دفعها من مدخراتك الخاصة، فالمساعدة الذاتية تناسبها. تأمينها يُراكِم أقساطًا وينتهي أكثر تكلفة.\u003c/li\u003e\u003cli\u003eC: تكاليف المعيشة الأساسية للشيخوخة التي يصل إليها الجميع تُؤسَّس على مساعدة عامة كالمعاشات العامة، يدعمها المجتمع بأكمله. المساعدة الذاتية وحدها لا تستطيع استدامتها.\u003c/li\u003e\u003cli\u003eD: الضرر من حريق في بيت فرد يُحضَّر له بتعاضد يُتشارَك بين كثيرين، كتأمين الحريق. الدولة أو الهيئات العامة لا تدفع تكلفة إعادة البناء.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:18Z","updated_at":null}},"options":{"988":[{"id":3949,"question_id":9