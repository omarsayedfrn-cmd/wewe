ل.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: الدخل غير المكتسب دخل يُكسَب دون عمل، عكس دخل العمل المكتسب من العمل والوظيفة تمامًا.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"873":{"id":873,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يصف بأفضل شكل الفرق بين الأجر الاسمي والأجر الحقيقي؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: صحيح!\u003c/li\u003e\u003cli\u003eB: التمييز بين قبل/بعد الضريبة ليس الفرق بين الاسمي والحقيقي.\u003c/li\u003e\u003cli\u003eC: الأمر لا يتعلق بمكونات الراتب (الأساسي، البدلات) بل يتعلق بالعلاقة بالأسعار.\u003c/li\u003e\u003cli\u003eD: الأمر ليس تمييز المجموعة مقابل الفرد، بل الفرق في ما إذا كانت الأسعار مأخوذة بالحسبان.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"874":{"id":874,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يصف بأفضل شكل موقع التحويلات في اقتصاد مصر؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: ليست مال مساعدات للخارج، بل تحويلات من الخارج للبيت.\u003c/li\u003e\u003cli\u003eB: إيرادات السياحة منفصلة عن التحويلات.\u003c/li\u003e\u003cli\u003eC: مفهوم منفصل عن مدخرات الحكومة بالخارج.\u003c/li\u003e\u003cli\u003eD: صحيح!\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"875":{"id":875,"subject_id":7,"type":"mcq","question_text":"أي مما يلي هو التوليفة الأفضل للتكلفة الثابتة والتكلفة المتغيّرة؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: أمثلة التكلفة الثابتة والمتغيّرة معكوسة.\u003c/li\u003e\u003cli\u003eB: صحيح!\u003c/li\u003e\u003cli\u003eC: التقسيم ليس بحسب الضرورة أو الترفيه، بل بحسب ثبات المقدار أو تغيّره حسب الشهر. تكاليف الطعام ضرورية للحياة لكنها تُحسَب تكلفة متغيّرة.\u003c/li\u003e\u003cli\u003eD: التكلفة المتغيّرة ليست كل عدة أشهر؛ إنها صرف يحدث كل شهر لكن بمقدار متغيّر.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"876":{"id":876,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يفسّر بأفضل شكل الميل للاستهلاك والميل للادّخار؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: صحيح!\u003c/li\u003e\u003cli\u003eB: مفهوم منفصل عن نسب الضرائب واشتراكات التأمين الاجتماعي.\u003c/li\u003e\u003cli\u003eC: مفهوم منفصل عن نسب التكاليف الثابتة والمتغيّرة.\u003c/li\u003e\u003cli\u003eD: هو مؤشر يشير إلى \u0026#34;نسبة\u0026#34; بالنسبة للدخل المتاح للتصرف، ليس المقدار الإجمالي.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"877":{"id":877,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يفسّر بأفضل شكل \u0026#34;تكلفة الفرصة البديلة\u0026#34; في المشهد التالي؟ المشهد: \u0026#34;في عطلة نهاية الأسبوع، تتردّد بين استخدام وقتك للدراسة أو للمساعدة في البيت\u0026#34;.","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: تكلفة الفرصة البديلة ليست الجهد المصروف على الفعل المُختار، بل القيمة التي كنت ستكسبها من الفعل الذي لم تخترْه.\u003c/li\u003e\u003cli\u003eB: تكلفة الفرصة البديلة ليست الوقت المصروف في التردّد، بل قيمة الفعل نفسه المُتنازَل عنه بالاختيار.\u003c/li\u003e\u003cli\u003eC: تكلفة الفرصة البديلة ليست الوقت نفسه المصروف على الفعل المُختار، بل قيمة الفعل المُتنازَل عنه في ذلك الوقت.\u003c/li\u003e\u003cli\u003eD: صحيح!\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"878":{"id":878,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يفسّر بأفضل شكل الدخل المتاح للتصرف؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: هذا عن التكاليف داخل الأسرة، ليس الدخل المتاح للتصرف. الدخل المتاح للتصرف هو المال المتبقي بعد طرح الضرائب واشتراكات التأمين الاجتماعي في مرحلة قبل وصول الراتب للأسرة.\u003c/li\u003e\u003cli\u003eB: صحيح!\u003c/li\u003e\u003cli\u003eC: هذا عن المقدار الإجمالي الذي تستطيع الأسرة استخدامه بإضافة إعانات حكومية، ليس الدخل المتاح للتصرف. يُنظَر إلى الدخل المتاح للتصرف بشكل منفصل عن الدعم.\u003c/li\u003e\u003cli\u003eD: هذا عن \u0026#34;استخدام\u0026#34; الدخل المتاح للتصرف، ليس الدخل المتاح للتصرف نفسه. إجمالي المال الموضوع نحو الاستهلاك والمال الموضوع نحو الادّخار يوافق الدخل المتاح للتصرف.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"879":{"id":879,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يصف بأفضل شكل الموقع الذي يحتلّه استهلاك الأسر ضمن اقتصاد الدولة كلها؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: ليس نطاقًا مساويًا للإنفاق الحكومي؛ يحتلّ استهلاك الأسر الجزء الأكبر من الناتج المحلي الإجمالي كطرف واحد.\u003c/li\u003e\u003cli\u003eB: استهلاك الأسر أكبر من استثمار الشركات.\u003c/li\u003e\u003cli\u003eC: صحيح!\u003c/li\u003e\u003cli\u003eD: استهلاك الأسر أكبر من الصادرات للخارج.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"880":{"id":880,"subject_id":7,"type":"mcq","question_text":"في وقت معين، قلّلت أسر عبر الدولة الصرف دفعة واحدة، مفكّرة \u0026#34;المستقبل غير مؤكَّد، فلنادّخر\u0026#34;. ثم انخفضت إيرادات المحلات، وانخفض التوظيف، وانخفض الدخل، واضطُرَّت الأسر لادّخار أكثر. أي مما يلي يفسّر بأفضل شكل هذه \u0026#34;مفارقة الادّخار\u0026#34;؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: هذه مسألة تكتمل فقط داخل أسرة، ظاهرة مختلفة عن التسلسل الذي تسبّبه الأسر بادّخارها دفعة واحدة.\u003c/li\u003e\u003cli\u003eB: صحيح!\u003c/li\u003e\u003cli\u003eC: هذا عن اقتصاد الحكومة في الصرف، ظاهرة مختلفة عن التسلسل الذي تسبّبه الأسر بادّخارها دفعة واحدة.\u003c/li\u003e\u003cli\u003eD: هذا عن استمرار الأسر في استخدام المال، الظاهرة المعكوسة للتسلسل الذي تسبّبه الأسر بادّخارها دفعة واحدة.\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null},"881":{"id":881,"subject_id":7,"type":"mcq","question_text":"أي مما يلي يصف بأفضل شكل آلية الدعم الحكومي؟","image":null,"video":null,"explanation":"\u003cul\u003e\u003cli\u003eA: أن المال المُتحمَّل من ضرائب كضريبة الدخل صحيح، لكن الآلية ليست دفعًا مباشرًا للأسر، بل تحمّل جزء من سعر المنتج.\u003c/li\u003e\u003cli\u003eB: ليست جمعًا من الأسر، بل آلية تدعم صرف الأسر. المال المُتحمَّل يأتي أيضًا من ضرائب كضريبة الدخل.\u003c/li\u003e\u003cli\u003eC: أن مال الشراء من ضرائب كضريبة الدخل صحيح، لكنه ليس نظامًا تشتري فيه الحكومة منتجات من الشركات.\u003c/li\u003e\u003cli\u003eD: صحيح!\u003c/li\u003e\u003c/ul\u003e","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:13Z","updated_at":null}},"options":{"872":[{"id":3485,"question_id":872,"subject_id":7,"sort_order":1,"text":"دخل الأصول","image":null,"video":null},{"id":3486,"question_id":872,"subject_id":7,"sort_order":2,"text":"دخل الأعمال","image":null,"video":null},{"id":3487,"question_id":872,"subject_id":7,"sort_order":3,"text":"دخل العمل","image":null,"video":null,"is_correct":true},{"id":3488,"question_id":872,"subject_id":7,"sort_order":4,"text":"دخل غير مكتسب","image":null,"video":null}],"873":[{"id":3489,"question_id":873,"subject_id":7,"sort_order":1,"text":"الأجر الاسمي هو المقدار المدفوع كراتب، والأجر الحقيقي هو الأجر المرئي بالقدرة الشرائية الفعلية مع أخذ تغيّرات الأسعار بالحسبان","image":null,"video":null,"is_correct":true},{"id":3490,"question_id":873,"subject_id":7,"sort_order":2,"text":"الأجر الاسمي هو المقدار بعد الضريبة، والأجر الحقيقي هو المقدار قبل الضريبة","image":null,"video":null},{"id":3491,"question_id":873,"subject_id":7,"sort_order":3,"text":"الأجر الاسمي هو مقدار الراتب الأساسي فقط، والأجر الحقيقي هو إجمالي الراتب الأساسي زائد البدلات وأجر العمل الإضافي","image":null,"video":null},{"id":3492,"question_id":873,"subject_id":7,"sort_order":4,"text":"الأجر الاسمي هو الأجر المتوسط على مستوى الشركة كلها، والأجر الحقيقي هو الأجر المدفوع فعليًا لكل فرد","image":null,"video":null}],"874":[{"id":3493,"question_id":874,"subject_id":7,"sort_order":1,"text":"مال مساعدات يُرسَل من مصر للخارج، أصبح وسيلة رئيسية للنشاط الدبلوماسي","image":null,"video":null},{"id":3494,"question_id":874,"subject_id":7,"sort_order":2,"text":"مال يستخدمه المسافرون من الخارج في مصر، يدعم إيرادات السياحة","image":null,"video":null},{"id":3495,"question_id":874,"subject_id":7,"sort_order":3,"text":"أموال تودعها الحكومة المصرية في بنوك بالخارج، تشكّل مدخرات الدولة","image":null,"video":null},{"id":3496,"question_id":874,"subject_id":7,"sort_order":4,"text":"مال يرسله المصريون العاملون بالخارج لأسرهم في البيت، أصبح مصدر دخل مهمًا لاقتصاد مصر","image":null,"video":null,"is_correct":true}],"875":[{"id":3497,"question_id":875,"subject_id":7,"sort_order":1,"text":"أمثلة التكلفة الثابتة هي تكاليف الطعام وتكاليف الضروريات اليومية، وأمثلة التكلفة المتغيّرة هي الإيجار ورسوم الاتصالات الأساسية","image":null,"video":null},{"id":3498,"question_id":875,"subject_id":7,"sort_order":2,"text":"أمثلة التكلفة الثابتة هي الإيجار ورسوم الاتصالات الأس