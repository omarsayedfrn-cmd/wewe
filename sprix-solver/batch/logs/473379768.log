xt_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:45:06Z"},{"id":20616989,"test_response_id":1372704,"test_question_id":709,"status":"graded","selected_option_id":4908,"answer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:45:07Z"},{"id":20616990,"test_response_id":1372704,"test_question_id":710,"status":"graded","selected_option_id":4909,"answer_data":null,"text_answer":null,"code_draft":null,"code_language":null,"code_output":null,"test_results":null,"passed_count":null,"total_count":null,"is_correct":true,"score":1,"answered_at":"2026-10-14T17:45:07Z"}],"questions":{"1179":{"id":1179,"subject_id":7,"type":"mcq","question_text":"من أجل شركتك الناشئة المستقبلية، قررت أولًا اكتساب، كفرد، القوة على تنمية المال. أي مما يلي يطابق بشكل صحيح \u0026#34;وسيلة فعّالة\u0026#34; لتنمية ٣٠٬٠٠٠ جنيه من الأموال الفائضة مع \u0026#34;تعريفها\u0026#34;؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (C). الوسيلة الفعالة \u0026#34;لتنمية\u0026#34; أموال للمستقبل هي الاستثمار. الاستثمار هو توقع عائد مستقبلي، وضع المال في نمو شركة أو مشروع، وتنميته على مدى طويل. إذا سار الأمر بشكل جيد ينمو، لكنه يمكن أن يقل أيضًا. الخيار (A) هو الادخار، والخيار (B) هو المضاربة. الخيار (D) مُسمّى استثمارًا، لكنه فعل تجنّب المخاطرة بشكل متطرف والبحث عن مكان إيداع ينمو بثبات، مختلف عن جوهر الاستثمار.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1180":{"id":1180,"subject_id":7,"type":"mcq","question_text":"تريد تنمية أموال فائضة على مدى طويل. من بين طرق استخدام المال الأربع التالية، أيّها الفعل الأنسب لهذا الهدف؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (A). المناسب لتنمية أموال فائضة على مدى طويل هو الخيار (A)، توقع عائد مستقبلي، استثمار المال في نمو شركة، والاستمرار في حمل السهم بينما تحصل على ارتفاعات السعر وتوزيعات الأرباح -هذا هو الاستثمار. الخيار (B) مضاربة تستهدف الفرق في التحرك السعري قصير المدى، والخيار (C) استهلاك لشراء منتجات لدعم شركة (لا وعد بارتفاع سعر السهم)، والخيار (D) مراقبة لمجرد قياس وقت الشراء بمشاهدة تحركات السعر وترك النقد خاملًا -لا شيء منها طريقة علاقة تستثمر المال في نمو شركة لتنميته.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1181":{"id":1181,"subject_id":7,"type":"mcq","question_text":"أفادت أخبار اقتصادية مُعروضة على هولوغرام أن \u0026#34;الأسعار ترتفع في كل العالم\u0026#34;، وعُلِّق إشعار ارتفاع سعر في مقصف الغداء أيضًا. مع أنه لم تنخفض ورقة نقدية واحدة من حافظتك، لماذا تنخفض قيمتها \u0026#34;تنكمش\u0026#34; فقط من الاحتفاظ بها كما هي؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (D). في التضخم، تستمر أسعار السلع في الارتفاع بشكل عام. حتى إذا لم يتغيّر المبلغ المتوفر نفسه، تنخفض كمية السلع والخدمات التي يمكنك شراءها بنفس المبلغ (القوة الشرائية). لذلك حتى بالاحتفاظ به كنقد فقط، تنكمش القيمة الحقيقية. لا يُطرَح كأجر أو ضريبة كما في (A) و(B)، ولا هي قصة عن الاقتصاد أو الدخل كما في (C).","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1182":{"id":1182,"subject_id":7,"type":"mcq","question_text":"ارتفع سعر غداء المقصف المعتاد من ٨٠ جنيهًا للوجبة إلى ١٠٠ جنيه للوجبة. كيف يتغيّر عدد وجبات الغداء التي يمكنك شراءها بـ٤٬٠٠٠ جنيه المُخصَّصة للطعام؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (B). العدد الذي يمكنك شراءه يُحسب بقسمة مال الطعام على سعر وجبة واحدة. قبل الارتفاع هو ٤٬٠٠٠ / ٨٠ = ٥٠، وبعد الارتفاع ٤٬٠٠٠ / ١٠٠ = ٤٠. العدد المُنخفَض هو ٥٠ − ٤٠ = ١٠. حتى مع أن المبلغ لم ينخفض بجنيه واحد حتى، الكمية القابلة للشراء بنفس المال (القوة الشرائية) انكمشت بهذا القدر.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1183":{"id":1183,"subject_id":7,"type":"mcq","question_text":"المبلغ المتوفر ٧٥٬٠٠٠ جنيه له ثلاث خطط. ٢٥٬٠٠٠ جنيه تكلفة دورة إعادة تعلّم يجب دفعها في نصف عام، ٢٠٬٠٠٠ جنيه نفقات معيشة قريبة المدى للانتقال في ٣ سنوات، والباقي ٣٠٬٠٠٠ جنيه لا خطة لاستخدامه في الوقت الحالي. أي مما يلي طريقة مناسبة للتعامل مع هذه المبالغ الثلاثة؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (A). يُتعامَل مع المال بشكل منفصل بحسب \u0026#34;متى تستخدمه\u0026#34;. المال ذو وقت الاستخدام المحدد (٢٥٬٠٠٠ جنيه في نصف عام، ٢٠٬٠٠٠ جنيه في ٣ سنوات) سيكون مشكلة لو انخفض حتى ذلك الحين، فيُؤمَّن من خلال الادخار دون تعريضه لتحرك السعر. ما يمكن تحويله إلى استثمار هو فقط الـ٣٠٬٠٠٠ جنيه غير المُخطَّط لاستخدامها في الوقت الحالي. بهذه الـ٣٠٬٠٠٠ جنيه، حتى إذا انخفضت مؤقتًا من تحرك السعر، يمكنك الانتظار حتى وقت الاستخدام. الخيار (B) رؤية واحدة فقط تُعرِّض المبلغ كاملًا لتحرك السعر، والخيار (C) خطأ مزدوج باستثمار الجزء المُستخدَم قريبًا وترك الجزء غير المُستخدَم خاملًا، والخيار (D) يُعرِّض المبلغين ذوي وقت الاستخدام المحدد لتحرك السعر -لا شيء منها يمكنه التعامل مع المال بشكل منفصل بحسب الاستخدام والفترة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1184":{"id":1184,"subject_id":7,"type":"mcq","question_text":"بالنظر إلى مخطط الهولوغرام، تحرك سعر سهم شركة معينة بشكل كبير حتى خلال يوم واحد. أي مما يلي تفسير مناسب لـ\u0026#34;المخاطرة\u0026#34; في عالم التمويل، التي ستواجهها في الاستثمار المستقبلي؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (C). مخاطرة الاستثمار هي عدم اليقين من أن النتيجة تصبح إيجابية أو سلبية، لا يمكن قراءته مسبقًا. يشير إلى مدى تقلب السعر (حجم التقلب) نفسه، بما في ذلك ليس فقط الإمكانية السلبية بل الإمكانية الإيجابية أيضًا. ليست كلمة تشير فقط إلى الخسارة كما في (A)، أو فقط الحالة التي لا تعود فيها الأموال كما في (B). ولا هي الأحداث نفسها التي تسبب تحرك السعر كما في (D).","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1185":{"id":1185,"subject_id":7,"type":"mcq","question_text":"في عمود محطة هولوغرام، تبحث عن علاقة \u0026#34;المخاطرة والعائد\u0026#34;، أساس اختيار الأهداف الاستثمارية. أي مما يلي تفسير مناسب يمثّل هاتين الطبيعتين؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (B). المخاطرة والعائد في علاقة مقايضة حيث جعل أحدهما أكبر يجعل الآخر أكبر أيضًا. كلما كبر مدى تقلب السعر، كبرت النتيجة المتوقعة، وكلما صغر التقلب، صغرت النتيجة. هدف استثماري مريح بمخاطرة صغيرة وعائد كبير فقط غير موجود. الخيار (A) خطأ رؤيتهما غير مرتبطين، الخيار (C) خطأ رؤية أحدهما يتلاشى بالوقت، الخيار (D) خطأ البحث بلا نهاية عن شيء غير موجود.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1186":{"id":1186,"subject_id":7,"type":"mcq","question_text":"بينما تبحث عن مكان لإدارة أموال فائضة، ظهر إعلان يدّعي \u0026#34;رأس مال مضمون، ينمو بشكل موثوق وكبير كل شهر\u0026#34; بشكل متكرر. أي مما يلي طريقة مناسبة للتعامل مع هذا الإعلان في ضوء مبدأ المخاطرة والعائد؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (D). المخاطرة والعائد في علاقة مقايضة، وقصة مخاطرة منخفضة وعائد مرتفع غير موجودة في الأساس. ادّعاء ضمان رأس المال والاستمرار في النمو بشكل موثوق وكبير كل شهر يخالف تلك العلاقة وهي قصة تبدو جيدة أكثر من الحقيقة، فالشك في بنية القصة نفسها أولًا. الخيار (A) يفتقد التمييز في ضوء العلاقة بأخذها حتى بمبلغ صغير، والخيار (B) بأخذ المخاطرة بخفة من ادّعاء ضمان رأس المال، والخيار (C) بتصديق ادّعاء النمو الكبير المستمر كما هو والتقديم -كل هذا يفتقد التمييز.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1187":{"id":1187,"subject_id":7,"type":"mcq","question_text":"حملت الأخبار الاقتصادية الأحداث التالية ( ١ )-( ٤ ) التي حدثت في العالم. أي مما يلي يطابق بشكل صحيح الأحداث ( ١ )-( ٤ ) مع الأنواع الأربعة للمخاطر (مخاطر السوق، المخاطر الائتمانية، مخاطر السيولة، مخاطر سعر الصرف)؟\n( ١ ) تراجعت إدارة الهدف الاستثماري، ولم يعد المال المُقدَّم\n( ٢ ) تغيّر سعر الصرف، وانخفضت قيمة أصل أجنبي محوَّل إلى العملة المحلية\n( ٣ ) أدى تراجع اقتصادي عالمي إلى انخفاض أسعار أسهم شركات كثيرة بشكل عام\n( ٤ ) أردت البيع لكن لم تجد مشتريًا، ولم تستطع تحويله إلى نقد تقريبًا","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (C). تُميَّز أنواع المخاطر بسبب تحرك القيمة (أو عدم القدرة على تحركها). ( ١ ) هي المخاطر الائتمانية، حيث يصبح الطرف الآخر غير قادر على السداد كما وُعِد؛ ( ٢ ) هي مخاطر سعر الصرف، حيث تتحرك القيمة من تقلب نسبة التحويل مع العملة الأجنبية؛ ( ٣ ) هي مخاطر السوق، حيث تنخفض أسعار أسهم شركات كثيرة من حركة العالم بأكمله؛ ( ٤ ) هي مخاطر السيولة، حيث لا يمكنك تحويلها إلى نقد فورًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1188":{"id":1188,"subject_id":7,"type":"mcq","question_text":"تغيّر سعر الصرف من ١ دولار = ٤٨ جنيهًا إلى ١ دولار = ٥٢ جنيهًا. إذا كنت تحمل أصولًا بقيمة ٥٠٠ دولار لا يتغيّر سعرها المحلي، كيف تتغيّر قيمة هذا الأصل عند تحويله إلى الجنيه؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (B). القيمة المحوَّلة إلى الجنيه تُوجَد بضرب مقدار الأصل في السعر. قبل تغيّر السعر هي ٥٠٠ × ٤٨ = ٢٤٬٠٠٠ جنيه، وبعد تغيّره ٥٠٠ × ٥٢ = ٢٦٬٠٠٠ جنيه. الجزء المُزاد هو ٢٦٬٠٠٠ − ٢٤٬٠٠٠ = ٢٬٠٠٠ جنيه. حتى مع أن السعر المحلي لم يتغيّر على الإطلاق، تتحرك القيمة المحوَّلة بهذا القدر فقط من تغيّر السعر. مخاطر سعر الصرف تعمل في الاتجاهين، الانخفاض والزيادة معًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1189":{"id":1189,"subject_id":7,"type":"mcq","question_text":"أنت تُوضّح قدرتك على تحمل المخاطر. ما تُخصّصه للإدارة هو أموال فائضة لا خطة لاستخدامها في الوقت الحالي، لكنك قد تستخدم جزءًا منها في غضون سنوات قليلة. أيضًا، أنت من النوع الذي، عندما تنخفض الأصول بشكل كبير مؤقتًا، يهتم حتى في الليل ولا يستطيع الاستقرار. أي مما يلي طريقة مناسبة للتفكير في القدرة على تحمل المخاطر في هذه الحالة؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (A). تُحدَّد القدرة على تحمل المخاطر بالنظر إلى وقت الاستخدام (الفترة)، ومجال الأموال، وطريقة مواجهة تحرك السعر (النوع) معًا. في هذه الحالة، هناك مجال في الأموال، لكنك قد تستخدم جزءًا في غضون سنوات قليلة وأنت أيضًا من النوع الذي يتحمّل انخفاضات السعر الكبيرة بشكل ضعيف، فيصعب أخذ تقلب كبير. مع ذلك، تجنّب تحرك السعر تمامًا لن يُنمّيه. لذلك تحديد مدى التقلب المقبول عند المستوى المتوسط مناسب. الخيار (B) يتجاهل النفقة القريبة والنوع، الخيار (C) يتجاهل مجال الأموال ووقت الاستخدام، كل واحد يُحدَّد بظرف واحد فقط، والخيار (D) يتركه للآخرين دون التفكير في ظروفك الخاصة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1190":{"id":1190,"subject_id":7,"type":"mcq","question_text":"بحثت عن \u0026#34;السهم\u0026#34; و\u0026#34;السند\u0026#34;، الأهداف الاستثمارية الرئيسية للأموال الفائضة، في مقال هولوغرام. أي مما يلي تفسير مناسب للفرق بين هذين الاثنين؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (D). السهم هدف استثماري تحمل فيه حصة شركة وتصبح مستثمرًا، وبما أنه يمكن أن ينمو كثيرًا بحسب نمو الشركة، فتحركه السعري (المخاطرة) كبير أيضًا. السندات شهادات تثبت إقراض المال، تُصدرها دول أو شركات لاستعارة المال، مع استلام موعود في وقت محدد وسداد رأس المال عند الاستحقاق. بسبب وجود وعد بالسداد، يميل التحرك السعري إلى أن يكون أصغر مقارنة بالسهم. الخياران (A) و(B) يخلطان بين الإقراض والحصة، والخيار (C) يعكس الطبيعتين.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1191":{"id":1191,"subject_id":7,"type":"mcq","question_text":"تريد السعي إلى دخل شهري منتظم وارتفاع سعر طويل المدى معًا. ليس لديك خطة للبيع في الوقت الحالي، ولا يهمك عدم القدرة على التحويل إلى نقد فورًا. أي مما يلي من الأهداف الاستثمارية يناسب هذه الرغبة بأفضل شكل؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (B). العقارات، الاستثمار في الأرض والمباني، يمكن أن يتوقع دخلًا منتظمًا يُسمّى إيجارًا وربحًا من ارتفاع السعر معًا. الطبيعة التي لا يُوجَد فيها مشتر بالضرورة فورًا عندما تريد البيع، ويميل إلى استغراق وقت للتحويل إلى نقد (سيولة منخفضة)، تناسب أيضًا رغبة عدم البيع في الوقت الحالي. الخيار (A)، السهم، يمكن أن يستهدف ارتفاعات السعر وتوزيعات الأرباح لكن لا دخل كالإيجار، الخيار (C)، السندات، له استلامات منتظمة لكن يصعب استهداف ارتفاع سعر كبير، الخيار (D)، الصندوق الاستثماري، منتج يستثمر في أهداف متعددة معًا -لا شيء منها يناسب هذا المزيج من الرغبات.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1192":{"id":1192,"subject_id":7,"type":"mcq","question_text":"بينما توسّع مرشحي أهدافك الاستثمارية، لاحظت \u0026#34;الذهب\u0026#34;، الذي يختلف تحركه السعري عن الأسهم والسندات. أي مما يلي تفسير مناسب للذهب، الذي تختلف خصائصه عن الأسهم والسندات؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (D). الذهب ليس هدفًا يُنتج ربحًا ويدفع توزيعات أرباح كشركة. في المقابل، هو أصل حقيقي يميل إلى جذب الانتباه كمخزن للقيمة عندما تتآكل قيمة المال في التضخم، أو في الطوارئ عندما يكون العالم غير مستقر. يتأثر أيضًا بأسعار الصرف عند تحويله إلى نقد. الخيار (A) يخطئ في وجود استلام شبيه بتوزيعات الأرباح، والخياران (B) و(C) يخطئان في التحرك السعري والسلوك في فترات عدم الاستقرار.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1193":{"id":1193,"subject_id":7,"type":"mcq","question_text":"بأموال فائضة لا خطة لاستخدامها في الوقت الحالي، أنت على وشك بدء إدارتها. قد يحدث أنه فورًا بعد البدء، ينخفض السوق بأكمله وتنكمش أصولك مؤقتًا بحوالي ١٠%، ويقول من حولك \u0026#34;من الأفضل أن تبيع الآن\u0026#34;. أي مما يلي سياسة مناسبة لتنمية هذه الأموال بجعل الوقت حليفًا في مشهد كهذا؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (A). تناسب الأموال الفائضة التي لا خطة لاستخدامها في الوقت الحالي التنمية طويلة المدى بجعل الوقت حليفًا. دون الانجراف مع الانخفاض فورًا بعد البدء أو أصوات من حولك، الاستمرار في حمل هدف استثماري متوقع أن ينمو يتيح لك تنميته بينما تُسوّي التقلبات قصيرة المدى. الخيار (B) يصاب بالذعر من انخفاض واحد ويبيع، ثم ينتظر نقدًا دون معرفة أين القاع، مُفوّتًا وقت النمو. الخيار (C) يطابق حركات من حولك فقط دون سياسة خاصة به، والخيار (D) ينحاز إلى هدف استثماري ذو قوة نمو قليلة بسبب تجنّب تحرك السعر.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1194":{"id":1194,"subject_id":7,"type":"mcq","question_text":"قررت قدرة على تحمل المخاطر بـ\u0026#34;قد تستخدم جزءًا في غضون سنوات قليلة، وتريد تجنب انخفاضات السعر الكبيرة\u0026#34;. هناك، سهم ارتفع سعره ثلاث مرات في نصف العام الماضي ويُشتهَر أنه سيستمر في الارتفاع، وهو موضوع رائج. تحركه السعري حاد جدًا، ولا يمكنك بالضرورة البيع فورًا عندما تريد. أي مما يلي طريقة مناسبة للتعامل مع هذا السهم؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (C). يُحكَم على هدف استثماري بثلاثة محاور -آفاق النمو (العائد)، وحجم التحرك السعري (المخاطرة)، وما إذا كان يمكن تحويله إلى نقد فورًا (السيولة)- وما إذا كان يتناسب مع القدرة المُحدَّدة على تحمل المخاطر. هذا السهم له آفاق نمو كبيرة، لكن تحركه السعري حاد (تريد تجنب الانخفاضات الكبيرة) ولا يمكن بيعه بالضرورة فورًا (قد تستخدم جزءًا في غضون سنوات قليلة)، فيصعب أن يتناسب مع القدرة. الخيار (A) يتجاهل القدرة مستندًا إلى السجل، والخيار (B) يجازف بمبلغ كبير معتمدًا فقط على الشهرة والزخم، والخيار (D) لا يتحقق من العائد بسبب تجنب المخاطرة -لا شيء منها يوافق بين المحاور الثلاثة والقدرة معًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1195":{"id":1195,"subject_id":7,"type":"mcq","question_text":"قبل شراء سهم لأول مرة، تعيد التحقق عبر محطة الهولوغرام من ماهية السهم أساسًا. أي مما يلي تفسير مناسب للسهم؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (D). السهم ورقة مالية تُصدرها شركة لجمع أموال لأنشطتها، تمثّل حصة شركة. المساهم الذي هو الحامل، كمستثمر استثمر في الشركة، يحمل حصة من الشركة كاملة، لا المباني أو المنتجات نفسها. الخيار (A) هو السندات، والخيار (B) مؤهلات عضوية، والخيار (C) يخطئ في اعتبارها المباني والمعدات نفسها.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1196":{"id":1196,"subject_id":7,"type":"mcq","question_text":"من خلال التقديم، فُتِح حساب أوراق مالية. عندما تضع أمر شراء سهم من حساب الأوراق المالية، تُبرم الصفقة دون أن تبحث عن طرف مقابل بنفسك، ويتحدد سعر السهم وفقًا لتلاقي أوامر البيع والشراء. أي مما يلي تفسير مناسب لدور البورصة الذي يدعم هذا؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (B). البورصة مكان يجمع أوامر بائعي ومشتري الأسهم في مكان واحد. حيث تتلاقى رغبات المشترين والبائعين، يتحدد سعر السهم، ويمكنك التداول في أي وقت دون البحث عن طرف مقابل بنفسك. لهذا السبب بالضبط، بمجرد وضع أمر، تُقام صفقة، ويتحدد سعر السهم بشكل طبيعي وفقًا للعرض والطلب. الخيار (A) يخطئ باعتبار أن البورصة تُحدِّد سعر السهم، والخيار (C) بالتوصية بالأسهم، والخيار (D) بضمان الخسائر -أدوار مختلفة (خاطئة).","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1197":{"id":1197,"subject_id":7,"type":"mcq","question_text":"المال المُحصَّل من الاستثمار في الأسهم له شكلان -توزيعات الأرباح (مكسب الدخل) والمكسب الرأسمالي. أي مما يلي تفسير مناسب للفرق بين هذين الاثنين؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (A). يُميَّز العائدان بمصدر المال. توزيعات الأرباح (مكسب الدخل) مال يُوزَّع على المساهمين من جزء من صافي الربح الذي كسبته شركة في أعمالها. المكسب الرأسمالي هو ربح الفرق الذي تحصل عليه من البيع بسعر سهم أعلى من سعر الشراء. الخيار (B) يعكس الاثنين، والخيار (C) هو سوء فهم أن توزيعات الأرباح تتطلب البيع أيضًا، والخيار (D) يخطئ في اعتبارهما حقوق تصويت أو حقوق عضوية.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1198":{"id":1198,"subject_id":7,"type":"mcq","question_text":"إذا شريت وبعت سهمًا بالضبط كما في هذا الجدول، أي مما يلي مكسب رأسمالي (مكسب ارتفاع السعر) مناسب تم الحصول عليه؟","image":"image_5_20_5_ar.png","video":null,"explanation":"الإجابة الصحيحة هي (C). يُحسب المكسب الرأسمالي بالفرق بين المبلغ المُباع والمبلغ المُشترى. الفرق لكل سهم هو ١١٠ − ٩٠ = ٢٠ جنيهًا. بما أن عدد الأسهم ٣٠، ٢٠ × ٣٠ = ٦٠٠ جنيه. الفرق بين سعري الشراء والبيع، وعدد الأسهم. الإحساس بأن هذين الاثنين يحددان حجم العائد يصبح أساس الحكم على البيع والشراء.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1199":{"id":1199,"subject_id":7,"type":"mcq","question_text":"بالنظر إلى صفحة شركة أنت على وشك شراء سهم فيها، مقدار توزيعات الأرباح لكل سهم زاد وانخفض عامًا بعد عام. أي مما يلي سبب مناسب لتغيّر مقدار توزيعات الأرباح عامًا بعد عام بهذا الشكل؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (B). مصدر توزيعات الأرباح (مكسب الدخل) هو صافي الربح الذي حققته شركة في أعمالها. في سنوات الأداء الجيد يمكن توزيع أكثر، وفي السنوات الصعبة يمكن تقليله أو التنازل عنه. لذلك تتحرك مقادير توزيعات الأرباح المُرتَّبة في الصفحة عامًا بعد عام. لا تُحدَّد من البورصة كما في (A)، ولا هي إجمالي ثابت مُقسَّم على عدد الأفراد كما في (C)، ولا آلية تُحدَّد بمدة الحمل كما في (D).","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1200":{"id":1200,"subject_id":7,"type":"mcq","question_text":"أعلنت شركة الهدف الاستثماري، \u0026#34;هذه السنة لن ندفع توزيعات أرباح، وسنخصص هذا الجزء بدلًا من ذلك لبناء مصنع جديد (إعادة استثمار)\u0026#34;، وانخفض سعر السهم قليلًا أيضًا فورًا بعد الإعلان. أي مما يلي طريقة مناسبة لأخذ هذا كمساهم؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (D). القرار بعدم دفع توزيعات الأرباح هو أيضًا خيار للاحتفاظ بصافي الربح داخل الشركة وإعادة استثماره في النمو المستقبلي كبناء مصنع جديد. إذا نمت قيمة الشركة، يمكن أن يرتبط بربح المساهمين في صورة ارتفاع السعر. انخفاض سعر السهم فورًا بعد الإعلان هو أيضًا مجرد التقييم في تلك اللحظة. الخياران (A) و(B) يأخذان توزيعات الأرباح كالعائد الوحيد ويتركان السهم / يرون خسارة، والخيار (C) يتفاعل مع الانخفاض ويبيع السهم دون فحص الجوهر -كل هذا يفتقد منظور إعادة الاستثمار والمدى الطويل.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1201":{"id":1201,"subject_id":7,"type":"mcq","question_text":"سعر السهم الذي تحمله يرتفع وينخفض يوميًا. أي مما يلي تفسير مناسب للآلية الأساسية التي يتحرك بها سعر السهم أساسًا؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (A). يتحرك سعر السهم بتوازن الأشخاص الذين يريدون الشراء والأشخاص الذين يريدون البيع (العرض والطلب). عندما يزداد المشترون، يرتفع سعر السهم بسهولة، وعندما يزداد البائعون، ينخفض بسهولة. ليس أن شركة أو دولة تُحدِّد سعر السهم نفسه كما في (B) و(C)، ولا يتحرك آليًا بحساب ثابت كما في (D).","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1202":{"id":1202,"subject_id":7,"type":"mcq","question_text":"شركة حلويات معينة موضوع كبير على مواقع التواصل الاجتماعي، لكن بالنظر إلى أدائها، لا يظهر نمو كبير في الإيرادات أو الربح بعد. أي مما يلي طريقة مناسبة للتفكير فيما إذا كنت تشتري المزيد من هذا السهم؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (C). يتحرك سعر السهم بالطلب من الشعبية أيضًا، لكن الجوهر الذي يدعمه هو أداء الشركة. كلما سبق الموضوع، كلما حكمت بعد التحقق من دعم الإيرادات والربح. الخياران (A) و(D) مُستندان فقط إلى الرواج والانتباه، والخيار (B) يتجاوز خطوة الفحص.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1203":{"id":1203,"subject_id":7,"type":"mcq","question_text":"في يوم أفادت فيه الأخبار أن \u0026#34;معدل البطالة تراجع\u0026#34;، رغم أن شركة هدفك الاستثماري لم تُعلن شيئًا، انخفض سعر سهمها. أي مما يلي تفسير مناسب لعامل انخفاض السعر في هذا اليوم؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (A). يتحرك سعر السهم ليس فقط بأداء الشركة بل بمؤشرات اقتصادية كالأسعار ومعدل البطالة أيضًا. عندما يُنظَر إلى الآفاق الاقتصادية بقلق، حتى دون إعلان من شركة فردية، يمكن أن يزداد الأشخاص الذين يريدون بيع الأسهم عبر السوق بأكمله وينخفض سعر السهم (مخاطر السوق). الأداء نفسه لم يتحرك بالضرورة كما في (B)، والخيار (C) يعكس اتجاه العرض والطلب، ولا يمكن القول إنه غير مرتبط كما في (D).","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1204":{"id":1204,"subject_id":7,"type":"mcq","question_text":"أفادت الأخبار أن \u0026#34;أسعار أسهم شركات كثيرة ترتفع بزخم يتجاوز نمو ربحها بشكل كبير\u0026#34;. أي مما يلي تفسير مناسب عندما يكون السوق بأكمله في حالة كهذه؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (B). الفقاعة حالة ارتفعت فيها أسعار أسهم السوق بأكمله بشكل غير طبيعي على توقع أو شعبية العالم وحدها، بما يتجاوز الأداء الفعلي (الواقع). لها خاصية أنه، عندما ينتشر الحذر بأن \u0026#34;سعر هذا السهم مرتفع جدًا\u0026#34;، يتدفق الراغبون في البيع وينهار دفعة واحدة. الخيار (A) يخطئ سعر السهم بالقوة الحقيقية، والخيار (C) هو افتراض أن الارتفاع الواسع أكثر أمانًا (الارتفاع غير المصاحب للواقع له خطر انهيار أكبر على العكس)، والخيار (D) يخطئ جزء ارتفاع السعر، الذي لم يُبَع بعد، باعتباره ربحًا مُحقَّقًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1205":{"id":1205,"subject_id":7,"type":"mcq","question_text":"سهم يستمر في التصاعد موضوع في العمل أيضًا. عندما تتردد بين شراء هذا السهم بجزء من أموالك الفائضة طويلة المدى، أي مما يلي طريقة مناسبة للتفكير بحيث لا يتذبذب حكمك؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (D). كلما تصاعد سهم أكثر، كلما فحصت زخم السعر مقابل الواقع (الأداء). إذا كان ارتفاعًا على التوقع وحده بما يتجاوز الواقع، يمكن أن ينهار عندما ينتشر الحذر، فمع الأموال الفائضة طويلة المدى يصبح حكمًا بالتنازل عن الشراء. الخيار (A) يقترب من المضاربة المستهدفة للفرق قصير المدى، والخيار (B) يشتري دون فحص الجوهر حتى بمبلغ أصغر، والخيار (C) يضع خطة للانتظار حتى الانخفاض والشراء رخيصًا أولًا -كل هذا يفتقد فحص الواقع.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1206":{"id":1206,"subject_id":7,"type":"mcq","question_text":"وصلت دعوة للجمعية العامة للمساهمين من هدفك الاستثماري. عندما تحضر كمساهم، أي مما يلي تفسير مناسب لما يمكنك فعله هناك؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (C). الجمعية العامة للمساهمين هي أعلى مكان لصنع القرار في الشركة يتجمع فيه المساهمون، المستثمرون الذين استثمروا في الشركة. يمكن للمساهم الحاضر إظهار الموافقة أو عدم الموافقة على قرارات الشركة المهمة باستخدام حقوق التصويت. ليس مكانًا للتعليمات في العمل اليومي كما في (A)، أو الاستشارة الفردية كما في (B)، أو بيع وشراء الأسهم كما في (D).","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1207":{"id":1207,"subject_id":7,"type":"mcq","question_text":"عندما حاولت شراء سهم في شركة مصنّعة لمعدات كرة القدم مهتم بها، لم تكن تلك الشركة قد خرجت للسوق بعد ولم يمكن تداولها. ما المطلوب لكي يصبح سهم هذه الشركة قابلًا للتداول في السوق من أي شخص؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (A). لكي يصبح السهم قابلًا للتداول في السوق من أي شخص، يلزم طرح عام أولي (IPO)، حيث يتجاوز جانب الشركة فحص البورصة، ويُطرَح، ويفتح ويعرض سهمه للسوق. لا يبدأ من مقاربة أو طلب جانب المشتري كما في (B) و(C) و(D). ما إذا كنت تستطيع تطبيق فكرة أن الطرح للتداول شيء تقوم به الشركة هو النقطة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1208":{"id":1208,"subject_id":7,"type":"mcq","question_text":"في أعلى شاشة محطة الهولوغرام، يُعرَض دائمًا رقم يُسمّى \u0026#34;المؤشر السهمي\u0026#34;. أي مما يلي تفسير مناسب لما يمثّله هذا الرقم، الذي يتحرك بشكل منفصل عن أسعار أسهم الشركات الفردية؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (B). المؤشر السهمي رقم يُجمّع ويحسب، بطريقة فريدة، أسعار أسهم شركات متعددة تمثّل السوق. دون البحث في كل شركة واحدة تلو الأخرى، يمكنك استيعاب موجة اقتصاد السوق بأكمله واتجاه حركة الأسعار بنظرة واحدة. الخيار (A) هو سعر سهم شركة واحدة، والخيار (C) عدد الصفقات، والخيار (D) إجمالي الربح -كل هذا أرقام منفصلة عن المؤشر.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1209":{"id":1209,"subject_id":7,"type":"mcq","question_text":"تُحاكي سوقًا صغيرًا مكوّنًا من ثلاث شركات فقط، كهذا الجدول. بالأمس كان متوسط الثلاث شركات ١٠٠ جنيه، واليوم فقط الشركة ب ارتفعت ٦٠ جنيهًا في السعر بينما الشركتان الأخريان دون تغيير. أي مما يلي يذكر بشكل صحيح متوسط سعر السهم لليوم للثلاث شركات وطبيعة المؤشر؟","image":"image_5_20_6_ar.png","video":null,"explanation":"الإجابة الصحيحة هي (D). يُحسب المتوسط بقسمة إجمالي أسعار الأسهم على عدد الشركات. (١٠٠ + ١٤٠ + ١٢٠) / ٣ = ١٢٠ جنيهًا. بما أن متوسط الأمس كان ١٠٠ جنيه، حتى إذا ارتفعت الشركة ب ٦٠ جنيهًا، يظهر كارتفاع بـ٢٠ جنيهًا في متوسط الثلاث شركات. طبيعة المؤشر، حيث تحرك سعر شركة واحدة يُقسَّم على عدد الشركات (٣) ويصبح مقياس السوق بأكمله، تظهر في هذا الرقم. لذلك حتى في يوم تحرك فيه المؤشر قليلًا، قد تكون شركة واحدة فقط قد تحركت بشكل كبير خلفه.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1210":{"id":1210,"subject_id":7,"type":"mcq","question_text":"في صباح ما، انخفض المؤشر السهمي بشكل كبير عن اليوم السابق. سعر سهم هدفك الاستثماري لم ينخفض تقريبًا، وأداؤه سلس أيضًا. أي مما يلي رد مناسب في هذا الوضع؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (C). المؤشر السهمي مقياس السوق بأكمله، يُجمّع ويحسب، بطريقة فريدة، أسعار أسهم شركات متعددة تمثّل السوق. يخبرك بالتيار بأكمله، لكن سعر سهم كل شركة لا يتحرك بنفس نسبة المؤشر. في هذا اليوم، لم ينخفض هدفك الاستثماري كثيرًا وأداؤه سلس، فأخذ انخفاض المؤشر كتيار مؤقت للسوق بأكمله، والاستمرار في حمل السهم بالسياسة طويلة المدى المُحدَّدة هو الرد الهادئ. الخيار (A) يطبّق المؤشر على الهدف الاستثماري كما هو ويبيع من الخوف، والخيار (B) على العكس يتسرع لشراء المزيد من السهم راكبًا تحرك السعر، والخيار (D) يطبّق نسبة المؤشر على شركة واحدة ويقفز إلى استنتاج خسارة -كل هذا يخلط بين المؤشر وتحرك سعر شركة واحدة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1211":{"id":1211,"subject_id":7,"type":"mcq","question_text":"بالنظر إلى سجل استثمارك للسنة الماضية، تحدَّدت زيادة وانخفاض الأصول كلها بتحرك سعر شركة هدف استثماري واحدة فقط. أي مما يلي طريقة مناسبة للتفكير نحو بناء أصول مستقبلي مستقر؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (A). عندما تركز في شركة واحدة فقط، تتأثر حركة كل الأموال الفائضة بتحرك سعر تلك الشركة الواحدة كما هي. كابتكار لتخفيف هذا التقلب، طريقة حمل الأهداف الاستثمارية مُقسّمة إلى عدة أجزاء فعّالة. الخيار (B) يعمّق التركيز أكثر، والخيار (C) يترك سبب التقلب كما هو، والخيار (D) يقترب من المضاربة المستهدفة للفرق قصير المدى.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1212":{"id":1212,"subject_id":7,"type":"mcq","question_text":"قررت تبنّي طريقة \u0026#34;التنويع\u0026#34; بشكل كامل في بناء أصولك المستقبلي. أي مما يلي تفسير مناسب للتنويع؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (B). التنويع هو تقسيم الأهداف الاستثمارية إلى عدة أجزاء، بحيث حتى إذا انخفض سعر هدف استثماري واحد، يمكن للأخرى دعمه. بالاستمرار في تقسيمه وحمله، يمكنك تنميته بينما تُخفّف التقلب الكامل. الخيار (A) ينتهي بإعادة التجميع في واحد بعد التقسيم، والخيار (C) حركة متابعة تُحوِّل كل مرة ينخفض فيها، والخيار (D) يقسّم المال بحسب الغرض فقط ولا يصبح شكلًا من تقسيم الأهداف الاستثمارية إلى عدة أجزاء لدعم بعضها.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1213":{"id":1213,"subject_id":7,"type":"mcq","question_text":"أي مما يلي هو مزيج مناسب للأمثلة الملموسة التالية ①-③ في التنويع والمحاور الثلاثة (فئة الأصول، المنطقة، الزمن)؟\n① شراء نفس الهدف الاستثماري بمبالغ صغيرة على فترات منتظمة، ليس دفعة واحدة بل بتقسيم فترة الشراء إلى كل شهر\n② حمل أموال مُقسّمة إلى أهداف استثمارية ذات طبائع مختلفة، كالأسهم والسندات والذهب\n③ حمل شركات للاستثمار فيها مُقسّمة إلى شركات محلية وخارجية","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (D). يمكن ترتيب محاور التنويع إلى ثلاثة. تقسيم نفس الهدف الاستثماري بفترة الشراء كما في ① هو التنويع عبر الزمن، والتقسيم إلى أهداف استثمارية ذات طبائع مختلفة كما في ② هو التنويع عبر فئات الأصول، والتقسيم إلى محلية وخارجية كما في ③ هو التنويع عبر المناطق.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1214":{"id":1214,"subject_id":7,"type":"mcq","question_text":"بنيت محفظة إجماليها ٣٠٬٠٠٠ جنيه. حددت دليلًا لـ\u0026#34;حتى نصف (٥٠%) الكل\u0026#34; للتسليم للأسهم ذات التحرك السعري الكبير. أي مما يلي تفسير مناسب للعلاقة بين نسبة الأسهم الحالية والدليل المُحدَّد؟","image":"image_5_20_7_ar.png","video":null,"explanation":"الإجابة الصحيحة هي (C). تُوجَد النسبة بقسمة مبلغ الأسهم على الإجمالي. ١٣٬٥٠٠ / ٣٠٬٠٠٠ = ٤٥%. مقابل دليل حتى النصف (٥٠%) المُسلَّم للأسهم، ٤٥% ضمنه، لكن يمكنك أن ترى أنها خطة تحتل فيها الأسهم قريبًا من النصف. تحقق من هذه النسبة مقابل القدرة المُحدَّدة على تحمل المخاطر للتأكد من توازن المزيج. الخيار (A) خطأ في قراءتها كأقل بكثير، والخيار (B) كنصف بالضبط، والخيار (D) كتجاوز للنصف -كل هذا يخطئ في قراءة النسبة المحسوبة.","explanation_image":"image_5_20_8_ar.png","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1215":{"id":1215,"subject_id":7,"type":"mcq","question_text":"بمطابقة كل يوم راتب شهري، تبدأ \u0026#34;الاستثمار بالتقسيط\u0026#34;، مضيفًا مبلغًا ثابتًا. أي مما يلي تفسير مناسب لآلية هذا الاستثمار بالتقسيط؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (A). الاستثمار بالتقسيط طريقة للاستمرار في الشراء بمبلغ ثابت في توقيت ثابت. بما أن المبلغ ثابت، تشتري قليلًا عندما يكون السعر مرتفعًا وكثيرًا عندما يكون رخيصًا، وتتنوّع فترة الشراء بطبيعة الحال. الخيار (B) طريقة مختلفة للتمييز بين الأدنى، والخيار (C) تفسير معكوس لرفع متوسط سعر الشراء، والخيار (D) يعتمد على التنبؤ ويختلف عن آلية التقسيط.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:27Z","updated_at":null},"1216":{"id":1216,"subject_id":7,"type":"mcq","question_text":"شريت نفس السهم بـ٣٬٠٠٠ جنيه في كل مرة، مُقسّمًا على مرتين. المرة الأولى كانت بسعر ١٠٠ جنيه للسهم، والثانية بسعر ٣٠٠ جنيه للسهم. أي مما يلي يحسب بشكل صحيح متوسط سعر الشراء الإجمالي لكل سهم وتأثير التقسيط بمبلغ ثابت؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (B). يُحسب متوسط سعر الشراء لكل سهم بقسمة إجمالي المال المُستخدَم على إجمالي عدد الأسهم المُشتراة. بما أنه ٣٬٠٠٠ جنيه في كل مرة، الأولى هي ٣٬٠٠٠ / ١٠٠ = ٣٠ سهمًا، والثانية ٣٬٠٠٠ / ٣٠٠ = ١٠ أسهم. الإجمالي ٤٠ سهمًا، والمال المُستخدَم ٦٬٠٠٠ جنيه. المتوسط هو ٦٬٠٠٠ / ٤٠ = ١٥٠ جنيهًا. الشراء بمبلغ ثابت يتيح لك شراء الكثير عندما يكون رخيصًا (١٠٠ جنيه) والقليل عندما يكون مرتفعًا (٣٠٠ جنيه)، فيُحافَظ على متوسط سعر الشراء أقل من الوسط البسيط للسعرين (٢٠٠ جنيه). هذا هو تأثير التقسيط (المبلغ الثابت).","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1217":{"id":1217,"subject_id":7,"type":"mcq","question_text":"تعلمت المحاور الثلاثة للتنويع (فئة الأصل، المنطقة، الزمن) وقدرتك على تحمل المخاطر (قد تستخدم جزءًا في غضون سنوات قليلة، وتريد تجنب انخفاضات السعر الكبيرة). مع ذلك، كنتيجة للشراء حتى الآن، الآن معظم أصولك مُنحازة لسهم شركة معينة واحدة. أي مما يلي طريقة مناسبة لبناء مزيج (محفظة) يناسبك من هنا؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (C). يُبنى مزيج يناسبك بالتقسيم على المحاور الثلاثة للتنويع -فئة الأصل، والمنطقة، والزمن- بحيث يتناسب مع القدرة على تحمل المخاطر لمدى التقلب الذي يمكنك تقبّله. الآن هو مُنحاز لشركة واحدة، فالنقطة هي ترتيبه بينما تُخفّف ذلك الانحياز. الخيار (A) يجمع في هدف آمن واحد بسبب تجنب تحرك السعر، دون النظر إلى العائد أو الهدف، والخيار (B) يعتمد على التنبؤ بنجاح شركة واحدة تنمو ويعمّق الانحياز على العكس، والخيار (D) يقسّم بالتساوي فقط دون استخدام المحاور أو القدرة ولا يصبح مزيجًا يناسبك.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1218":{"id":1218,"subject_id":7,"type":"mcq","question_text":"من بين المعلومات التالية ①-④ لتقييم شركة هدف استثماري، أي مما يلي يحدد بشكل صحيح كل معلومة كـ\u0026#34;كمية\u0026#34; أو \u0026#34;نوعية\u0026#34;؟\n① عدد المحلات الجديدة المفتوحة هذا العام، المُعلَن من الشركة\n② طريقة تفكير المدير في مستقبل الشركة، كما ذُكِرت\n③ سهولة استخدام المنتجات وحالة الموظفين، المُلاحَظة بزيارة محل\n④ قيمة ROE (العائد على حقوق الملكية) المُدرَجة في المواد","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (D). القابل للقياس بالأرقام -عدد المحلات الجديدة المفتوحة (①) وقيمة ROE (④)- معلومات كمية، والذي لا يظهر في الأرقام -طريقة تفكير المدير (②) والانطباع المُستلَم من المنتجات والموظفين (③)- معلومات نوعية. يستخدم تقييم الشركة هذين كعجلتين معًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1219":{"id":1219,"subject_id":7,"type":"mcq","question_text":"بالبحث عن شركة لاحظتها على محطة الهولوغرام، هناك شركة سعر سهمها ١٦٠ جنيهًا للسهم وربحية سهمها ٨ جنيهات. أي مما يلي يحسب بشكل صحيح PER (نسبة السعر إلى الربحية) للشركة ويفسّر معناها؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (B). يُحسب PER بقسمة سعر السهم على ربحية السهم. ١٦٠ / ٨ = ٢٠ مرة. يُقرَأ أن سعر السهم عند مستوى يعادل ٢٠ سنة من ربحية السهم.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1220":{"id":1220,"subject_id":7,"type":"mcq","question_text":"وسط متوسط PER للصناعة البالغ ١٨ مرة، وجدت شركة بـ PER يبلغ ٩ مرات. أي مما يلي معنى مناسب لكون PER أقل من متوسط الصناعة بهذا الشكل؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (A). PER رقم يمثّل كم سنة من ربحية السهم يمثّل سعر السهم. كونه أقل من متوسط الصناعة قد يشير إلى أن سعر السهم منخفض نسبيًا مقارنةً بربحيته، أي أنه قد يكون منخفض التقييم. مع ذلك، PER مجرد دليل، فتحقق أيضًا من سبب الرخص وجوهر الشركة. الخيار (B) عن حجم الربح، والخيار (D) عن مقدار توزيعات الأرباح، ولا هو تنبؤ بتحرك السعر المستقبلي كما في (C).","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1221":{"id":1221,"subject_id":7,"type":"mcq","question_text":"تُقارن شركتين مرشحتين لمحفظتك في هذا الجدول. أي مما يلي يحدد بشكل صحيح الشركة ذات سعر السهم الأرخص نسبيًا نسبة إلى صافي الأصول، والشركة التي تكسب بكفاءة باستخدام رأس مالها؟","image":"image_5_20_9_ar.png","video":null,"explanation":"الإجابة الصحيحة هي (C). يُحسب PBR (نسبة السعر إلى القيمة الدفترية) بـ\u0026#34;سعر السهم / صافي أصول السهم\u0026#34;، مؤشر يرى ما إذا كان سعر السهم غاليًا أو رخيصًا نسبة إلى صافي أصول الشركة. كلما انخفضت القيمة، كلما كان أرخص، والشركة أ (PBR ٠٫٨ مرة) هي الأرخص. يُحسب ROE (العائد على حقوق الملكية) بـ\u0026#34;صافي الربح / حقوق الملكية\u0026#34;، مؤشر يرى مدى كفاءة توليد الربح باستخدام رأس مال المساهمين. كلما ارتفعت القيمة، كلما كان أكثر كفاءة، والشركة ب (ROE ٣٢%) تكسب بكفاءة أكبر. يرى PBR \u0026#34;رخص سعر السهم\u0026#34; ويرى ROE \u0026#34;كفاءة الكسب\u0026#34; -مؤشران منفصلان يريان أشياء مختلفة، والرخص وكفاءة الكسب ليسا موجودين بالضرورة في نفس الشركة. في هذا الجدول، الأرخص هي الشركة أ، وذات كفاءة الكسب المرتفعة هي الشركة ب -شركتان منفصلتان.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1222":{"id":1222,"subject_id":7,"type":"mcq","question_text":"بالنظر إلى قائمة الأسهم على محطة الهولوغرام، لاحظت شركة PER منخفض بشكل خاص عن متوسط الصناعة. لكن هناك أيضًا معلومة أن إيرادات منتج هذه الشركة الرئيسي تراجعت حديثًا. أي مما يلي طريقة مناسبة للتفكير بحيث لا يتذبذب حكمك حول شراء سهم هذه الشركة؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (B). انخفاض PER يصبح دليلًا على أن سعر السهم مُقيَّم منخفضًا نسبة إلى الربح (رخيص)، لكن هناك أيضًا حالات يكون فيها رخيصًا لأن آفاق الأداء يُنظَر إليها بقلق. تراجعت إيرادات المنتج الرئيسي لهذه الشركة، ولا يمكنك الحكم بأنها رخيصة نسبة إلى القوة الحقيقية بانخفاض PER وحده. تحقق من سبب انخفاض PER، وحالة الإيرادات، وجوهر الشركة (الكمي والنوعي) لتمييز ما إذا كانت مُتروكة رخيصة نسبة إلى القوة الحقيقية. هذا يرتبط بطريقة تفكير الاستثمار القيمي، البحث عن شركات أرخص من قوتها الحقيقية. الخيار (A) يشتري أولًا دون فحص السبب، والخيار (C) يقرر بالإيرادات وحدها دون النظر إلى مؤشرات أخرى، والخيار (D) يعتمد على PER وحدها -كل هذا لا يفحص بمواد متعددة مُرتَّبة معًا.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1223":{"id":1223,"subject_id":7,"type":"mcq","question_text":"وجدت واستثمرت في شركة سعر سهمها منخفض مقارنةً بقوتها الحقيقية، رغم أن أرباحها مستقرة. أي مما يلي يطابق بشكل صحيح اسم هذا الأسلوب الاستثماري مع وصفه؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (D). طريقة التفكير في البحث عن والاستثمار في شركة سعر سهمها منخفض مقارنةً بقوتها الحقيقية هي الاستثمار القيمي. الخيار (A)، الاستثمار في النمو، هو طريقة التفكير التي تركّز على إمكانية نمو الشركة (نمو الإيرادات والربح) بدلًا من ارتفاع أو انخفاض سعر السهم الحالي، والخيار (B)، الاستثمار في المؤشر، هو طريقة الاستثمار على نطاق واسع مُقسّمًا للربط بالسوق بأكمله، والخيار (C)، التنويع، هو ابتكار التقسيم إلى أهداف استثمارية متعددة لتخفيف المخاطرة -لا شيء منها طريقة التفكير في البحث عن شركة مُتروكة رخيصة نسبة إلى قوتها الحقيقية.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1224":{"id":1224,"subject_id":7,"type":"mcq","question_text":"بعد اكتساب طريقة تفكير التنويع والقوة على تمييز الشركات، بإضافة \u0026#34;الصندوق الاستثماري\u0026#34; أخيرًا إلى الخيارات أيضًا، أكملت محفظة يمكن تسميتها الأفضل لك. أي مما يلي تفسير مناسب لهذا الصندوق الاستثماري؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (A). الصندوق الاستثماري منتج يستثمر فيه متخصص مالًا مُجمَّعًا من أشخاص كثيرين، مُنوَّعًا في أهداف متعددة كالأسهم والسندات. التنويع الواسع الذي يصعب فعله بمفردك يسهل تحقيقه بمنتج واحد. الخيار (B) خاصية الصندوق المتداول في البورصة (ETF) القابل للتداول كالسهم في السوق، والخيار (C) هو السهم الذي يمثّل حصة شركة، والخيار (D) هو السندات التي يعود رأس مالها عند الاستحقاق -كل هذا منتجات منفصلة عن الصندوق الاستثماري في (A).","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1225":{"id":1225,"subject_id":7,"type":"mcq","question_text":"بعد اكتساب طريقة الاختيار بالبحث الشامل وطريقة الربط بالسوق بأكمله معًا، مرّت عدة سنوات منذ بنيت محفظة يمكن تسميتها الأفضل لك. أي مما يلي طريقة مناسبة لدمج الطرق لصنع شكل سهل الاستمرار في بناء أصول مستقر طويل المدى من هنا أيضًا؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (B). الاستمرار في الاستثمار تدريجيًا في صندوق يتتبع حركة السوق يجعل التنويع الواسع والتنويع عبر الزمن الأساس. علاوة على ذلك، دمج جزء من أسهم شركات مُميَّزة كرخيصة بالبحث الشامل يستفيد من تعلّم تقييم الشركات أيضًا. بناء بأدوار مُقسّمة يرتبط بشكل سهل الاستمرار طويلًا. الخيار (A) يفتقد أساس التنويع، والخيار (C) يصبح متابعة للأداء، والخيار (D) يصبح تجميعًا بلا أدوار.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1226":{"id":1226,"subject_id":7,"type":"mcq","question_text":"نمت الـ٣٠٬٠٠٠ جنيه المُخصَّصة للإدارة إلى ٤٢٬٠٠٠ جنيه على مدى سنوات قليلة. أي مما يلي يحسب بشكل صحيح \u0026#34;معدل النمو\u0026#34; من المبلغ الأولي ويفسّر معناه؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (C). تُوجَد النسبة المُزادة بقسمة المبلغ المُزاد على المبلغ الأولي. المبلغ المُزاد هو ٤٢٬٠٠٠ − ٣٠٬٠٠٠ = ١٢٬٠٠٠ جنيه. ١٢٬٠٠٠ / ٣٠٬٠٠٠ = ٤٠%. على مدى سنوات قليلة، زاد المال الأولي بـ١٢٬٠٠٠ جنيه ليصبح ٤٢٬٠٠٠ جنيه. قوة الاستمرار طويلًا تظهر في هذه النسبة.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1227":{"id":1227,"subject_id":7,"type":"mcq","question_text":"الأسهم والسندات والذهب التي حملتها مُقسّمة نمت كما في هذا الجدول على مدى سنوات قليلة. أي مما يلي استنتاج دقيق يمكنك استخلاصه من الفرق في كيفية نمو الأصول الثلاثة؟","image":"image_5_20_10_ar.png","video":null,"explanation":"الإجابة الصحيحة هي (D). النسبة المُتنامية هي: الأسهم ٢١٬٠٠٠ / ١٣٬٥٠٠ = حوالي ١٫٥٦ مرة (+حوالي ٥٦%)، السندات ١٢٬٠٠٠ / ٩٬٠٠٠ = حوالي ١٫٣٣ مرة (+حوالي ٣٣%)، الذهب ٩٬٠٠٠ / ٧٬٥٠٠ = ١٫٢ مرة (+٢٠%). نمت الأسهم ذات التحرك السعري الكبير أكثر، ونما الذهب ذو التحرك السعري الصغير بشكل متواضع. كلما زاد تحرك السعر (وزادت المخاطرة)، زاد العائد المتوقع عادةً، لكن كلما كبر مدى التقلب عند الانخفاض أيضًا. تظهر هذه العلاقة بين المخاطرة والعائد في الفرق في كيفية نمو الثلاثة. الخيار (A) يتجاهل أن طرق نمو الثلاثة تختلف، والخيار (B) يقرأ حجم النمو بشكل معكوس، والخيار (C) هو تبرير بعد فوات الوقت للتركيز في شركة واحدة بالنتيجة وحدها دون النظر إلى حجم التحرك السعري (المخاطرة). التنويع هو ابتكار دمج تحركات مختلفة كهذه لتثبيت الكل.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null},"1228":{"id":1228,"subject_id":7,"type":"mcq","question_text":"انتهت تجربة المحاكي، واكتسبت القوة على تنمية ٣٠٬٠٠٠ جنيه من الأموال إلى ٤٢٬٠٠٠ جنيه. وفي العالم الحقيقي مستقبلًا أيضًا، في كل مرة يتغيّر هدفك أو وضعك، ستُعيد التأكد من ( ١ )، وبمبدأ ( ٢ ) الذي تعلمته، ستُنمّي الأموال بينما تُرتّب المزيج.\nأي مما يلي زوج كلمات يملأ الفراغين ( ١ ) و( ٢ ) بأفضل شكل؟","image":null,"video":null,"explanation":"الإجابة الصحيحة هي (A). عندما يتغيّر هدفك أو وضعك، أعد التأكد أولًا من مدى التقلب الذي يمكنك تقبّله (( ١ ) القدرة على تحمل المخاطر)، وبمبدأ ( ٢ ) الاستمرار طويل المدى، والتنويع، والتقسيط، ورؤية الأرقام كالأداء ومحتوى الأعمال معًا، نمِّ الأموال مع إعادة ترتيب المزيج بما يتناسب مع أهدافك. ( ١ ) ليس مجال الأموال وحده (B)، أو آفاق السوق المستقبلية (C)، أو الأداء حتى الآن (D)، بل القدرة على تحمل المخاطر، برؤية وقت الاستخدام، ومجال الأموال، وطريقة مواجهة تحرك السعر معًا. ( ٢ ) أيضًا ليس فقط تقليل المخاطرة (B)، أو التبديل إلى الطريقة ذات الأداء الجيد (C)، أو تجنّب الأشياء ذات التحرك السعري الكبير بشكل موحّد (D) -المبدأ هو ترتيبه بما يتناسب مع هدف النمو والقدرة على تحمل المخاطر.","hint1":null,"hint2":null,"code_language":null,"code_description":null,"code_starter":null,"code_stdin":null,"code_timeout":null,"created_at":"2026-09-08T01:25:28Z","updated_at":null}},"options":{"1179":[{"id":4713,"question_id":1179,"subject_id":7,"sort_order":1,"text":"الادخار: نقل مال لا خطة لاستخدامه إلى مكان آمن بحيث لا يقل، والاستمرار في ادخاره كما هو","image":null,"video":null},{"id":4714,"question_id":1179,"subject_id":7,"sort_order":2,"text":"المضاربة: تمييز صعود وهبوط السعر خلال فترة قصيرة جدًا، والسعي بسرعة إلى الربح من الفرق","image":null,"video":null},{"id":4715,"question_id":1179,"subject_id":7,"sort_order":3,"text":"الاستثمار: توقع عائد مستقبلي، وضع المال في نمو شركة أو مشروع، وتنميته بمرور الوقت","image":null,"video":null,"is_correct":true},{"id":4716,"question_id":1179,"subject_id":7,"sort_order":4,"text":"الاستثمار: اختيار أهداف قليلة القلق من انخفاض السعر فقط، والبحث عن مكان لإيداع المال ينمو بثبات","image":null,"video":null}],"1180":[{"id":4717,"question_id":1180,"subject_id":7,"sort_order":1,"text":"وضع مبلغ ثابت كل شهر لشركة تتوقع نموها حتى بعد ١٠ سنوات، الاستمرار في حمل السهم، وتنميته بمكاسب ارتفاع السعر وتوزيعات الأرباح","image":null,"video":null,"is_correct":true},{"id":4718,"question_id":1180,"subject_id":7,"sort_order":2,"text":"إيجاد أسهم يُحتمل ارتفاعها، وبيعها في غضون أيام قليلة، والتحول إلى أسهم أخرى، وكسب الفرق بشكل متكرر","image":null,"video":null},{"id":4719,"question_id":1180,"subject_id":7,"sort_order":3,"text":"شراء منتجات كثيرة من شركة تريد دعمها كل شهر، المساهمة في الإيرادات، وانتظار ارتفاع سعر سهم تلك الشركة","image":null,"video":null},{"id":4720,"question_id":1180,"subject_id":7,"sort_order":4,"text":"البحث وتسجيل تحركات أسعار شركة يوميًا، والانتظار الآن نقدًا حتى تستطيع شراء السهم في يوم ينخفض فيه يومًا ما","image":null,"video":null}],"1181":[{"id":4721,"question_id":1181,"subject_id":7,"sort_order":1,"text":"لأن عندما ترتفع الأسعار، يطرح البنك جزءًا صغيرًا في كل مرة كأجر من المال الذي يحمله","image":null,"video":null},{"id":4722,"question_id":1181,"subject_id":7,"sort_order":2,"text":"لأن ضريبة جديدة تُطبَّق على المال المتوفر بمقدار ارتفاعها، مما يزيد الجزء المُدفَع","image":null,"video":null},{"id":4723,"question_id":1181,"subject_id":7,"sort_order":3,"text":"لأن عندما ترتفع الأسعار، يتراجع الاقتصاد دائمًا لاحقًا، ويقل المال الوارد","image":null,"video":null},{"id":4724,"question_id":1181,"subject_id":7,"sort_order":4,"text":"لأن حتى إذا بقي المبلغ نفسه، تنخفض كمية السلع والخدمات التي يمكنك شراءها بذلك المبلغ","image":null,"video":null,"is_correct":true}],"1182":[{"id":4725,"question_id":1182,"subject_id":7,"sort_order":1,"text":"يمكنك شراء ٥٠ كما كان من قبل، فحتى مع ارتفاع السعر، لم يحدث أي انكماش","image":null,"video":null},{"id":4726,"question_id":1182,"subject_id":7,"sort_order":2,"text":"العدد الذي يمكنك شراءه ينخفض بـ١٠، وحتى بنفس المبلغ، انكمشت الكمية التي يمكنك شراءها","image":null,"video":null,"is_correct":true},{"id":4727,"question_id":1182,"subject_id":7,"sort_order":3,"text":"العدد الذي يمكنك شراءه ينخفض بـ٤٠، مما يعني أن معظم وجبات الغداء القابلة للشراء بميزانية الطعام قد تلاشت","image":null,"video":null},{"id":4728,"question_id":1182,"subject_id":7,"sort_order":4,"text":"العدد الذي يمكنك شراءه ينخفض بـ٢٠، ولا يمكنك بعد الآن شراء بالضبط جزء ارتفاع السعر لكل وجبة","image":null,"video":null}],"1183":[{"id":4729,"question_id":1183,"subject_id":7,"sort_order":1,"text":"تأمين المبلغين ذوي وقت الاستخدام المحدد من خلال الادخار، وتحويل فقط الـ٣٠٬٠٠٠ جنيه غير المُستخدَمة في الوقت الحالي إلى استثمار","image":null,"video":null,"is_correct":true},{"id":4730,"question_id":1183,"subject_id":7,"sort_order":2,"text":"عدم الاهتمام بوقت الاستخدام، وتحويل الـ٧٥٬٠٠٠ جنيه كاملة إلى استثمار معًا دون تقسيم الثلاثة لتنميتها","image":null,"video":null},{"id":4731,"question_id":1183,"subject_id":7,"sort_order":3,"text":"تنمية الـ٢٥٬٠٠٠ جنيه المُستخدَمة في نصف عام من خلال الاستثمار، والاحتفاظ بالـ٣٠٬٠٠٠ جنيه غير المُستخدَمة كنقد","image":null,"video":null},{"id":4732,"question_id":1183,"subject_id":7,"sort_order":4,"text":"تأمين فقط الـ٣٠٬٠٠٠ جنيه غير المُستخدَمة من خلال الادخار، وتحويل المبلغين ذوي وقت الاستخدام المحدد إلى استثمار","image":null,"video":null}],"1184":[{"id":4733,"question_id":1184,"subject_id":7,"sort_order":1,"text":"يشير فقط إلى حجم الخسارة، في حالة انخفاض السعر وتحمّل خسارة","image":null,"video":null},{"id":4734,"question_id":1184,"subject_id":7,"sort_order":2,"text":"يشير فقط إلى الحالة التي يُفلس فيها الهدف الاستثماري ولا تعود الأموال","image":null,"video":null},{"id":4735,"question_id":1184,"subject_id":7,"sort_order":3,"text":"يشير إلى مدى تقلب السعر، متحركًا في الاتجاهين، الزيادة والانخفاض","image":null,"video":null,"is_correct":true},{"id":4736,"question_id":1184,"subject_id":7,"sort_order":4,"text":"يشير إلى الأحداث السيئة في العالم نفسها التي تسبب تحرك السعر","image":null,"video":null}],"1185":[{"id":4737,"que